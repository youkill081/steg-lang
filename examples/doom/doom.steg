// doom-loading.steg
// Keep the last rendered frame visible while preparing the next level.
bool loading_enabled=false; bool loading_active=false;
framebuffer loading_source=0; framebuffer loading_framebuffer=0;
clock loading_clock=0;
int loading_percent=0;

fn loading_attach(framebuffer fb) -> void {
    loading_source=fb;
    loading_framebuffer=window_framebuffer_create(320,240);
    loading_enabled=true;
}

fn loading_draw() -> void {
    if (!loading_active) { return; }
    if (window_should_close()) { audio_close(); window_close(); exit(0); }
    uint32 @pixels=window_framebuffer_get_address(loading_framebuffer);
    int y=238;
    while (y<240) {
        int x=0;
        while (x<320) {
            uint32 color=536870911;
            if (x<loading_percent*320/100) { color=3004965119; }
            pixels[(239-y)*320+x]=color;
            x+=1;
        }
        y+=1;
    }
    audio_update();
    window_clear(0,0,0);
    window_framebuffer_sync(loading_framebuffer);
    window_framebuffer_draw(loading_framebuffer,0,0);
    window_present();
    clock_reset(loading_clock);
}

fn loading_snapshot() -> void {
    if (!loading_active) { return; }
    uint32 @source=window_framebuffer_get_address(loading_source);
    uint32 @target=window_framebuffer_get_address(loading_framebuffer);
    int i=0;
    while (i<76800) { target[i]=source[i]; i+=1; }
    loading_draw();
}

fn loading_begin() -> bool {
    if (!loading_enabled || loading_active) { return false; }
    loading_active=true;
    loading_clock=clock_create();
    loading_percent=0;
    loading_snapshot();
    return true;
}

fn loading_tick() -> void {
    if (!loading_active) { return; }
    if (clock_get_elapsed_ms(loading_clock)>=100) { loading_draw(); }
}

fn loading_step(uint8 @label,int percent) -> void {
    if (!loading_active) { return; }
    if (percent>loading_percent) { loading_percent=percent; }
    loading_tick();
}

fn loading_end(bool owner) -> void {
    if (!owner) { return; }
    loading_percent=100;
    loading_draw();
    loading_active=false;
    clock_delete(loading_clock);
}

// doom-wad.steg
// Raw Doom IWAD reader. Offsets are byte offsets in the original WAD.

fn wad_directory(file wad) -> uint32 {
    if (!file_is_readable(wad)) { return 0; }
    uint32 size=file_size(wad);
    if (size<12 || size>2147483647) { return 0; }
    if (file_read_uint32_at(wad,0)!=1230455108) { return 0; } // IWAD
    uint32 count=file_read_little_uint32_at(wad,4);
    uint32 directory=file_read_little_uint32_at(wad,8);
    if (directory<12 || directory>size || count==0) { return 0; }
    if (count>(size-directory)/16) { return 0; }
    return directory;
}

fn lump_fits(file wad,uint32 entry) -> bool {
    uint32 size=file_size(wad);
    uint32 offset=file_read_little_uint32_at(wad,entry);
    uint32 count=file_read_little_uint32_at(wad,entry+4);
    if (offset>size) { return false; }
    return count<=size-offset;
}

// WAD lookups uppercase ASCII names and ignore bytes after the first NUL.
fn wad_name_word(uint32 value) -> uint32 {
    uint32 result=0;
    int shift=24;
    while (shift>=0) {
        uint32 letter=(value>>shift)&255;
        if (letter==0) { return result; }
        if (letter>=97 && letter<=122) { letter-=32; }
        result=result|(letter<<shift);
        shift-=8;
    }
    return result;
}

fn wad_find_lump(file wad,uint32 directory,uint32 name_hi,uint32 name_lo) -> uint32 {
    name_hi=wad_name_word(name_hi); name_lo=wad_name_word(name_lo);
    if ((name_hi&255)==0) { name_lo=0; }
    if (directory==0) { return 0; }
    uint32 count=file_read_little_uint32_at(wad,4);
    while (count>0) {
        count-=1;
        uint32 entry=directory+count*16;
        if (file_read_uint32_at(wad,entry+8)==name_hi && file_read_uint32_at(wad,entry+12)==name_lo) {
            if (!lump_fits(wad,entry)) { return 0; }
            return entry;
        }
    }
    return 0;
}

fn signed16(file data,uint32 at) -> int {
    int value=file_read_little_uint16_at(data,at);
    if (value>=32768) { value-=65536; }
    return value;
}

fn wad_palette(file wad,uint32 directory) -> file {
    file colors=file_create("");
    uint32 palette=wad_find_lump(wad,directory,1347174745,1346456576); // PLAYPAL
    uint32 colormap=wad_find_lump(wad,directory,1129270351,1380794704); // COLORMAP
    if (palette==0 || colormap==0) { return colors; }
    if (file_read_little_uint32_at(wad,palette+4)<10752
        || file_read_little_uint32_at(wad,colormap+4)<8448) { return colors; }
    uint32 pal=file_read_little_uint32_at(wad,palette);
    uint32 map=file_read_little_uint32_at(wad,colormap);
    int p=0;
    while (p<14) {
        int shade=0;
        while (shade<8448) {
            int color=pal+p*768+file_read_uint8_at(wad,map+shade)*3;
            uint32 r=file_read_uint8_at(wad,color);
            uint32 g=file_read_uint8_at(wad,color+1);
            uint32 b=file_read_uint8_at(wad,color+2);
            file_append_uint32((r<<24)|(g<<16)|(b<<8)|255,colors);
            shade+=1;
        }
        p+=1;
    }
    return colors;
}

fn match_map_lump(file wad,uint32 entry,int index) -> bool {
    uint32 hi=file_read_uint32_at(wad,entry+8);
    uint32 lo=file_read_uint32_at(wad,entry+12);
    if (index==0) { return hi==1414023502 && lo==1196621824; } // THINGS
    if (index==1) { return hi==1279872581 && lo==1145390675; } // LINEDEFS
    if (index==2) { return hi==1397310533 && lo==1145390675; } // SIDEDEFS
    if (index==3) { return hi==1447383636 && lo==1163412819; } // VERTEXES
    if (index==4) { return hi==1397049171 && lo==0; } // SEGS
    if (index==5) { return hi==1397966147 && lo==1414484563; } // SSECTORS
    if (index==6) { return hi==1313817669 && lo==1392508928; } // NODES
    if (index==7) { return hi==1397048148 && lo==1330795264; } // SECTORS
    if (index==8) { return hi==1380272709 && lo==1129578496; } // REJECT
    return hi==1112297283 && lo==1263354192; // BLOCKMAP
}

// The returned table contains ten pairs of little-endian offset and length.
fn wad_map(file wad,uint32 directory,int episode,int level) -> file {
    file map=file_create("");
    if (episode<1 || episode>4 || level<1 || level>9 || directory==0) { return map; }
    uint32 name=(69<<24)|((48+episode)<<16)|(77<<8)|(48+level);
    uint32 marker=wad_find_lump(wad,directory,name,0);
    if (marker==0) { return map; }
    uint32 count=file_read_little_uint32_at(wad,4);
    if ((marker-directory)/16+10>=count) { return map; }
    int i=0;
    while (i<10) {
        uint32 entry=marker+(i+1)*16;
        if (!match_map_lump(wad,entry,i) || !lump_fits(wad,entry)) {
            file_clear_data(map);
            return map;
        }
        file_append_little_uint32(file_read_little_uint32_at(wad,entry),map);
        file_append_little_uint32(file_read_little_uint32_at(wad,entry+4),map);
        i+=1;
    }
    return map;
}

fn map_record(file map,int lump,int index,int stride) -> int {
    if (index<0 || index>=file_read_little_uint32_at(map,lump*8+4)/stride) { return 0; }
    return file_read_little_uint32_at(map,lump*8)+index*stride;
}

fn face_sector(file wad,file map,int line,int side) -> int {
    int sidedef=file_read_little_uint16_at(wad,line+10+side*2);
    int at=map_record(map,2,sidedef,30);
    if (at==0) { return 0; }
    int sector=file_read_little_uint16_at(wad,at+28);
    if (map_record(map,7,sector,26)==0) { return 0; }
    return sector+1;
}

fn append_line_vertex(file wad,file map,file lines,int at) -> bool {
    int vertex=map_record(map,3,file_read_little_uint16_at(wad,at),4);
    if (vertex==0) { return false; }
    file_append_little_uint32(file_read_little_uint32_at(wad,vertex),lines);
    return true;
}

// Original line order is preserved so BLOCKMAP indices still address these records.
fn wad_classic_lines(file wad,file map) -> file {
    file lines=file_create("");
    if (file_size(map)!=80) { return lines; }
    int size=file_read_little_uint32_at(map,12);
    if (size%14!=0 || file_read_little_uint32_at(map,28)%4!=0) { return lines; }
    int at=file_read_little_uint32_at(map,8);
    int end=at+size;
    while (at<end) {
        if (!append_line_vertex(wad,map,lines,at) || !append_line_vertex(wad,map,lines,at+2)) {
            file_clear_data(lines);
            return lines;
        }
        file_append_little_uint16(file_read_little_uint16_at(wad,at+4),lines);
        file_append_little_uint16(face_sector(wad,map,at,0),lines);
        file_append_little_uint16(face_sector(wad,map,at,1),lines);
        at+=14;
    }
    return lines;
}

fn subsector_room(file wad,file map,int subsector) -> int {
    if (file_read_little_uint16_at(wad,subsector)==0) { return 0; }
    int segment=map_record(map,4,file_read_little_uint16_at(wad,subsector+2),12);
    if (segment==0) { return 0; }
    int line=map_record(map,1,file_read_little_uint16_at(wad,segment+6),14);
    int side=file_read_little_uint16_at(wad,segment+8);
    if (line==0 || side>1) { return 0; }
    return face_sector(wad,map,line,side);
}

fn valid_bsp_child(int child,int node,int leaves) -> bool {
    if ((child&32768)!=0) { return (child&32767)<leaves; }
    return child<node;
}

fn valid_bsp(file wad,file map,int leaves) -> bool {
    int length=file_read_little_uint32_at(map,52);
    if (length%28!=0 || leaves==0) { return false; }
    int at=file_read_little_uint32_at(map,48);
    int node=0;
    while (node<length/28) {
        if (!valid_bsp_child(file_read_little_uint16_at(wad,at+24),node,leaves)
            || !valid_bsp_child(file_read_little_uint16_at(wad,at+26),node,leaves)) { return false; }
        at+=28;
        node+=1;
    }
    return true;
}

fn wad_bsp_leaves(file wad,file map) -> file {
    file leaves=file_create("");
    if (file_size(map)!=80) { return leaves; }
    int size=file_read_little_uint32_at(map,44);
    if (size%4!=0 || file_read_little_uint32_at(map,36)%12!=0) { return leaves; }
    if (!valid_bsp(wad,map,size/4)) { return leaves; }
    int at=file_read_little_uint32_at(map,40);
    int end=at+size;
    while (at<end) {
        int room=subsector_room(wad,map,at);
        if (room==0) { file_clear_data(leaves); return leaves; }
        file_append_little_uint16(room-1,leaves);
        at+=4;
    }
    return leaves;
}

fn valid_block_list(file wad,int at,int end,int lines) -> bool {
    while (at<=end-2) {
        int index=file_read_little_uint16_at(wad,at);
        if (index==65535) { return true; }
        if (index>=lines) { return false; }
        at+=2;
    }
    return false;
}

fn wad_blockmap_valid(file wad,file map) -> bool {
    if (file_size(map)!=80) { return false; }
    int at=file_read_little_uint32_at(map,72);
    int size=file_read_little_uint32_at(map,76);
    if (size<8 || size%2!=0) { return false; }
    int width=file_read_little_uint16_at(wad,at+4);
    int height=file_read_little_uint16_at(wad,at+6);
    if (width==0 || height==0) { return false; }
    if (width>(size-8)/2/height) { return false; }
    int cells=width*height;
    int lines=file_read_little_uint32_at(map,12)/14;
    int i=0;
    while (i<cells) {
        int list=file_read_little_uint16_at(wad,at+8+i*2)*2;
        if (!valid_block_list(wad,at+list,at+size,lines)) { return false; }
        i+=1;
    }
    return true;
}

fn texture_definition(file wad,uint32 lump,uint32 hi,uint32 lo) -> uint32 {
    hi=wad_name_word(hi); lo=wad_name_word(lo);
    if ((hi&255)==0) { lo=0; }
    if (lump==0) { return 0; }
    uint32 base=file_read_little_uint32_at(wad,lump);
    uint32 length=file_read_little_uint32_at(wad,lump+4);
    if (length<4) { return 0; }
    uint32 count=file_read_little_uint32_at(wad,base);
    if (count>(length-4)/4) { return 0; }
    while (count>0) {
        count-=1;
        uint32 offset=file_read_little_uint32_at(wad,base+4+count*4);
        if (offset<=length && length-offset>=22) {
            uint32 at=base+offset;
            uint32 first=wad_name_word(file_read_uint32_at(wad,at));
            uint32 last=0;
            if ((first&255)!=0) { last=wad_name_word(file_read_uint32_at(wad,at+4)); }
            if (first==hi && last==lo) {
                uint32 patches=file_read_little_uint16_at(wad,at+20);
                if (patches>(length-offset-22)/10) { return 0; }
                return at;
            }
        }
    }
    return 0;
}

fn write_patch_post(file wad,file image,file job,int x,int y,int at) -> void {
    int height=file_read_little_uint32_at(job,12);
    int count=file_read_uint8_at(wad,at+1);
    int i=0;
    while (i<count) {
        int row=y+i;
        if (row>=0 && row<height) {
            file_seek_cursor(4+(x*height+row)*2,image);
            file_write_little_uint16(file_read_uint8_at(wad,at+3+i)+1,image);
        }
        i+=1;
    }
}

fn draw_patch_column(file wad,file image,file job,int col) -> bool {
    uint32 base=file_read_little_uint32_at(job,0);
    uint32 length=file_read_little_uint32_at(job,4);
    uint32 offset=file_read_little_uint32_at(wad,base+8+col*4);
    if (offset>=length) { return false; }
    int x=file_read_little_uint32_at(job,16)+col;
    int width=file_read_little_uint32_at(job,8);
    if (x<0 || x>=width) { return true; }
    if (file_read_little_uint32_at(job,24)!=0) { x=width-1-x; }
    int y=file_read_little_uint32_at(job,20);
    int last=-1;
    while (offset<length) {
        int at=base+offset;
        int row=file_read_uint8_at(wad,at);
        if (row==255) { return true; }
        if (length-offset<4) { return false; }
        uint32 count=file_read_uint8_at(wad,at+1);
        if (count>length-offset-4) { return false; }
        if (row<=last) { row+=last; }
        last=row;
        write_patch_post(wad,image,job,x,y+row,at);
        offset+=count+4;
    }
    return false;
}

fn draw_patch(file wad,file image,file job) -> bool {
    uint32 base=file_read_little_uint32_at(job,0);
    uint32 length=file_read_little_uint32_at(job,4);
    if (length<8) { return false; }
    int width=file_read_little_uint16_at(wad,base);
    if (width>(length-8)/4) { return false; }
    int x=0;
    while (x<width) {
        if (!draw_patch_column(wad,image,job,x)) { return false; }
        x+=1;
    }
    return true;
}

fn texture_patch(file wad,file job,uint32 pnames,uint32 directory,uint32 at) -> bool {
    uint32 number=file_read_little_uint16_at(wad,at+4);
    uint32 length=file_read_little_uint32_at(wad,pnames+4);
    uint32 base=file_read_little_uint32_at(wad,pnames);
    if (length<4) { return false; }
    if (number>=(length-4)/8 || number>=file_read_little_uint32_at(wad,base)) { return false; }
    uint32 name=base+4+number*8;
    uint32 hi=file_read_uint32_at(wad,name);
    uint32 lo=file_read_uint32_at(wad,name+4);
    uint32 patch=wad_find_lump(wad,directory,hi,lo);
    if (patch==0) { return false; }
    file_seek_cursor(0,job);
    file_write_little_uint32(file_read_little_uint32_at(wad,patch),job);
    file_write_little_uint32(file_read_little_uint32_at(wad,patch+4),job);
    file_seek_cursor(16,job);
    file_write_little_uint32(signed16(wad,at),job);
    file_write_little_uint32(signed16(wad,at+2),job);
    return true;
}

fn compose_texture(file wad,file image,file job,uint32 definition,uint32 directory) -> bool {
    uint32 pnames=wad_find_lump(wad,directory,1347305805,1163067392); // PNAMES
    if (pnames==0) { return false; }
    int count=file_read_little_uint16_at(wad,definition+20);
    int i=0;
    while (i<count) {
        if (!texture_patch(wad,job,pnames,directory,definition+22+i*10)) { return false; }
        if (!draw_patch(wad,image,job)) { return false; }
        i+=1;
    }
    return true;
}

fn indexed_image(file image,int width,int height) -> void {
    file_append_little_uint16(width,image);
    file_append_little_uint16(height,image);
    int pixels=width*height;
    while (pixels>0) { file_append_little_uint16(0,image); pixels-=1; }
}

fn patch_job(uint32 base,uint32 length,int width,int height,bool flip) -> file {
    file job=file_create("");
    file_append_little_uint32(base,job); file_append_little_uint32(length,job);
    file_append_little_uint32(width,job); file_append_little_uint32(height,job);
    file_append_little_uint32(0,job); file_append_little_uint32(0,job);
    if (flip) { file_append_little_uint32(1,job); }
    else { file_append_little_uint32(0,job); }
    return job;
}

// Two uint16 dimensions followed by column-major palette indices.
// Index zero is transparent. Palette indices 0..255 are represented by 1..256.
fn wad_texture(file wad,uint32 directory,uint32 hi,uint32 lo) -> file {
    file image=file_create("");
    uint32 definition=texture_definition(wad,wad_find_lump(wad,directory,1413830740,1431455026),hi,lo);
    if (definition==0) {
        definition=texture_definition(wad,wad_find_lump(wad,directory,1413830740,1431455025),hi,lo);
    }
    if (definition==0) { return image; }
    int width=file_read_little_uint16_at(wad,definition+12);
    int height=file_read_little_uint16_at(wad,definition+14);
    if (width==0 || height==0 || width>2048 || height>2048) { return image; }
    indexed_image(image,width,height);
    file job=patch_job(0,0,width,height,false);
    if (!compose_texture(wad,image,job,definition,directory)) { file_clear_data(image); }
    file_close(job);
    file_reset_cursor(image);
    return image;
}

// Sprites and UI graphics use the same post format. The signed sprite offsets
// are appended after the pixels so their positions do not shift the image data.
fn wad_patch(file wad,uint32 directory,uint32 hi,uint32 lo,bool flip) -> file {
    file image=file_create("");
    uint32 entry=wad_find_lump(wad,directory,hi,lo);
    if (entry==0) { return image; }
    uint32 base=file_read_little_uint32_at(wad,entry);
    uint32 length=file_read_little_uint32_at(wad,entry+4);
    if (length<8) { return image; }
    int width=file_read_little_uint16_at(wad,base);
    int height=file_read_little_uint16_at(wad,base+2);
    if (width==0 || height==0 || width>2048 || height>2048 || width>(length-8)/4) { return image; }
    indexed_image(image,width,height);
    file job=patch_job(base,length,width,height,flip);
    if (draw_patch(wad,image,job)) {
        file_append_little_uint32(file_read_little_uint32_at(wad,base+4),image);
    } else { file_clear_data(image); }
    file_close(job);
    file_reset_cursor(image);
    return image;
}

fn wad_flat(file wad,uint32 directory,uint32 hi,uint32 lo) -> file {
    file image=file_create("");
    uint32 entry=wad_find_lump(wad,directory,hi,lo);
    if (entry==0) { return image; }
    if (file_read_little_uint32_at(wad,entry+4)!=4096) { return image; }
    uint32 base=file_read_little_uint32_at(wad,entry);
    file_append_little_uint16(64,image); file_append_little_uint16(64,image);
    int x=0;
    while (x<64) {
        int y=0;
        while (y<64) {
            file_append_little_uint16(file_read_uint8_at(wad,base+y*64+x)+1,image);
            y+=1;
        }
        x+=1;
    }
    return image;
}

fn mus_event(file wad,file events,int end,int descriptor,int tick) -> bool {
    int type=(descriptor>>4)&7;
    int channel=descriptor&15;
    int a=0; int b=0;
    if (type!=6) {
        if (type==5 || type==7 || file_get_cursor(wad)>=end) { return false; }
        a=file_read_uint8(wad);
        if (type==1) {
            b=255; // Keep the channel's previous velocity.
            if ((a&128)!=0) {
                if (file_get_cursor(wad)>=end) { return false; }
                b=file_read_uint8(wad)&127;
            }
            a=a&127;
        }
        if (type==0) { a=a&127; }
        if (type==3 && a>14) { return false; }
        if (type==4) {
            if (a>14 || file_get_cursor(wad)>=end) { return false; }
            b=file_read_uint8(wad)&127;
        }
    }
    file_append_little_uint32(tick,events);
    file_append_uint8(type,events);
    file_append_uint8(channel,events);
    file_append_uint8(a,events);
    file_append_uint8(b,events);
    return true;
}

fn mus_delay(file wad,int end) -> int {
    int delay=0;
    int bytes=0;
    while (bytes<4 && file_get_cursor(wad)<end) {
        int part=file_read_uint8(wad);
        delay=delay*128+(part&127);
        if ((part&128)==0) { return delay; }
        bytes+=1;
    }
    return -1;
}

fn parse_mus_score(file wad,file events,int end) -> bool {
    int tick=0;
    while (file_get_cursor(wad)<end) {
        int descriptor=file_read_uint8(wad);
        if (!mus_event(wad,events,end,descriptor,tick)) { return false; }
        if (((descriptor>>4)&7)==6) { return true; }
        if ((descriptor&128)!=0) {
            int delay=mus_delay(wad,end);
            if (delay<0 || delay>2147483647-tick) { return false; }
            tick+=delay;
        }
    }
    return false;
}

// Each event is a 32-bit tick at 140 Hz, then type, channel, value A, value B.
fn wad_mus(file wad,uint32 directory,uint32 hi,uint32 lo) -> file {
    file events=file_create("");
    uint32 entry=wad_find_lump(wad,directory,hi,lo);
    if (entry==0) { return events; }
    uint32 start=file_read_little_uint32_at(wad,entry);
    uint32 length=file_read_little_uint32_at(wad,entry+4);
    if (length<16) { return events; }
    if (file_read_uint32_at(wad,start)!=1297437466) { return events; } // MUS\x1a
    uint32 score=file_read_little_uint16_at(wad,start+6);
    uint32 size=file_read_little_uint16_at(wad,start+4);
    uint32 instruments=file_read_little_uint16_at(wad,start+12);
    if (score<16+instruments*2 || score>length) { return events; }
    if (size>length-score) { return events; }
    uint32 cursor=file_get_cursor(wad);
    file_seek_cursor(start+score,wad);
    if (!parse_mus_score(wad,events,start+score+size)) { file_clear_data(events); }
    file_seek_cursor(cursor,wad);
    return events;
}

// doom-wad-atlas.steg

// The renderer indexes these buffers by texture ID. The first metadata record
// belongs to ID 1. ID zero represents an absent texture or sprite.
file atlas_pixels=0;
file atlas_meta=0;
file atlas_offsets=0;
file atlas_names=0;

fn append_wad_bytes(file source,file target,uint32 start,uint32 count) -> void {
    uint32 end=start+count;
    while (end-start>=4) {
        file_append_uint32(file_read_uint32_at(source,start),target);
        start+=4;
    }
    while (start<end) {
        file_append_uint8(file_read_uint8_at(source,start),target);
        start+=1;
    }
}

fn add_atlas_meta(int width,int height,uint32 pixel_offset) -> int {
    file_append_little_uint16(width,atlas_meta);
    file_append_little_uint16(height,atlas_meta);
    file_append_little_uint32(pixel_offset,atlas_meta);
    return file_size(atlas_meta)/8;
}

fn wad_atlas_create() -> void {
    atlas_pixels=file_create("");
    atlas_meta=file_create("");
    atlas_offsets=file_create("");
    atlas_names=file_create("");
    add_atlas_meta(1,1,0);
    file_append_little_uint16(97,atlas_pixels);
    file_append_little_uint32(0,atlas_offsets);
}

fn wad_atlas_destroy() -> void {
    file_close(atlas_pixels);
    file_close(atlas_meta);
    file_close(atlas_offsets);
    file_close(atlas_names);
}

fn wad_atlas_pixels() -> file { return atlas_pixels; }
fn wad_atlas_metadata() -> file { return atlas_meta; }
fn wad_atlas_sprite_offsets() -> file { return atlas_offsets; }

// Lookups record misses too, so a missing optional sprite is only decoded once.
fn atlas_lookup(uint32 first,uint32 last,int kind) -> int {
    int size=file_size(atlas_names);
    int at=0;
    while (at<size) {
        if (file_read_uint32_at(atlas_names,at)==first
            && file_read_uint32_at(atlas_names,at+4)==last
            && file_read_little_uint16_at(atlas_names,at+8)==kind) {
            return file_read_little_uint16_at(atlas_names,at+10);
        }
        at+=12;
    }
    return 65536;
}

fn wad_atlas_registered(uint32 first,uint32 last,int kind) -> bool {
    first=wad_name_word(first); last=wad_name_word(last);
    if ((first&255)==0) { last=0; }
    int id=atlas_lookup(first,last,kind);
    return id>0 && id<65536;
}

fn atlas_remember(uint32 first,uint32 last,int kind,int id) -> void {
    file_append_uint32(first,atlas_names);
    file_append_uint32(last,atlas_names);
    file_append_little_uint16(kind,atlas_names);
    file_append_little_uint16(id,atlas_names);
}

fn atlas_insert(file image,int sprite) -> int {
    int length=file_size(image);
    if (length<6 || file_size(atlas_meta)/8>=65535) { return 0; }
    int width=file_read_little_uint16_at(image,0);
    int height=file_read_little_uint16_at(image,2);
    int bytes=width*height*2;
    int end=4+bytes;
    if (sprite!=0) { end+=4; }
    if (length!=end) { return 0; }
    add_atlas_meta(width,height,file_size(atlas_pixels));
    append_wad_bytes(image,atlas_pixels,4,bytes);
    if (sprite!=0) {
        file_append_little_uint32(file_read_little_uint32_at(image,4+bytes),atlas_offsets);
    } else { file_append_little_uint32(0,atlas_offsets); }
    return file_size(atlas_meta)/8;
}

// Kinds 0, 1, 2 and 3 are wall textures, sprites, mirrored sprites and flats.
fn wad_atlas_asset(file wad,uint32 directory,uint32 first,uint32 last,int kind) -> int {
    first=wad_name_word(first); last=wad_name_word(last);
    if ((first&255)==0) { last=0; }
    if (first==0 || (first>>24)==45) { return 0; } // Empty name or "-"
    int id=atlas_lookup(first,last,kind);
    if (id!=65536) { return id; }
    if (kind==0) {
        file image=wad_texture(wad,directory,first,last);
        id=atlas_insert(image,0);
        file_close(image);
    } else {
        if (kind==3) {
            file image=wad_flat(wad,directory,first,last);
            id=atlas_insert(image,0);
            file_close(image);
        } else {
            file image=wad_patch(wad,directory,first,last,kind==2);
            id=atlas_insert(image,1);
            file_close(image);
        }
    }
    loading_tick();
    atlas_remember(first,last,kind,id);
    return id;
}

fn register_side_texture(file wad,file result,uint32 directory,int name) -> void {
    uint32 first=file_read_uint32_at(wad,name);
    uint32 last=file_read_uint32_at(wad,name+4);
    file_append_little_uint16(wad_atlas_asset(wad,directory,first,last,0),result);
}

// Three little-endian texture IDs per SIDEDEFS row, in upper/lower/middle order.
fn wad_side_materials(file wad,uint32 directory,file map) -> file {
    file materials=file_create("");
    if (file_size(map)!=80) { return materials; }
    int at=file_read_little_uint32_at(map,16);
    int size=file_read_little_uint32_at(map,20);
    if (size%30!=0) { return materials; }
    int end=at+size;
    while (at<end) {
        register_side_texture(wad,materials,directory,at+4);
        register_side_texture(wad,materials,directory,at+12);
        register_side_texture(wad,materials,directory,at+20);
        at+=30;
    }
    return materials;
}

fn collect_rotation(file wad,uint32 directory,file rows,int name) -> void {
    int id=file_read_little_uint16_at(atlas_names,name+10);
    if (id==0 || file_read_little_uint16_at(atlas_names,name+8)!=1) { return; }
    int angle=file_read_uint8_at(atlas_names,name+5);
    if (angle<49 || angle>56) { return; }
    uint32 prefix=file_read_uint32_at(atlas_names,name);
    int frame=file_read_uint8_at(atlas_names,name+4);
    int start=file_size(rows);
    file_append_little_uint16(id,rows);
    int i=0;
    while (i<8) { file_append_little_uint16(id,rows); i+=1; }
    int at=directory;
    int end=directory+file_read_little_uint32_at(wad,4)*16;
    while (at<end) {
        if (file_read_uint32_at(wad,at+8)==prefix) {
            uint32 suffix=file_read_uint32_at(wad,at+12);
            int rotation=file_read_uint8_at(wad,at+13)-49;
            if (file_read_uint8_at(wad,at+12)==frame && rotation>=0 && rotation<8) {
                file_seek_cursor(start+2+rotation*2,rows);
                file_write_little_uint16(wad_atlas_asset(wad,directory,prefix,suffix,1),rows);
            }
            rotation=file_read_uint8_at(wad,at+15)-49;
            if (file_read_uint8_at(wad,at+14)==frame && rotation>=0 && rotation<8) {
                file_seek_cursor(start+2+rotation*2,rows);
                file_write_little_uint16(wad_atlas_asset(wad,directory,prefix,suffix,2),rows);
            }
        }
        at+=16;
    }
}

fn wad_atlas_rotations(file wad,uint32 directory) -> file {
    file rows=file_create("");
    int name=0;
    int limit=file_size(atlas_names);
    while (name<limit) { collect_rotation(wad,directory,rows,name); name+=12; }
    file output=file_create("");
    int count=file_size(atlas_meta)/8*4;
    while (count>0) { file_append_little_uint32(0,output); count-=1; }
    int at=0; int size=file_size(rows);
    while (at<size) {
        int id=file_read_little_uint16_at(rows,at);
        file_seek_cursor((id-1)*16,output);
        int i=0;
        while (i<16) {
            file_write_little_uint32(file_read_little_uint32_at(rows,at+2+i),output);
            i+=4;
        }
        at+=18;
    }
    file_close(rows);
    return output;
}

// doom-wad-grid.steg
// Raw VERTEXES and normalized linedefs to the engine's sector lookup grid.

fn grid_s16(file source,int at) -> int {
    int value=file_read_little_uint16_at(source,at);
    if (value>=32768) { value-=65536; }
    return value;
}

fn wad_grid_bounds(file wad,file map) -> file {
    file bounds=file_create("");
    if (file_size(map)!=80) { return bounds; }
    int at=file_read_little_uint32_at(map,24);
    int size=file_read_little_uint32_at(map,28);
    if (size==0 || size%4!=0) { return bounds; }
    int end=at+size;
    int left=32767; int bottom=32767; int right=-32768; int top=-32768;
    while (at<end) {
        int x=grid_s16(wad,at); int y=grid_s16(wad,at+2);
        if (x<left) { left=x; }
        if (x>right) { right=x; }
        if (y<bottom) { bottom=y; }
        if (y>top) { top=y; }
        at+=4;
    }
    int width=(right-left+39)/8;
    int height=(top-bottom+39)/8;
    if (left< -32752 || bottom< -32752 || width*height>8388608) { return bounds; }
    file_append_little_uint32(left-16,bounds);
    file_append_little_uint32(bottom-16,bounds);
    file_append_little_uint32(width,bounds);
    file_append_little_uint32(height,bounds);
    return bounds;
}

fn grid_crossing(file lines,int at,float @positions,uint32 @ids,file bounds,int world_y) -> void {
    int y0=grid_s16(lines,at+2); int y1=grid_s16(lines,at+6);
    if (!((y0<=world_y && world_y<y1) || (y1<=world_y && world_y<y0))) { return; }
    int x0=grid_s16(lines,at); int x1=grid_s16(lines,at+4);
    float crossing=x0+(world_y-y0)*1.0*(x1-x0)/(y1-y0);
    int left=file_read_little_uint32_at(bounds,0);
    float relative=(crossing-left-4.0)/8.0;
    int column=relative;
    if (column<relative) { column+=1; }
    if (column<0) { column=0; }
    if (column>=file_read_little_uint32_at(bounds,8)) { return; }
    if (ids[column]!=65535 && positions[column]>crossing) { return; }
    positions[column]=crossing;
    if (y1>y0) { ids[column]=file_read_little_uint16_at(lines,at+10); }
    else { ids[column]=file_read_little_uint16_at(lines,at+12); }
}

fn draw_grid_row(file lines,file grid,file bounds,float @positions,uint32 @ids,int world_y) -> void {
    int width=file_read_little_uint32_at(bounds,8);
    int x=0;
    while (x<width) { ids[x]=65535; x+=1; }
    int at=0; int end=file_size(lines);
    while (at<end) { grid_crossing(lines,at,positions,ids,bounds,world_y); at+=14; }
    int sector=0; x=0;
    while (x<width) {
        if (ids[x]!=65535) { sector=ids[x]; }
        file_append_little_uint16(sector,grid);
        x+=1;
    }
}

fn grid_near_line(file lines,int at,int x,int y) -> bool {
    int x0=grid_s16(lines,at); int y0=grid_s16(lines,at+2);
    float dx=grid_s16(lines,at+4)-x0; float dy=grid_s16(lines,at+6)-y0;
    float length=dx*dx+dy*dy;
    if (length==0.0) { return false; }
    float vx=x-x0; float vy=y-y0;
    float t=fmax(0.0,fmin(1.0,(vx*dx+vy*dy)/length));
    vx-=t*dx; vy-=t*dy;
    return vx*vx+vy*vy<33.64;
}

fn mark_grid_line(file lines,file grid,file bounds,int at) -> void {
    int left=file_read_little_uint32_at(bounds,0);
    int bottom=file_read_little_uint32_at(bounds,4);
    int width=file_read_little_uint32_at(bounds,8);
    int height=file_read_little_uint32_at(bounds,12);
    int x0=grid_s16(lines,at); int y0=grid_s16(lines,at+2);
    int x1=grid_s16(lines,at+4); int y1=grid_s16(lines,at+6);
    int begin_x=fmax(0.0,(fmin(x0,x1)-5.0-left)/8.0);
    int begin_y=fmax(0.0,(fmin(y0,y1)-5.0-bottom)/8.0);
    int end_x=fmin(width-1,(fmax(x0,x1)+5.0-left)/8.0);
    int end_y=fmin(height-1,(fmax(y0,y1)+5.0-bottom)/8.0);
    int y=begin_y;
    while (y<=end_y) {
        int x=begin_x;
        while (x<=end_x) {
            if (grid_near_line(lines,at,left+x*8+4,bottom+y*8+4)) {
                file_seek_cursor((y*width+x)*2,grid);
                file_write_little_uint16(0,grid);
            }
            x+=1;
        }
        y+=1;
    }
}

fn wad_sector_grid(file lines,file bounds) -> file {
    file grid=file_create("");
    if (file_size(bounds)!=16 || file_size(lines)==0 || file_size(lines)%14!=0) { return grid; }
    int width=file_read_little_uint32_at(bounds,8);
    int height=file_read_little_uint32_at(bounds,12);
    int bottom=file_read_little_uint32_at(bounds,4);
    void @pos_memory=aloc(width*4);
    void @id_memory=aloc(width*4);
    float @positions=pos_memory;
    uint32 @ids=id_memory;
    int y=0;
    while (y<height) {
        draw_grid_row(lines,grid,bounds,positions,ids,bottom+y*8+4);
        y+=1;
    }
    free(id_memory); free(pos_memory);
    int at=0; int end=file_size(lines);
    while (at<end) {
        if (file_read_little_uint16_at(lines,at+12)!=0 && (file_read_little_uint16_at(lines,at+8)&1)!=0) {
            mark_grid_line(lines,grid,bounds,at);
        }
        at+=14;
    }
    file_reset_cursor(grid);
    return grid;
}


