fn load_doom_source(file input,uint32 streaming) -> audio_source {
    void @scratch=aloc(8);
    uint32 @job=scratch;
    job[0]=1; job[1]=streaming;
    audio_source source=audio_source_load(input,job);
    file_close(input);
    free(scratch);
    return source;
}

fn read_wad_directory_offset() -> void {
    wad_directory_offset=0; wad_lump_count=0;
    doom_wad=file_open("DOOM.wad");
    if (!file_is_readable(doom_wad)) { return; }
    uint32 size=file_size(doom_wad);
    if (size<12 || size>2147483647) { return; }
    if (file_read_uint32_at(doom_wad,0)!=1230455108) { return; } // IWAD
    uint32 directory=file_read_little_uint32_at(doom_wad,8);
    uint32 count=file_read_little_uint32_at(doom_wad,4);
    if (directory<12 || directory>size || count>(size-directory)/16) { return; }
    wad_directory_offset=directory;
    wad_lump_count=count;
}

fn load_wad_effect(uint32 first,uint32 last) -> audio_source {
    int entry=wad_find_lump(doom_wad,wad_directory_offset,first,last);
    if (entry==0) { return absent_sound; }
    uint32 length=file_read_little_uint32_at(doom_wad,entry+4);
    uint32 start=file_read_little_uint32_at(doom_wad,entry);
    if (length<8) { return absent_sound; }
    if (file_read_little_uint16_at(doom_wad,start)!=3) { return absent_sound; }
    uint32 rate=file_read_little_uint16_at(doom_wad,start+2);
    uint32 count=file_read_little_uint32_at(doom_wad,start+4);
    if (count>length-8) { count=length-8; }
    start+=8;
    if (count>32) { start+=16; count-=32; }
    if (rate<1000 || count==0 || count>1048576) { return absent_sound; }
    file pcm=file_create("");
    uint32 cursor=file_get_cursor(doom_wad);
    file_seek_cursor(start,doom_wad);
    int i=0;
    while (i<count) {
        file_append_uint8(file_read_uint8(doom_wad),pcm);
        i+=1;
    }
    file_seek_cursor(cursor,doom_wad);
    void @scratch=aloc(12);
    uint32 @format=scratch;
    format[0]=rate; format[1]=1; format[2]=8;
    audio_source source=audio_source_pcm(pcm,format);
    free(scratch);
    file_close(pcm);
    return source;
}

fn play_doom_effect(audio_source source) -> void {
    if (!doom_audio_ready || doom_audio_muted) { return; }
    void @scratch=aloc(16);
    uint32 @job=scratch;
    float @params=scratch;
    params[0]=0.8; params[1]=0.0; params[2]=1.0;
    job[3]=2; // Release the voice automatically after playback.
    audio_play(source,job);
    free(scratch);
}

fn encode_wad_music(file pcm) -> file {
    file wave=file_create("");
    void @scratch=aloc(20);
    uint32 @job=scratch;
    job[0]=22050; job[1]=1; job[2]=16; job[3]=1;
    audio_pcm_encode(pcm,wave,job);
    free(scratch);
    return wave;
}

fn load_music_from_wad(uint32 first,uint32 last) -> audio_source {
    if (wad_lump_count==0) { return absent_sound; }
    file events=wad_mus(doom_wad,wad_directory_offset,first,last);
    if (file_size(events)==0) {
        file_close(events);
        return absent_sound;
    }
    file pcm=wad_music_pcm(events);
    file_close(events);
    if (file_size(pcm)==0) {
        file_close(pcm);
        return absent_sound;
    }
    file wave=encode_wad_music(pcm);
    file_close(pcm);
    if (file_size(wave)==0) {
        file_close(wave);
        return absent_sound;
    }
    return load_doom_source(wave,1);
}

fn play_doom_music(uint32 first,uint32 last) -> void {
    if (!doom_audio_ready) { return; }
    bool loading_owner=loading_begin();
    loading_step("Lecture de la musique",41);
    // Keep feeding the previous track while the next one is synthesized.
    audio_source source=load_music_from_wad(first,last);
    void @scratch=aloc(16);
    uint32 @job=scratch;
    float @params=scratch;
    params[0]=0.55; params[1]=0.0; params[2]=1.0;
    job[3]=1;
    audio_voice next=audio_play(source,job);
    if (audio_voice_info(next,job)==0) {
        audio_voice_control(doom_music,3);
        audio_source_free(doom_music_source);
        doom_music=next;
        doom_music_source=source;
        audio_update();
    } else {
        audio_source_free(source);
    }
    free(scratch);
    mouse_ready=false;
    loading_end(loading_owner);
}

fn apply_audio_volume() -> void {
    if (!doom_audio_ready) { return; }
    if (doom_audio_muted) { audio_master_set(0.0); }
    else { audio_master_set(audio_volume/10.0); }
}

fn load_options() -> void {
    file config=file_open("doom-options.bin");
    if (!file_is_readable(config)) { file_close(config); return; }
    if (file_size(config)==6) {
        if (file_read_uint32_at(config,0)==1146048596) {
            int sensitivity=file_read_uint8_at(config,4);
            int volume=file_read_uint8_at(config,5);
            if (sensitivity>=1 && sensitivity<=20) { mouse_sensitivity=sensitivity; }
            if (volume<=10) { audio_volume=volume; }
        }
    }
    file_close(config);
}

fn save_options() -> void {
    if (!options_dirty) { return; }
    file config=file_create("doom-options.bin");
    file_append_uint32(1146048596,config);
    file_append_uint8(mouse_sensitivity,config);
    file_append_uint8(audio_volume,config);
    file_save(config);
    file_close(config);
    options_dirty=false;
}

fn load_doom_audio() -> void {
    doom_audio_ready=audio_init()==0;
    if (!doom_audio_ready) { return; }
    apply_audio_volume();
    // Lump names are two big-endian words, with zero padding for short names.
    sfx_dsbarexp=load_wad_effect(1146307137,1380276304);
    sfx_dsbdcls=load_wad_effect(1146307140,1129075456);
    sfx_dsbdopn=load_wad_effect(1146307140,1330662912);
    sfx_dsbfg=load_wad_effect(1146307142,1191182336);
    sfx_dsclaw=load_wad_effect(1146307404,1096220672);
    sfx_dsdorcls=load_wad_effect(1146307663,1380142163);
    sfx_dsdoropn=load_wad_effect(1146307663,1380929614);
    sfx_dsfirsht=load_wad_effect(1146308169,1381189716);
    sfx_dsfirxpl=load_wad_effect(1146308169,1381519436);
    sfx_dsgetpow=load_wad_effect(1146308421,1414549335);
    sfx_dsitemup=load_wad_effect(1146308948,1162696016);
    sfx_dspistol=load_wad_effect(1146310729,1398034252);
    sfx_dsplasma=load_wad_effect(1146310732,1095978305);
    sfx_dsplpain=load_wad_effect(1146310732,1346455886);
    sfx_dspldeth=load_wad_effect(1146310732,1145394248);
    sfx_dspodth1=load_wad_effect(1146310735,1146374193);
    sfx_dspunch=load_wad_effect(1146310741,1313032192);
    sfx_dsrlaunc=load_wad_effect(1146311244,1096109635);
    sfx_dsrxplod=load_wad_effect(1146311256,1347178308);
    sfx_dssawful=load_wad_effect(1146311489,1464227148);
    sfx_dssawhit=load_wad_effect(1146311489,1464355156);
    sfx_dssawup=load_wad_effect(1146311489,1465208832);
    sfx_dssgtatk=load_wad_effect(1146311495,1413567563);
    sfx_dssgtdth=load_wad_effect(1146311495,1413764168);
    sfx_dsshotgn=load_wad_effect(1146311496,1330923342);
    sfx_dssklatk=load_wad_effect(1146311499,1279349835);
    sfx_dswpnup=load_wad_effect(1146312528,1314213888);
    play_doom_music(1147095374,1414680320);
}

fn play_level_music() -> void {
    if (!doom_audio_ready) { return; }
    int track=episode*10+level_number;
    if (episode==4) {
        if (level_number==1) { track=34; }
        if (level_number==2) { track=32; }
        if (level_number==3) { track=33; }
        if (level_number==4) { track=15; }
        if (level_number==5) { track=27; }
        if (level_number==6) { track=24; }
        if (level_number==7) { track=26; }
        if (level_number==8) { track=25; }
        if (level_number==9) { track=19; }
    }
    play_doom_music(1147094320+track/10,1294991360+(track%10)*65536);
}


fn sector_motion(int room,int floor,int ceiling,int flags) -> void {
    int p=room*12;
    int behavior=file_read_uint8_at(sector_state,p+10);
    if (floor!=32767) {
        file_seek_cursor(p+6,sector_state);
        file_write_little_uint16(coordinate(floor),sector_state);
        behavior=behavior&14;
        if ((flags&4)!=0) { behavior=behavior|1; }
    }
    if (ceiling!=32767) {
        file_seek_cursor(p+8,sector_state);
        file_write_little_uint16(coordinate(ceiling),sector_state);
        behavior=behavior&1;
        if ((flags&8)!=0) { behavior=behavior|2; }
        if ((flags&32)!=0) { behavior=behavior|4; }
        if ((flags&64)!=0) { behavior=behavior|8; }
    }
    file_seek_cursor(p+4,sector_state);
    file_write_little_uint16(0,sector_state);
    file_seek_cursor(p+10,sector_state);
    file_write_uint8(behavior,sector_state);
    lift=true;
}

fn approach(int value,int target,int amount) -> int {
    if (value<target) {
        value+=amount;
        if (value>target) { value=target; }
    } else {
        if (value>target) {
            value-=amount;
            if (value<target) { value=target; }
        }
    }
    return value;
}

fn player_in_sector(int id) -> bool {
    return sector==id || sector_at(px-9.0,py-9.0)==id || sector_at(px+9.0,py-9.0)==id
        || sector_at(px-9.0,py+9.0)==id || sector_at(px+9.0,py+9.0)==id;
}

fn tick_sector(int id,int tics) -> bool {
    int p=id*12;
    int f=signed_word(sector_state,p);
    int c=signed_word(sector_state,p+2);
    int tf=signed_word(sector_state,p+6);
    int tc=signed_word(sector_state,p+8);
    int mode=file_read_uint8_at(sector_state,p+10);
    if (f!=tf || c!=tc) {
        int next_f=approach(f,tf,tics*2);
        int rate=2; if ((mode&8)!=0) { rate=8; }
        int next_c=approach(c,tc,tics*rate);
        if ((next_f>f || next_c<c) && next_c-next_f<49 && player_in_sector(id)) { return true; }
        file_seek_cursor(p,sector_state);
        file_write_little_uint16(coordinate(next_f),sector_state);
        file_write_little_uint16(coordinate(next_c),sector_state);
        return true;
    }
    if ((mode&7)==0) { return false; }
    int timer=file_read_little_uint16_at(sector_state,p+4);
    if (timer==0) {
        timer=105;
        if ((mode&2)!=0) { timer=150; }
        if ((mode&4)!=0) { timer=1050; }
    }
    timer-=tics;
    if (timer<=0) {
        int original=sectors+id*24;
        int return_f=32767; int return_c=32767;
        if ((mode&1)!=0) { return_f=signed_word(data,original); }
        if ((mode&6)!=0) { return_c=signed_word(data,original+2); }
        int flags=0;
        if ((mode&8)!=0) { flags=64; }
        sector_motion(id,return_f,return_c,flags);
        if ((mode&4)!=0) { play_doom_effect(sfx_dsdoropn); }
        if ((mode&2)!=0) {
            if ((mode&8)!=0) { play_doom_effect(sfx_dsbdcls); }
            else { play_doom_effect(sfx_dsdorcls); }
        }
        return true;
    }
    file_seek_cursor(p+4,sector_state);
    file_write_little_uint16(timer,sector_state);
    return true;
}

fn update_lifts(float dt) -> void {
    if (!lift) { return; }
    motion_clock+=dt;
    int tics=motion_clock*35.0;
    if (tics<1) { return; }
    motion_clock-=tics/35.0;
    bool moving=false;
    int id=0;
    while (id<(edges-sectors)/24) {
        if (file_read_uint8_at(data,sectors+id*24+9)>0 && tick_sector(id,tics)) { moving=true; }
        id+=1;
    }
    lift=moving;
}

fn sector_light_level(int room) -> int {
    return file_read_uint8_at(sector_lights,room*6);
}

fn neighbor_light(int room,int initial,bool brightest) -> int {
    int base=sectors+room*24;
    int at=edges+file_read_little_uint16_at(data,base+4)*28;
    int end=at+file_read_little_uint16_at(data,base+6)*28;
    while (at<end) {
        int other=file_read_little_uint16_at(data,at+16)-1;
        if (other>=0 && other!=room) {
            int light=sector_light_level(other);
            if ((brightest && light>initial) || (!brightest && light<initial)) { initial=light; }
        }
        at+=28;
    }
    return initial;
}

fn start_sector_light(int room,int mode) -> void {
    int at=room*6;
    int high=sector_light_level(room);
    int low=neighbor_light(room,high,false);
    int count=1;
    if (mode==1) { count=(doom_random()&64)+1; }
    if (mode==2 || mode==3 || mode==4) { count=(doom_random()&7)+1; }
    if (mode==2 || mode==3 || mode==4 || mode==12 || mode==13) {
        if (low==high) { low=0; }
    }
    if (mode==17) { low+=16; count=4; }
    if (low>255) { low=255; }
    if (file_read_uint8_at(sector_lights,at+4)==0) { file_append_little_uint16(room,active_lights); }
    file_seek_cursor(at+1,sector_lights);
    file_write_uint8(high,sector_lights);
    file_write_uint8(low,sector_lights);
    file_write_uint8(count,sector_lights);
    file_write_uint8(mode,sector_lights);
    file_write_uint8(0,sector_lights);
}

fn initialize_sector_lights() -> void {
    file_clear_data(sector_lights); file_reset_cursor(sector_lights);
    file_clear_data(active_lights); file_reset_cursor(active_lights);
    int rooms=(edges-sectors)/24;
    int room=0;
    while (room<rooms) {
        file_append_uint8(file_read_uint8_at(data,sectors+room*24+8),sector_lights);
        file_append_little_uint32(0,sector_lights);
        file_append_uint8(0,sector_lights);
        room+=1;
    }
    room=0;
    while (room<rooms) {
        int mode=file_read_uint8_at(data,light_specs+room);
        if (mode==1 || mode==2 || mode==3 || mode==4 || mode==8 || mode==12 || mode==13 || mode==17) {
            start_sector_light(room,mode);
        }
        room+=1;
    }
}

fn tick_sector_light(int room) -> void {
    int at=room*6;
    int value=sector_light_level(room);
    int high=file_read_uint8_at(sector_lights,at+1);
    int low=file_read_uint8_at(sector_lights,at+2);
    int count=file_read_uint8_at(sector_lights,at+3)-1;
    int mode=file_read_uint8_at(sector_lights,at+4);
    if (mode==8) {
        int up=file_read_uint8_at(sector_lights,at+5);
        if (up==0) {
            if (value-8>low) { value-=8; }
            else { up=1; }
        } else {
            if (value+8<high) { value+=8; }
            else { up=0; }
        }
        file_seek_cursor(at+5,sector_lights); file_write_uint8(up,sector_lights);
    } else {
        if (count==0) {
            if (mode==1) {
                if (value==high) { value=low; count=(doom_random()&7)+1; }
                else { value=high; count=(doom_random()&64)+1; }
            } else {
                if (mode==17) {
                    int amount=(doom_random()&3)*16;
                    if (value-amount<low) { value=low; }
                    else { value=high-amount; }
                    count=4;
                } else {
                    if (value==low) { value=high; count=5; }
                    else {
                        value=low; count=35;
                        if (mode==2 || mode==4 || mode==13) { count=15; }
                    }
                }
            }
        }
        file_seek_cursor(at+3,sector_lights); file_write_uint8(count,sector_lights);
    }
    file_seek_cursor(at,sector_lights); file_write_uint8(value,sector_lights);
}

fn update_sector_lights() -> void {
    int at=0;
    int end=file_size(active_lights);
    while (at<end) {
        tick_sector_light(file_read_little_uint16_at(active_lights,at));
        at+=2;
    }
}

fn apply_light_action(int patch,int end) -> void {
    int brightest=0;
    while (patch<end) {
        int room=file_read_little_uint16_at(data,patch);
        int value=signed_word(data,patch+2);
        if (value==-3) {
            start_sector_light(room,3);
        } else {
            if (value==-1) { brightest=neighbor_light(room,brightest,true); value=brightest; }
            if (value==-2) { value=neighbor_light(room,sector_light_level(room),false); }
            file_seek_cursor(room*6,sector_lights); file_write_uint8(value,sector_lights);
        }
        patch+=6;
    }
}

fn action_apply(int id,int mode) -> void {
    if (id<=0 || id>action_count || won) { return; }
    int p=actions+(id-1)*16;
    if (file_read_uint8_at(data,p)!=mode) { return; }
    int flags=file_read_uint8_at(data,p+3);
    if ((flags&2)==0 && file_read_uint8_at(used_actions,id-1)>0) { return; }
    int key=file_read_uint8_at(data,p+1);
    if (key>0 && (keys&key)==0) { return; }
    file_seek_cursor(id-1,used_actions); file_write_uint8(1,used_actions);
    int pressed=t_game*1000.0;
    file_seek_cursor((id-1)*4,button_times); file_write_little_uint32(pressed,button_times);

    int next=file_read_uint8_at(data,p+2);
    if (next>0) {
        secret_exit=next==2; won=true; play_doom_music(1147095374,1413829120); return;
    }
    if ((flags&1)!=0) {
        px=signed_word(data,p+8); py=signed_word(data,p+10);
        int room=sector_at(px,py);
        if (room>=0) {
            sector=room; angle=deg2rad(file_read_little_uint16_at(data,p+12));
            dx=cos(angle); dy=sin(angle); feet_z=floor_of(sector); pz=feet_z+41.0; eye_z=pz;
            sync_classic_position();
            move_vx=0.0; move_vy=0.0; sway=0.0; bonus_count=0; bonus_clock=0.0;
        }
        return;
    }
    int patch=changes+file_read_little_uint16_at(data,p+4)*6;
    int end=patch+file_read_little_uint16_at(data,p+6)*6;
    if ((flags&16)!=0) { apply_light_action(patch,end); return; }
    if (patch<end && signed_word(data,patch+4)!=32767) {
        int room=file_read_little_uint16_at(data,patch);
        bool closing=signed_word(data,patch+4)<ceiling_of(room);
        if (closing) {
            if ((flags&64)!=0) { play_doom_effect(sfx_dsbdcls); }
            else { play_doom_effect(sfx_dsdorcls); }
        } else {
            if ((flags&64)!=0) { play_doom_effect(sfx_dsbdopn); }
            else { play_doom_effect(sfx_dsdoropn); }
        }
    }
    while (patch<end) {
        int room=file_read_little_uint16_at(data,patch);
        int f=signed_word(data,patch+2);
        int c=signed_word(data,patch+4);
        sector_motion(room,f,c,flags);
        patch+=6;
    }
}

fn walk_actions(float old_x,float old_y) -> void {
    float mx=px-old_x; float my=py-old_y;
    if (fabs(mx)+fabs(my)<0.001) { return; }
    int p=triggers;
    int end=p+trigger_count*10;
    while (p<end) {
        float ax=signed_word(data,p)-old_x;
        float ay=signed_word(data,p+2)-old_y;
        float ex=signed_word(data,p+4);
        float ey=signed_word(data,p+6);
        float den=mx*ey-my*ex;
        if (fabs(den)>0.001) {
            float u=(ax*my-ay*mx)/den;
            if (u>=0.0 && u<=1.0) {
                float t=(ax*ey-ay*ex)/den;
                if (t>0.0 && t<=1.0) {
                    int id=file_read_little_uint16_at(data,p+8);
                    int flags=file_read_uint8_at(data,actions+(id-1)*16+3);
                    if ((flags&1)==0 || den<0.0) {
                        action_apply(id,2);
                        if ((flags&1)!=0 || won) { return; }
                    }
                }
            }
        }
        p+=10;
    }
}

fn boss_check() -> void {
    if (boss_action==0) { return; }
    int p=0;
    while (p<count*12) {
        if ((file_read_uint8_at(things,p+9)&64)!=0 && file_read_uint8_at(things,p+7)>0) { return; }
        p+=12;
    }
    action_apply(boss_action,8);
    boss_action=0;
}

fn use_wall() -> void {
    ray_setup(px,py,dx,dy);
    int here=sector;
    float after=-4.1;
    int n=0;
    while (n<8) {
        float distance=crossing(here,after,76.0);
        if (edge_hit<0) { return; }
        int id=file_read_little_uint16_at(data,edge_hit+24);
        if (id>0 && file_read_uint8_at(data,actions+(id-1)*16)==1) { action_apply(id,1); return; }
        here=file_read_little_uint16_at(data,edge_hit+16)-1;
        if (here<0 || ceiling_of(here)-floor_of(here)<12) { return; }
        after=distance+0.02;
        n+=1;
    }
}

fn shoot_switch(float vx,float vy) -> void {
    ray_setup(px,py,vx,vy);
    int here=sector;
    float after=-4.1;
    int n=0;
    while (n<10) {
        float distance=crossing(here,after,2048.0);
        if (edge_hit<0) { return; }
        int id=file_read_little_uint16_at(data,edge_hit+24);
        if (id>0 && file_read_uint8_at(data,actions+(id-1)*16)==4) { action_apply(id,4); return; }
        here=file_read_little_uint16_at(data,edge_hit+16)-1;
        if (here<0 || ceiling_of(here)<=pz || floor_of(here)>pz) { return; }
        after=distance+0.02;
        n+=1;
    }
}
fn put_hp(int at, int life) -> void {
    file_seek_cursor(at+7,things);
    file_write_uint8(life,things);
}

fn on_target(int at,float x,float y,float forward) -> bool {
    int room=sector_at(px+x,py+y);
    if (room<0) { return false; }
    float base=floor_of(room);
    float rise=(horizon-64.0)*forward/116.0;
    float target=pz+rise;
    int height=file_read_uint8_at(things,at+8);
    if (target<base-4.0 || target>base+height+4.0) { return false; }
    ray_setup(px,py,x,y);
    sight_rise=rise;
    return visible(sector,pz);
}

fn start_player_death(int source) -> void {
    death_tics=0; death_weapon_y=0; death_viewheight=41.0;
    death_attacker=source;
    map_open=false;
    bfg_windup=0; bullet_streak=0; attack_was_down=false;
    cooldown=0.0; flash=0.0; extra_anim=false;
    tick_edges=0; tick_mouse_x=0;
}

fn damage_player_from(int amount,int source) -> void {
    if (hp<=0) { return; }
    if (difficulty==0) { amount=amount/2; }
    if (file_read_uint8_at(data,light_specs+sector)==11 && amount>=hp) { amount=hp-1; }
    if (invulnerability_tics>0 && amount<1000) { return; }
    if (armor_type>0) {
        int absorbed=amount/(4-armor_type);
        if (armor<=absorbed) { absorbed=armor; armor_type=0; }
        armor-=absorbed; amount-=absorbed;
    }
    if (amount<=0) { return; }

    hp -= amount;
    if (hp < 0) { hp = 0; }
    damage_count+=amount;
    if (damage_count>100) { damage_count=100; }
    hurt = 0.19;
    if (hp==0) { start_player_death(source); }
    else { play_doom_effect(sfx_dsplpain); }
}

fn damage_player(int amount) -> void { damage_player_from(amount,-1); }

fn actor_type(int at) -> int {
    return file_read_little_uint16_at(data,actor_traits+(at/12)*8);
}

fn actor_radius(int at) -> int {
    return file_read_uint8_at(data,actor_traits+(at/12)*8+2);
}

fn actor_flags(int at) -> int {
    return file_read_uint8_at(data,actor_traits+(at/12)*8+3);
}

fn actor_clear(float x,float y,int radius,int exclude) -> bool {
    int at=0;
    while (at<count*12) {
        if (at!=exclude && file_read_uint8_at(things,at+7)>0 && (actor_flags(at)&1)!=0) {
            int gap=radius+actor_radius(at);
            if (fabs(x-signed_word(things,at))<gap && fabs(y-signed_word(things,at+2))<gap) { return false; }
        }
        at+=12;
    }
    return true;
}

// Sector sound targets persist until level reset. A route can cross one sound-blocking line.
fn alert_noise() -> void {
    int rooms=(edges-sectors)/24;
    file_clear_data(noise_queue); file_reset_cursor(noise_queue);
    int room=0;
    while (room<rooms) {
        int heard=file_read_uint8_at(sector_state,room*12+11)&128;
        file_seek_cursor(room*12+11,sector_state); file_write_uint8(heard,sector_state);
        room+=1;
    }
    file_seek_cursor(sector*12+11,sector_state); file_write_uint8(129,sector_state);
    file_append_little_uint16(sector,noise_queue);
    int read=0;
    while (read<file_size(noise_queue)) {
        room=file_read_little_uint16_at(noise_queue,read); read+=2;
        int path=file_read_uint8_at(sector_state,room*12+11)&3;
        int p=sectors+room*24;
        int first=file_read_little_uint16_at(data,p+4);
        int end=first+file_read_little_uint16_at(data,p+6);
        while (first<end) {
            int e=edges+first*28;
            int other=file_read_little_uint16_at(data,e+16)-1;
            int next_path=path;
            if ((file_read_uint8_at(data,e+19)&64)!=0) { next_path+=1; }
            if (other>=0 && other!=room && next_path<=2) {
                int old=file_read_uint8_at(sector_state,other*12+11)&3;
                if ((old==0 || old>next_path) &&
                    fmax(floor_of(other),floor_of(room))<fmin(ceiling_of(other),ceiling_of(room))) {
                    file_seek_cursor(other*12+11,sector_state); file_write_uint8(next_path|128,sector_state);
                    file_append_little_uint16(other,noise_queue);
                }
            }
            first+=1;
        }
    }
}



fn start_barrel(int at) -> void {
    put_hp(at,0);
    file_seek_cursor(at+10,things);
    file_write_little_uint16(660,things);
}

fn blast_barrel(int at) -> void {
    float x=signed_word(things,at);
    float y=signed_word(things,at+2);
    int room=sector_at(x,y);
    if (room<0) { return; }
    float vx=px-x; float vy=py-y;
    if (vx*vx+vy*vy<128.0*128.0) {
        ray_setup(x,y,vx,vy);
        if (visible(room,floor_of(room)+24.0)) {
            int amount=28.0-sqrt(vx*vx+vy*vy)*0.18;
            if (amount>0) { damage_player_from(amount,at); }
        }
    }
    int p=0;
    while (p<count*12) {
        int kind=file_read_uint8_at(things,p+6);
        int life=file_read_uint8_at(things,p+7);
        if (kind<=5 && life>0) {
            vx=signed_word(things,p)-x; vy=signed_word(things,p+2)-y;
            if (vx*vx+vy*vy<120.0*120.0) {
                ray_setup(x,y,vx,vy);
                if (visible(room,floor_of(room)+24.0)) {
                    if (kind==5) { start_barrel(p); }
                    else {
                        life-=5;
                        if (life<=0) {
                            life=0; kills+=1;
                            file_seek_cursor(p+10,things); file_write_little_uint16(0,things);
                        }
                        put_hp(p,life);
                    }
                }
            }
        }
        p+=12;
    }
    boss_check();
    play_doom_effect(sfx_dsbarexp);
}

fn update_barrel(int at,float dt) -> void {
    int timer=file_read_little_uint16_at(things,at+10);
    if (timer==0) { return; }
    if (timer>600) { timer=600; blast_barrel(at); }
    timer-=dt*1000.0;
    if (timer<0) { timer=0; }
    file_seek_cursor(at+10,things); file_write_little_uint16(timer,things);
}

fn damage_actor(int at,int damage) -> void {
    int kind=file_read_uint8_at(things,at+6);
    int life=file_read_uint8_at(things,at+7)-damage;
    if (life>0) {
        put_hp(at,life);
        if (kind<=4) {
            file_seek_cursor(at+2,monster_state); file_write_uint8(1,monster_state);
        }
        return;
    }
    if (kind==5) { start_barrel(at); return; }
    put_hp(at,0);
    file_seek_cursor(at+10,things); file_write_little_uint16(0,things);
    kills+=1;
    if ((file_read_uint8_at(things,at+9)&32)!=0) { play_doom_effect(sfx_dssgtdth); }
    else { play_doom_effect(sfx_dspodth1); }
    boss_check();
}

// Each projectile has position, velocity, lifetime, impact state and family.
fn imp_coord(int at) -> float {
    int raw=file_read_little_uint32_at(imp_shots,at);
    return (raw-1073741824)/1024.0;
}

fn imp_encode(float v) -> int {
    int raw=v*1024.0;
    return raw+1073741824;
}

// Separate ownership keeps the existing 22-byte projectile records compatible.
fn fill_imp_sources() -> void {
    while (file_size(imp_sources)<file_size(imp_shots)/11) { file_append_little_uint16(0,imp_sources); }
}

fn set_imp_source(int shot,int source) -> void {
    fill_imp_sources();
    file_seek_cursor(shot/11,imp_sources);
    file_write_little_uint16(source+1,imp_sources);
}

fn missile_slot() -> int {
    int at=0;
    int size=file_size(imp_shots);
    while (at<size && file_read_little_uint16_at(imp_shots,at+18)>0) { at+=22; }
    if (at>=1408) { return -1; }
    if (at==size) {
        int i=0;
        while (i<22) { file_append_uint8(0,imp_shots); i+=1; }
    }
    set_imp_source(at,-1);
    return at;
}

fn launch_player_missile(int family) -> bool {
    int at=missile_slot();
    if (at<0) { return false; }
    float speed=875.0;
    if (family==1) { speed=700.0; }
    float vz=(horizon-64.0)*speed/116.0;
    file_seek_cursor(at,imp_shots);
    file_write_little_uint32(imp_encode(px),imp_shots);
    file_write_little_uint32(imp_encode(py),imp_shots);
    file_write_little_uint32(imp_encode(feet_z+32.0),imp_shots);
    file_write_little_uint16(coordinate(dx*speed),imp_shots);
    file_write_little_uint16(coordinate(dy*speed),imp_shots);
    file_write_little_uint16(coordinate(vz),imp_shots);
    file_write_little_uint16(4500,imp_shots);
    file_write_uint8(0,imp_shots);
    file_write_uint8(family,imp_shots);
    if (family==1) { play_doom_effect(sfx_dsrlaunc); }
    if (family==2) { play_doom_effect(sfx_dsplasma); }
    return true;
}

fn launch_rocket() -> bool { return launch_player_missile(1); }

fn select_weapon(int weapon) -> void {
    shotgun=weapon==3;
    chaingun=weapon==4;
    extra_anim=false;
    bfg_windup=0;
    bullet_streak=0;
    if (weapon==1) {
        if (!has_chainsaw || (extra_weapon==2 && berserk_tics>0)) { extra_weapon=1; }
        else { extra_weapon=2; }
        return;
    }
    extra_weapon=0;
    if (weapon>=5 && weapon<=7) { extra_weapon=weapon-2; }
}

fn choose_loaded_weapon() -> void {
    if (has_plasma && cells>0) { select_weapon(6); return; }
    if (has_chaingun && ammo>0) { select_weapon(4); return; }
    if (has_shotgun && shells>0) { select_weapon(3); return; }
    if (ammo>0) { select_weapon(2); return; }
    if (has_chainsaw) { select_weapon(1); return; }
    if (has_launcher && rockets>0) { select_weapon(5); return; }
    if (has_bfg && cells>=40) { select_weapon(7); return; }
    select_weapon(1);
}

fn attack_target(float vx,float vy,float range) -> int {
    int best=-1;
    int at=0;
    while (at<count*12) {
        if (file_read_uint8_at(things,at+6)<=5 && file_read_uint8_at(things,at+7)>0) {
            float x=signed_word(things,at)-px; float y=signed_word(things,at+2)-py;
            float depth=x*vx+y*vy;
            if (depth>0.0 && depth<range && fabs(x*vy-y*vx)<actor_radius(at) && on_target(at,x,y,depth)) {
                best=at; range=depth;
            }
        }
        at+=12;
    }
    return best;
}

fn gun_spread() -> float {
    int first=doom_random(); int second=doom_random();
    return (first-second)*0.00038349519697;
}

// Keep the raw damage across pellets before converting to the actor life scale.
fn pellet_damage(file volley,int target,int amount) -> void {
    int at=0;
    int size=file_size(volley);
    while (at<size && file_read_little_uint16_at(volley,at)!=target) { at+=4; }
    int previous=0;
    if (at==size) {
        file_append_little_uint16(target,volley);
        file_append_little_uint16(amount,volley);
    } else {
        previous=file_read_little_uint16_at(volley,at+2);
        file_seek_cursor(at+2,volley);
        file_write_little_uint16(previous+amount,volley);
    }
    int delta=(previous+amount+9)/10-(previous+9)/10;
    if (delta>0) { damage_actor(target,delta); }
}

fn bullet_attack(float yaw,int damage,file volley) -> void {
    float cc=cos(yaw); float ss=sin(yaw);
    float vx=dx*cc-dy*ss; float vy=dx*ss+dy*cc;
    int target=attack_target(vx,vy,2048.0);
    if (target<0) { shoot_switch(vx,vy); return; }
    if (shotgun) { pellet_damage(volley,target,damage); }
    else { damage_actor(target,(damage+9)/10); }
}

fn fire_bullets() -> void {
    extra_anim=true;
    if (shotgun) {
        shells-=1; cooldown=41.0/35.0; flash=7.0/35.0;
        play_doom_effect(sfx_dsshotgn);
        file volley=file_create("");
        int shot=0;
        while (shot<7) {
            int damage=5*(1+doom_random()%3);
            float yaw=gun_spread();
            bullet_attack(yaw,damage,volley);
            shot+=1;
        }
        file_close(volley);
        return;
    }
    ammo-=1;
    cooldown=19.0/35.0; flash=7.0/35.0;
    bool accurate=bullet_streak==0;
    if (chaingun) {
        cooldown=4.0/35.0; flash=5.0/35.0; chaingun_frame=1-chaingun_frame;
        accurate=bullet_streak<2;
    }
    play_doom_effect(sfx_dspistol);
    int damage=5*(1+doom_random()%3);
    float yaw=0.0;
    if (!accurate) { yaw=gun_spread(); }
    if (bullet_streak<2) { bullet_streak+=1; }
    // Pistol and chaingun do not need a volley accumulator.
    bullet_attack(yaw,damage,things);
}

fn shoot() -> void {
    if (cooldown>0.00001 || bfg_windup>0) { return; }
    if ((extra_weapon==3 && rockets<=0) || (extra_weapon==4 && cells<=0)
        || (extra_weapon==5 && cells<40) || (extra_weapon==0 && ((shotgun && shells<=0) || (!shotgun && ammo<=0)))) {
        choose_loaded_weapon();
        return;
    }
    if (extra_weapon==3) {
        if (launch_rocket()) { alert_noise(); rockets-=1; cooldown=20.0/35.0; flash=15.0/35.0; extra_anim=true; }
        return;
    }
    if (extra_weapon==4) {
        if (launch_player_missile(2)) {
            alert_noise();
            cells-=1; plasma_frame=doom_random()&1;
            cooldown=3.0/35.0; flash=4.0/35.0; extra_anim=true;
        }
        return;
    }
    if (extra_weapon==5) {
        alert_noise();
        bfg_windup=30; extra_anim=true;
        play_doom_effect(sfx_dsbfg);
        return;
    }
    alert_noise();
    if (extra_weapon==0) { fire_bullets(); return; }
    extra_anim=true;
    float reach=64.0;
    cooldown=22.0/35.0;
    if (extra_weapon==2) {
        cooldown=4.0/35.0; saw_frame=1-saw_frame;
        reach=65.0;
    }
    int damage=2*(1+doom_random()%10);
    if (extra_weapon==1 && berserk_tics>0) { damage*=10; }
    float yaw=gun_spread();
    float cc=cos(yaw); float ss=sin(yaw);
    int best=attack_target(dx*cc-dy*ss,dx*ss+dy*cc,reach);
    if (best<0) {
        if (extra_weapon==2) { play_doom_effect(sfx_dssawful); }
    } else {
        if (extra_weapon==1) { play_doom_effect(sfx_dspunch); }
        if (extra_weapon==2) { play_doom_effect(sfx_dssawhit); }
        damage_actor(best,(damage+9)/10);
    }
}

fn update_energy_weapon() -> void {
    if (bfg_windup<=0) { return; }
    bfg_windup-=1;
    if (bfg_windup==10) { flash=17.0/35.0; }
    if (bfg_windup==0) {
        if (cells>=40 && launch_player_missile(3)) { cells-=40; }
        cooldown=30.0/35.0;
    }
}


fn launch_imp(float x,float y,int room,int source) -> void {
    if (room<0 || hp<=0) { return; }
    float vx=px-x; float vy=py-y;
    float dist=sqrt(vx*vx+vy*vy);
    if (dist<0.1) { return; }
    int at=missile_slot();
    if (at<0) { return; }
    set_imp_source(at,source);
    if (shadow_time>0.0) {
        int first=doom_random(); int second=doom_random();
        float spread=(first-second)*0.00153398;
        float old_x=vx;
        vx=vx*cos(spread)-vy*sin(spread);
        vy=old_x*sin(spread)+vy*cos(spread);
    }
    float speed=350.0;
    if (difficulty==4) { speed=700.0; }
    float floor=floor_of(room);
    float travel=fmax(dist/speed,0.0285714);
    file_seek_cursor(at,imp_shots);
    file_write_little_uint32(imp_encode(x),imp_shots);
    file_write_little_uint32(imp_encode(y),imp_shots);
    file_write_little_uint32(imp_encode(floor+32.0),imp_shots);
    file_write_little_uint16(coordinate(vx*speed/dist),imp_shots);
    file_write_little_uint16(coordinate(vy*speed/dist),imp_shots);
    file_write_little_uint16(coordinate((feet_z-floor)/travel),imp_shots);
    file_write_little_uint16(4500,imp_shots);
    file_write_uint8(0,imp_shots);
    file_write_uint8(0,imp_shots);
    play_doom_effect(sfx_dsfirsht);
}

fn imp_hit_wall(float x,float y,float z) -> bool {
    int room=sector_at(x,y);
    if (room<0) { return true; }
    return z<floor_of(room) || z+8.0>ceiling_of(room);
}

fn imp_clear(float x,float y,float z) -> bool {
    return !imp_hit_wall(x,y,z) && !imp_hit_wall(x+5.0,y,z) && !imp_hit_wall(x-5.0,y,z)
        && !imp_hit_wall(x,y+5.0,z) && !imp_hit_wall(x,y-5.0,z);
}

fn imp_touch_player(float x,float y,float z) -> bool {
    if (hp<=0) { return false; }
    if (z>feet_z+56.0 || z+8.0<feet_z) { return false; }
    float vx=px-x; float vy=py-y;
    return vx*vx+vy*vy<26.0*26.0;
}

fn rocket_contact(float x,float y,float z,int radius) -> int {
    int at=0;
    while (at<count*12) {
        int kind=file_read_uint8_at(things,at+6);
        if (kind<=5 && file_read_uint8_at(things,at+7)>0) {
            int ax=signed_word(things,at); int ay=signed_word(things,at+2);
            int gap=radius+actor_radius(at);
            if (fabs(x-ax)<gap && fabs(y-ay)<gap) {
                int room=sector_at(ax,ay);
                if (room>=0) {
                    int bottom=floor_of(room);
                    if (z+8.0>=bottom && z<bottom+file_read_uint8_at(things,at+8)) { return at; }
                }
            }
        }
        at+=12;
    }
    return -1;
}

fn bfg_ray(float vx,float vy) -> int {
    int best=-1;
    float closest=1024.0;
    int at=0;
    while (at<count*12) {
        if (file_read_uint8_at(things,at+6)<=5 && file_read_uint8_at(things,at+7)>0) {
            float x=signed_word(things,at)-px; float y=signed_word(things,at+2)-py;
            float depth=x*vx+y*vy;
            if (depth>0.0 && depth<closest && fabs(x*vy-y*vx)<actor_radius(at)) {
                int room=sector_at(px+x,py+y);
                if (room>=0) {
                    ray_setup(px,py,x,y);
                    sight_rise=floor_of(room)+file_read_uint8_at(things,at+8)/2.0-pz;
                    if (visible(sector,pz)) { closest=depth; best=at; }
                }
            }
        }
        at+=12;
    }
    return best;
}

fn bfg_hit_effect(int target) -> void {
    float x=signed_word(things,target); float y=signed_word(things,target+2);
    int room=sector_at(x,y);
    if (room<0) { return; }
    int at=missile_slot();
    if (at<0) { return; }
    float z=floor_of(room)+file_read_uint8_at(things,target+8)/4.0;
    file_seek_cursor(at,imp_shots);
    file_write_little_uint32(imp_encode(x),imp_shots);
    file_write_little_uint32(imp_encode(y),imp_shots);
    file_write_little_uint32(imp_encode(z),imp_shots);
    file_seek_cursor(at+18,imp_shots);
    file_write_little_uint16(896,imp_shots);
    file_write_uint8(1,imp_shots);
    file_write_uint8(4,imp_shots);
}

fn bfg_spray(int at) -> void {
    float vx=signed_word(imp_shots,at+12);
    float vy=signed_word(imp_shots,at+14);
    float speed=sqrt(vx*vx+vy*vy);
    if (speed<=0.0) { return; }
    int ray=0;
    while (ray<40) {
        float angle=-0.7853981634+ray*0.0392699082;
        float cc=cos(angle); float ss=sin(angle);
        int target=bfg_ray((vx*cc-vy*ss)/speed,(vx*ss+vy*cc)/speed);
        if (target>=0) {
            bfg_hit_effect(target);
            int damage=0;
            int dice=0;
            while (dice<15) { damage+=(doom_random()&7)+1; dice+=1; }
            damage_actor(target,(damage+9)/10);
        }
        ray+=1;
    }
}

fn rocket_blast(float x,float y,float z,int source) -> void {
    int room=sector_at(x,y);
    if (room<0) { return; }
    float distance=fmax(fabs(px-x),fabs(py-y))-16.0;
    int damage=128.0-fmax(0.0,distance);
    if (damage>0) {
        ray_setup(x,y,px-x,py-y);
        sight_rise=feet_z+28.0-z;
        if (visible(room,z)) { damage_player_from(damage,source); }
    }
    int at=0;
    while (at<count*12) {
        int type=actor_type(at);
        if (type!=7 && type!=16 && file_read_uint8_at(things,at+6)<=5 && file_read_uint8_at(things,at+7)>0) {
            float vx=signed_word(things,at)-x; float vy=signed_word(things,at+2)-y;
            distance=fmax(fabs(vx),fabs(vy))-actor_radius(at);
            damage=128.0-fmax(0.0,distance);
            if (damage>0) {
                int target=sector_at(x+vx,y+vy);
                if (target>=0) {
                    ray_setup(x,y,vx,vy);
                    sight_rise=floor_of(target)+24.0-z;
                    if (visible(room,z)) { damage_actor(at,(damage+9)/10); }
                }
            }
        }
        at+=12;
    }
}

fn advance_rocket(int at,float dt,int time) -> void {
    int family=file_read_uint8_at(imp_shots,at+21);
    int radius=13; if (family==1) { radius=11; }
    float x=imp_coord(at); float y=imp_coord(at+4); float z=imp_coord(at+8);
    int n=1+dt*175.0;
    float sx=signed_word(imp_shots,at+12)*dt/n;
    float sy=signed_word(imp_shots,at+14)*dt/n;
    float sz=signed_word(imp_shots,at+16)*dt/n;
    int stage=0;
    while (n>0) {
        if (!imp_clear(x+sx,y+sy,z+sz)) { stage=1; break; }
        x+=sx; y+=sy; z+=sz;
        int target=rocket_contact(x,y,z,radius);
        if (target>=0) {
            int roll=1+doom_random()%8;
            int damage=2*roll;
            if (family==2) { damage=(5*roll+9)/10; }
            if (family==3) { damage=10*roll; }
            damage_actor(target,damage);
            stage=1; break;
        }
        n-=1;
    }
    file_seek_cursor(at,imp_shots);
    file_write_little_uint32(imp_encode(x),imp_shots);
    file_write_little_uint32(imp_encode(y),imp_shots);
    file_write_little_uint32(imp_encode(z),imp_shots);
    if (stage==1) {
        if (family==1) { time=504; rocket_blast(x,y,z,-1); }
        if (family==2) { time=560; play_doom_effect(sfx_dsfirxpl); }
        if (family==3) { time=1344; }
        if (family!=2) { play_doom_effect(sfx_dsrxplod); }
    }
    file_seek_cursor(at+18,imp_shots);
    file_write_little_uint16(time,imp_shots);
    file_write_uint8(stage,imp_shots);
}

fn advance_imp(int at,float dt,int time) -> void {
    float x=imp_coord(at); float y=imp_coord(at+4); float z=imp_coord(at+8);
    int n=1+dt*118.0;
    float sx=signed_word(imp_shots,at+12)*dt/n;
    float sy=signed_word(imp_shots,at+14)*dt/n;
    float sz=signed_word(imp_shots,at+16)*dt/n;
    int stage=0;
    while (n>0) {
        if (!imp_clear(x+sx,y+sy,z+sz)) { stage=1; break; }
        x+=sx; y+=sy; z+=sz;
        if (imp_touch_player(x,y,z)) {
            damage_player_from(3*(1+doom_random()%8),file_read_little_uint16_at(imp_sources,at/11)-1);
            stage=1; break;
        }
        n-=1;
    }
    file_seek_cursor(at,imp_shots);
    file_write_little_uint32(imp_encode(x),imp_shots);
    file_write_little_uint32(imp_encode(y),imp_shots);
    file_write_little_uint32(imp_encode(z),imp_shots);
    file_seek_cursor(at+18,imp_shots);
    if (stage==1) {
        time=515;
        play_doom_effect(sfx_dsfirxpl);
    }
    file_write_little_uint16(time,imp_shots);
    file_write_uint8(stage,imp_shots);
}

fn update_imp_shots(float dt) -> void {
    int elapsed=dt*1000.0;
    if (elapsed<1) { return; }
    int at=0;
    int end=file_size(imp_shots);
    while (at<end) {
        int old=file_read_little_uint16_at(imp_shots,at+18);
        if (old>0) {
            int time=old-elapsed;
            int family=file_read_uint8_at(imp_shots,at+21);
            if (time<=0 || file_read_uint8_at(imp_shots,at+20)==1) {
                if (family==3 && old>896 && time<=896 && file_read_uint8_at(imp_shots,at+20)==1) { bfg_spray(at); }
                if (time<0) { time=0; }
                file_seek_cursor(at+18,imp_shots);
                file_write_little_uint16(time,imp_shots);
            } else {
                if (family!=0) { advance_rocket(at,dt,time); }
                else { advance_imp(at,dt,time); }
            }
        }
        at+=22;
    }
}

fn attack_imp(float x,float y,int room,int source) -> void {
    if (room<0) { return; }
    float vx=px-x; float vy=py-y;
    ray_setup(x,y,vx,vy);
    if (vx*vx+vy*vy<58.0*58.0 && visible(room,floor_of(room)+32.0)) {
        damage_player_from(3*(1+doom_random()%8),source);
        play_doom_effect(sfx_dsclaw);
    } else {
        launch_imp(x,y,room,source);
    }
}

fn hostile_coord(int at) -> float {
    int raw=file_read_little_uint32_at(hostile_shots,at);
    return (raw-1073741824)/1024.0;
}

fn launch_hostile(int source,int kind,float z) -> void {
    int end=file_size(hostile_shots);
    int at=0;
    while (at<end && file_read_little_uint16_at(hostile_shots,at+18)>0) { at+=24; }
    if (at>=1200) { return; }
    if (at==end) {
        int byte=0;
        while (byte<24) { file_append_uint8(0,hostile_shots); byte+=1; }
    }
    float x=signed_word(things,source); float y=signed_word(things,source+2);
    float vx=px-x; float vy=py-y;
    float distance=fmax(1.0,sqrt(vx*vx+vy*vy));
    float speed=525.0;
    if (kind==2) { speed=350.0; }
    if (kind==3) { speed=700.0; }
    if (difficulty==4 && kind==1) { speed=700.0; }
    file_seek_cursor(at,hostile_shots);
    file_write_little_uint32(imp_encode(x),hostile_shots);
    file_write_little_uint32(imp_encode(y),hostile_shots);
    file_write_little_uint32(imp_encode(z),hostile_shots);
    file_write_little_uint16(coordinate(vx*speed/distance),hostile_shots);
    file_write_little_uint16(coordinate(vy*speed/distance),hostile_shots);
    file_write_little_uint16(coordinate((feet_z-z+32.0)*speed/distance),hostile_shots);
    file_write_little_uint16(4500,hostile_shots);
    file_write_uint8(0,hostile_shots); file_write_uint8(kind,hostile_shots);
    file_write_little_uint16(source,hostile_shots);
    if (kind==3) { play_doom_effect(sfx_dsrlaunc); }
    else { play_doom_effect(sfx_dsfirsht); }
}

fn hostile_hit_actor(int shot,float x,float y,float z) -> bool {
    int source=file_read_little_uint16_at(hostile_shots,shot+22);
    int species=actor_type(source);
    int at=0;
    while (at<count*12) {
        if (at!=source && file_read_uint8_at(things,at+6)<=5 && file_read_uint8_at(things,at+7)>0) {
            int ax=signed_word(things,at); int ay=signed_word(things,at+2);
            int gap=actor_radius(at)+6;
            if (fabs(x-ax)<gap && fabs(y-ay)<gap) {
                int room=sector_at(ax,ay);
                if (room>=0) {
                    int floor=floor_of(room);
                    if (z+8.0>=floor && z<floor+file_read_uint8_at(things,at+8)) {
                        if (actor_type(at)!=species) {
                            int base=8;
                            int missile=file_read_uint8_at(hostile_shots,shot+21);
                            if (missile==2) { base=5; }
                            if (missile==3) { base=20; }
                            damage_actor(at,(base*(1+doom_random()%8)+9)/10);
                        }
                        return true;
                    }
                }
            }
        }
        at+=12;
    }
    return false;
}

fn advance_hostile(int at,float dt,int timer) -> void {
    float x=hostile_coord(at); float y=hostile_coord(at+4); float z=hostile_coord(at+8);
    int n=1+dt*140.0;
    float sx=signed_word(hostile_shots,at+12)*dt/n;
    float sy=signed_word(hostile_shots,at+14)*dt/n;
    float sz=signed_word(hostile_shots,at+16)*dt/n;
    int impact=0;
    int kind=file_read_uint8_at(hostile_shots,at+21);
    while (n>0) {
        if (!imp_clear(x+sx,y+sy,z+sz)) { impact=1; break; }
        x+=sx; y+=sy; z+=sz;
        if (imp_touch_player(x,y,z)) {
            int damage=8;
            if (kind==2) { damage=5; }
            if (kind==3) { damage=20; }
            damage_player_from(damage*(1+doom_random()%8),file_read_little_uint16_at(hostile_shots,at+22));
            impact=1; break;
        }
        if (hostile_hit_actor(at,x,y,z)) { impact=1; break; }
        n-=1;
    }
    if (impact!=0) {
        timer=515;
        if (kind==3) {
            rocket_blast(x,y,z,file_read_little_uint16_at(hostile_shots,at+22));
            play_doom_effect(sfx_dsrxplod);
        } else { play_doom_effect(sfx_dsfirxpl); }
    }
    file_seek_cursor(at,hostile_shots);
    file_write_little_uint32(imp_encode(x),hostile_shots);
    file_write_little_uint32(imp_encode(y),hostile_shots);
    file_write_little_uint32(imp_encode(z),hostile_shots);
    file_seek_cursor(at+18,hostile_shots); file_write_little_uint16(timer,hostile_shots);
    file_write_uint8(impact,hostile_shots);
}

fn update_hostile(float dt) -> void {
    int elapsed=dt*1000.0;
    int at=0;
    while (at<file_size(hostile_shots)) {
        int timer=file_read_little_uint16_at(hostile_shots,at+18);
        if (timer>0) {
            timer-=elapsed;
            if (timer<=0 || file_read_uint8_at(hostile_shots,at+20)!=0) {
                if (timer<0) { timer=0; }
                file_seek_cursor(at+18,hostile_shots); file_write_little_uint16(timer,hostile_shots);
            } else { advance_hostile(at,dt,timer); }
        }
        at+=24;
    }
}

fn enemy_visible(int room,float x,float y,float z) -> bool {
    int rooms=(edges-sectors)/24;
    int bit=room*rooms+sector;
    if (bit/8<reject_size && (file_read_uint8_at(data,reject_table+bit/8)&(1 << (bit&7)))!=0) { return false; }
    ray_setup(x,y,px-x,py-y);
    sight_rise=pz-z;
    return visible(room,z);
}

fn enemy_awake(int at,int room,bool seen) -> bool {
    if (file_read_uint8_at(monster_state,at+2)!=0) { return true; }
    bool heard=file_read_uint8_at(sector_state,room*12+11)!=0 && ((actor_flags(at)&2)==0 || seen);
    if (!heard) {
        if (!seen) { return false; }
        float yaw=deg2rad(file_read_little_uint16_at(monster_state,at));
        float vx=px-signed_word(things,at); float vy=py-signed_word(things,at+2);
        if (vx*vx+vy*vy>4096.0 && vx*cos(yaw)+vy*sin(yaw)<0.0) { return false; }
    }
    file_seek_cursor(at+2,monster_state); file_write_uint8(1,monster_state);
    return true;
}

fn bearing(float x,float y) -> float {
    if (x==0.0) {
        if (y<0.0) { return 270.0; }
        return 90.0;
    }
    float heading=fatan(y/x)*57.2957795131;
    if (x<0.0) { heading+=180.0; }
    if (heading<0.0) { heading+=360.0; }
    return heading;
}

fn face_player(int at,float x,float y) -> void {
    int heading=bearing(px-x,py-y);
    file_seek_cursor(at,monster_state); file_write_little_uint16(heading,monster_state);
}

fn enemy_step(int at,float x,float y,int floor) -> bool {
    int radius=actor_radius(at);
    if (hp>0 && fabs(px-x)<radius+16 && fabs(py-y)<radius+16) { return false; }
    if (!actor_clear(x,y,radius,at)) { return false; }
    int room=sector_at(x,y);
    if (room<0) { return false; }
    if ((actor_flags(at)&4)!=0) {
        if (ceiling_of(room)-floor_of(room)<file_read_uint8_at(things,at+8)) { return false; }
    } else {
        if (!clear_at(x,y,radius,floor) || floor-ground_floor>24) { return false; }
    }
    return true;
}

fn set_actor_position(int at,float x,float y) -> void {
    file_seek_cursor(at,things);
    file_write_little_uint16(coordinate(x),things);
    file_write_little_uint16(coordinate(y),things);
}

fn enemy_hitscan(int at,int shots) -> void {
    float x=signed_word(things,at); float y=signed_word(things,at+2);
    float vx=px-x; float vy=py-y;
    float d=sqrt(vx*vx+vy*vy);
    if (d<1.0 || d>1024.0) { return; }
    if (shots==1) { play_doom_effect(sfx_dspistol); }
    else { play_doom_effect(sfx_dsshotgn); }
    int i=0;
    while (i<shots) {
        int a=doom_random(); int b=doom_random();
        float spread=(a-b)*0.00153398079;
        if (shadow_time>0.0) { spread*=2.0; }
        int damage=3*(1+doom_random()%5);
        if (fabs(sin(spread))*d<16.0) { damage_player_from(damage,at); }
        i+=1;
    }
}


fn update_pinky(int at,float dt) -> void {
    int timer=file_read_little_uint16_at(things,at+10);
    float x=signed_word(things,at); float y=signed_word(things,at+2);
    float vx=px-x; float vy=py-y;
    float d2=vx*vx+vy*vy;
    if (d2>=1048576.0 && timer==0) { return; }
    int room=sector_at(x,y);
    if (room<0) { return; }
    int floor=floor_of(room);
    bool near=d2<4096.0 && feet_z<floor+56.0 && feet_z+56.0>floor;
    bool seen=enemy_visible(room,x,y,floor+40.0);
    if (!enemy_awake(at,room,seen)) { return; }
    if (seen) { face_player(at,x,y); }
    int flags=file_read_uint8_at(things,at+9)&247;
    if (timer>0) {
        int next=timer-dt*1000.0;
        if (timer>229 && next<=229 && near && seen) {
            play_doom_effect(sfx_dssgtatk);
            damage_player_from(4*(1+doom_random()%10),at);
        }
        if (next<0) { next=0; }
        timer=next;
    } else {
        if (seen && near) { timer=686; }
        if (seen && !near && d2>1600.0) {
            float step=140.0*dt/sqrt(d2);
            if (enemy_step(at,x+vx*step,y,floor)) { x+=vx*step; }
            if (enemy_step(at,x,y+vy*step,floor)) { y+=vy*step; }
            if (x!=signed_word(things,at) || y!=signed_word(things,at+2)) { flags=flags|8; }
            file_seek_cursor(at,things);
            file_write_little_uint16(coordinate(x),things);
            file_write_little_uint16(coordinate(y),things);
        }
    }
    file_seek_cursor(at+9,things); file_write_uint8(flags,things);
    file_seek_cursor(at+10,things); file_write_little_uint16(timer,things);
}

fn enemy_base_z(int at,int room) -> int {
    if ((actor_flags(at)&4)!=0 && file_read_little_uint16_at(monster_state,at+10)!=0) {
        return signed_word(monster_state,at+8);
    }
    int floor=floor_of(room);
    if ((actor_flags(at)&8)!=0) { return ceiling_of(room)-file_read_uint8_at(things,at+8); }
    return floor;
}

fn update_flying_height(int at,int room,float dt) -> void {
    if ((actor_flags(at)&4)==0) { return; }
    int z=enemy_base_z(at,room);
    float goal=fmax(floor_of(room),fmin(feet_z+20.0,ceiling_of(room)-file_read_uint8_at(things,at+8)));
    float step=140.0*dt;
    if (goal>z) { z=fmin(goal,z+step); }
    else { z=fmax(goal,z-step); }
    file_seek_cursor(at+8,monster_state);
    file_write_little_uint16(coordinate(z),monster_state);
    file_write_little_uint16(1,monster_state);
}

fn launch_skull(int at,float vx,float vy,float d) -> void {
    file_seek_cursor(at+3,monster_state); file_write_uint8(1,monster_state);
    file_write_little_uint16(coordinate(vx*700.0/d),monster_state);
    file_write_little_uint16(coordinate(vy*700.0/d),monster_state);
    play_doom_effect(sfx_dssklatk);
}

fn fly_skull(int at,float dt,int floor) -> bool {
    float x=signed_word(things,at)+signed_word(monster_state,at+4)*dt;
    float y=signed_word(things,at+2)+signed_word(monster_state,at+6)*dt;
    if (fabs(px-x)<32.0 && fabs(py-y)<32.0) {
        damage_player_from(3*(1+doom_random()%8),at);
    } else {
        if (enemy_step(at,x,y,floor)) { set_actor_position(at,x,y); return true; }
    }
    file_seek_cursor(at+3,monster_state); file_write_uint8(0,monster_state);
    return false;
}

fn enemy_attack(int at,int type,int room,float distance) -> void {
    float x=signed_word(things,at); float y=signed_word(things,at+2);
    float z=enemy_base_z(at,room);
    if (type==3001) { attack_imp(x,y,room,at); return; }
    if (type==3004) { enemy_hitscan(at,1); return; }
    if (type==9 || type==7) { enemy_hitscan(at,3); return; }
    if (type==3003 || type==3005) {
        if (distance<64.0 && fabs(feet_z-z)<56.0) {
            int dice=8;
            if (type==3005) { dice=6; } else { play_doom_effect(sfx_dsclaw); }
            damage_player_from(10*(1+doom_random()%dice),at);
        } else {
            if (type==3003) { launch_hostile(at,1,z+32.0); }
            else { launch_hostile(at,2,z+32.0); }
        }
        return;
    }
    if (type==16) { launch_hostile(at,3,z+32.0); return; }
    if (type==3006 && distance>1.0) { launch_skull(at,px-x,py-y,distance); }
}

fn enemy_try_door(int room,float x,float y,float vx,float vy) -> void {
    ray_setup(x,y,vx,vy);
    float distance=crossing(room,-0.001,1.0);
    if (edge_hit<0 || distance>=1.0 || (file_read_uint8_at(data,edge_hit+19)&4)==0) { return; }
    int other=file_read_little_uint16_at(data,edge_hit+16)-1;
    if (other>=0 && ceiling_of(other)==floor_of(other)) {
        action_apply(file_read_little_uint16_at(data,edge_hit+24),1);
    }
}

fn enemy_chase(int at,float dt,int room,float d) -> void {
    float x=signed_word(things,at); float y=signed_word(things,at+2);
    float vx=px-x; float vy=py-y;
    float step=file_read_uint8_at(data,actor_traits+(at/12)*8+6)*8.75*dt/d;
    if (difficulty==4) { step*=1.3; }
    int floor=floor_of(room);
    float tx=x+vx*step; float ty=y+vy*step;
    if (enemy_step(at,tx,ty,floor)) { set_actor_position(at,tx,ty); return; }
    enemy_try_door(room,x,y,vx*64.0/d,vy*64.0/d);
    if (enemy_step(at,tx,y,floor)) { x=tx; }
    if (enemy_step(at,x,ty,floor)) { y=ty; }
    set_actor_position(at,x,y);
}

fn update_monster(int at,int kind,float dt) -> void {
    // With no living player to target, return to the standing state.
    if (hp<=0) {
        file_seek_cursor(at+9,things);
        file_write_uint8(file_read_uint8_at(things,at+9)&247,things);
        file_write_little_uint16(0,things);
        file_seek_cursor(at+2,monster_state); file_write_uint8(0,monster_state);
        file_write_uint8(0,monster_state);
        return;
    }
    if ((file_read_uint8_at(things,at+9)&32)!=0) { update_pinky(at,dt); return; }
    int type=actor_type(at);
    float x=signed_word(things,at); float y=signed_word(things,at+2);
    float vx=px-x; float vy=py-y;
    float d2=vx*vx+vy*vy;
    int wait=file_read_little_uint16_at(things,at+10);
    if (d2>1440000.0 && wait<=20000) { return; }
    int room=sector_at(x,y);
    if (room<0) { return; }
    bool seen=enemy_visible(room,x,y,enemy_base_z(at,room)+40.0);
    if (!enemy_awake(at,room,seen)) { return; }
    if (seen) { face_player(at,x,y); }
    float distance=sqrt(d2);
    update_flying_height(at,room,dt);
    if (type==3006 && file_read_uint8_at(monster_state,at+3)!=0) {
        if (fly_skull(at,dt,floor_of(room))) { return; }
    }
    int next=wait-dt*1000.0;
    if (next<0) { next=0; }
    if (wait>20000) {
        if (type==16) {
            if ((wait>21714 && next<=21714) || (wait>21029 && next<=21029) || (wait>20343 && next<=20343)) {
                enemy_attack(at,type,room,distance);
            }
        } else {
            if (wait>20000 && next<=20000) {
                if (seen) { enemy_attack(at,type,room,distance); }
                if (type==7 && seen && doom_random()>=10) { next=20114; }
            }
        }
        if (next<=20000) { next=1000; if (difficulty==4) { next=430; } }
    } else {
        if (distance>58.0 && (seen || file_read_uint8_at(sector_state,room*12+11)!=0)) { enemy_chase(at,dt,room,distance); }
        float range=320.0;
        if (kind==1) { range=800.0; }
        if (next==0 && seen && distance<range) {
            next=20286;
            if (type==3003) { next=20457; }
            if (type==7) { next=20572; }
            if (type==16) { next=21886; }
            if (kind==4) { next=20342; }
        }
    }
    file_seek_cursor(at+10,things); file_write_little_uint16(next,things);
}

fn rocket_capacity() -> int {
    if (backpack) { return 100; }
    return 50;
}

fn give_rockets(int amount) -> void {
    if (difficulty==0 || difficulty==4) { amount*=2; }
    rockets+=amount;
    int limit=rocket_capacity();
    if (rockets>limit) { rockets=limit; }
}

fn collect_rocket_pickup(int kind) -> bool {
    if (kind==21) {
        if (has_launcher && rockets>=rocket_capacity()) { return false; }
        if (!has_launcher) { select_weapon(5); }
        has_launcher=true;
        give_rockets(2);
        return true;
    }
    if (rockets>=rocket_capacity()) { return false; }
    if (kind==22) { give_rockets(1); }
    else { give_rockets(5); }
    return true;
}

fn pickup_sound(int at,int kind) -> void {
    if (kind==19 || kind==20 || kind==21 || kind==31 || kind==32) {
        play_doom_effect(sfx_dswpnup);
        return;
    }
    if (kind==9 && file_read_little_uint16_at(things,at+4)==file_read_little_uint16_at(data,map_base+56)) {
        play_doom_effect(sfx_dswpnup);
        return;
    }
    if ((kind>=15 && kind<=18) || kind==24 || kind==35 || kind==36) {
        play_doom_effect(sfx_dsgetpow);
        return;
    }
    play_doom_effect(sfx_dsitemup);
}

fn collect_health_armor(int kind) -> bool {
    if (kind==7 || kind==25) {
        if (hp>=100) { return false; }
        if (kind==7) { hp+=10; } else { hp+=25; }
        if (hp>100) { hp=100; }
        notify(5);
    }
    if (kind==26) { if (hp<200) { hp+=1; } }
    if (kind==27) {
        if (armor<200) { armor+=1; }
        if (armor_type==0) { armor_type=1; }
    }
    if (kind==8 || kind==28) {
        int new_type=1; if (kind==28) { new_type=2; }
        if (armor>=new_type*100) { return false; }
        armor_type=new_type; armor=new_type*100; notify(6);
    }
    return true;
}

fn give_bullets(int amount) -> bool {
    int capacity=200; if (backpack) { capacity=400; }
    if (ammo>=capacity) { return false; }
    if (difficulty==0 || difficulty==4) { amount*=2; }
    ammo+=amount;
    if (ammo>capacity) { ammo=capacity; }
    return true;
}

fn give_shells(int amount) -> bool {
    int capacity=50; if (backpack) { capacity=100; }
    if (shells>=capacity) { return false; }
    if (difficulty==0 || difficulty==4) { amount*=2; }
    shells+=amount;
    if (shells>capacity) { shells=capacity; }
    return true;
}

fn cell_capacity() -> int {
    if (backpack) { return 600; }
    return 300;
}

fn give_cells(int amount) -> bool {
    int limit=cell_capacity();
    if (cells>=limit) { return false; }
    if (difficulty==0 || difficulty==4) { amount*=2; }
    if (cells==0 && has_plasma && extra_weapon==0 && !shotgun && !chaingun) { select_weapon(6); }
    cells+=amount;
    if (cells>limit) { cells=limit; }
    return true;
}

fn collect_energy_pickup(int kind) -> bool {
    if (kind==31 || kind==32) {
        bool already=has_plasma;
        if (kind==32) { already=has_bfg; }
        if (!give_cells(40) && already) { return false; }
        if (!already) { select_weapon(kind-25); }
        if (kind==31) { has_plasma=true; } else { has_bfg=true; }
    }
    if (kind==33) { return give_cells(20); }
    if (kind==34) { return give_cells(100); }
    if (kind==35) {
        if (hp<100) { hp=100; }
        berserk_tics=1;
        select_weapon(1); extra_weapon=1;
    }
    if (kind==36) { invulnerability_tics=1050; }
    return true;
}

fn update_things(float dt) -> void {
    int at = 0;
    while (at < count*12) {
        int kind = file_read_uint8_at(things,at+6);
        int life = file_read_uint8_at(things,at+7);
        if (life==0 && kind==5) { update_barrel(at,dt); }
        if (life==0 && kind<=4 && ((difficulty==4 && !won) || kind==1)) {
            int age=file_read_little_uint16_at(things,at+10)+dt*1000.0;
            if (age>=12000 && difficulty==4 && !won) {
                int x=signed_word(data,actor_base+at);
                int y=signed_word(data,actor_base+at+2);
                if (fabs(px-x)+fabs(py-y)>120.0) {
                    file_seek_cursor(at,things);
                    file_write_little_uint16(coordinate(x),things);
                    file_write_little_uint16(coordinate(y),things);
                    life=file_read_uint8_at(data,actor_base+at+7);
                    put_hp(at,life);
                    file_seek_cursor(at+9,things);
                    file_write_uint8(file_read_uint8_at(data,actor_base+at+9),things);
                    file_seek_cursor(at+2,monster_state);
                    file_write_little_uint32(0,monster_state);
                    file_write_little_uint32(0,monster_state);
                    file_write_little_uint16(0,monster_state);
                    age=0;
                } else { age=12000; }
            }
            if (age>12000) { age=12000; }
            file_seek_cursor(at+10,things); file_write_little_uint16(age,things);
        }
        if (hp>0 && life==0 && kind>=2 && kind<=3 && (file_read_uint8_at(things,at+9)&128)==0) {
            float rx=px-signed_word(things,at);
            float ry=py-signed_word(things,at+2);
            if (rx*rx+ry*ry<750.0) {
                file_seek_cursor(at+9,things);
                file_write_uint8(128,things);
                if (kind==3) { has_shotgun=true; give_shells(4); }
                else { give_bullets(5); }
                bonus_count+=6; play_doom_effect(sfx_dsitemup);
            }
        }
        if (life > 0 && kind != 5 && kind != 10) {
            float ax = signed_word(things,at);
            float ay = signed_word(things,at+2);
            float vx = px-ax;
            float vy = py-ay;
            float d2 = vx*vx+vy*vy;
            if (kind<=4) { update_monster(at,kind,dt); }
            if (hp>0 && d2 < 850.0 && kind >= 6) {
                if (!collect_health_armor(kind)) { at+=12; continue; }
                if (kind == 11) { keys=keys|1; }
                if (kind == 12) { keys=keys|2; }
                if (kind == 13) { keys=keys|4; }
                if (kind==6 && !give_bullets(10)) { at+=12; continue; }
                if (kind==29 && !give_bullets(50)) { at+=12; continue; }
                if (kind==30 && !give_shells(20)) { at+=12; continue; }
                if (kind == 9) {
                    int sprite = file_read_little_uint16_at(things,at+4);
                    if (file_read_little_uint16_at(data,map_base+56) == sprite) {
                        bool refilled=give_shells(8);
                        if (has_shotgun && !refilled) { at+=12; continue; }
                        if (!has_shotgun) { select_weapon(3); }
                        has_shotgun=true; notify(7);
                    } else { if (!give_shells(4)) { at+=12; continue; } }
                }
                if (kind==14) { backpack=true; give_bullets(10); give_shells(4); give_rockets(1); give_cells(20); }
                if (kind==15) { hp+=100; if (hp>200) { hp=200; } }
                if (kind==16) { suit_time=60.0; }
                if (kind==17) { light_time=120.0; }
                if (kind==18) { shadow_time=60.0; }
                if (kind==19) {
                    bool refilled=give_bullets(20);
                    if (has_chaingun && !refilled) { at+=12; continue; }
                    if (!has_chaingun) { select_weapon(4); }
                    has_chaingun=true;
                }
                if (kind==20) {
                    if (has_chainsaw) { at+=12; continue; }
                    has_chainsaw=true;
                    select_weapon(1);
                    play_doom_effect(sfx_dssawup);
                }
                if (kind>=21 && kind<=23 && !collect_rocket_pickup(kind)) { at+=12; continue; }
                if (kind==24) {
                    if (computer_map) { at+=12; continue; }
                    computer_map=true;
                }
                if (kind>=31 && !collect_energy_pickup(kind)) { at+=12; continue; }
                if (counted_item(kind)) { gathered+=1; }
                bonus_count+=6;
                pickup_sound(at,kind);
                put_hp(at,0);
            }
        }
        at += 12;
    }
}

fn capture_mouse(bool capture) -> void {
    if (capture==mouse_captured) { return; }
    mouse_captured=capture; mouse_ready=false;
    if (capture) { window_disable_cursor(); }
    else { window_enable_cursor(); }
}

// Split the product into 16-bit limbs. Steg exposes 32-bit integers.
fn fixed_mul(int a,int b) -> int {
    int al=a&65535; int bl=b&65535;
    int ah=(a-al)/65536; int bh=(b-bl)/65536;
    uint32 product=al*bl;
    int carry=product>>16;
    return ah*b+bh*al+carry;
}

fn fine_sine(int index) -> int {
    return file_read_little_uint32_at(doom_sine_data,(index&8191)*4);
}

fn classic_partition(int x,int y,int vx,int vy) -> int {
    if (vx==0) {
        if ((x<=0 && vy>0) || (x>0 && vy<0)) { return 1; }
        return 0;
    }
    if (vy==0) {
        if ((y<=0 && vx<0) || (y>0 && vx>0)) { return 1; }
        return 0;
    }
    if (fixed_mul(y,vx)<fixed_mul(x,vy)) { return 0; }
    return 1;
}

fn classic_sector_at(int x,int y) -> int {
    if (classic_node_count==0) { return file_read_little_uint16_at(data,classic_leaves); }
    int child=classic_node_count-1;
    while (child<32768) {
        int p=classic_nodes+child*28;
        int xx=x-signed_word(data,p)*65536; int yy=y-signed_word(data,p+2)*65536;
        int vx=signed_word(data,p+4); int vy=signed_word(data,p+6);
        int side=0;
        if (vx!=0 && vy!=0 && (vx^vy^xx^yy)<0) {
            if ((vy^xx)<0) { side=1; }
        } else { side=classic_partition(xx,yy,vx,vy); }
        child=file_read_little_uint16_at(data,p+24+side*2);
    }
    return file_read_little_uint16_at(data,classic_leaves+(child&32767)*2);
}

fn classic_crosses(int x0,int y0,int x1,int y1) -> bool {
    if ((classic_left>=x0 && classic_left>=x1) || (classic_right<=x0 && classic_right<=x1)
        || (classic_bottom>=y0 && classic_bottom>=y1) || (classic_top<=y0 && classic_top<=y1)) { return false; }
    int vx=(x1-x0)/65536; int vy=(y1-y0)/65536;
    if (vx==0 || vy==0) { return true; }
    int ax=classic_left-x0; int bx=classic_right-x0;
    if ((vx<0 && vy>0) || (vx>0 && vy<0)) {
        ax=classic_right-x0; bx=classic_left-x0;
    }
    return classic_partition(ax,classic_top-y0,vx,vy)!=classic_partition(bx,classic_bottom-y0,vx,vy);
}

fn classic_open_line(int p) -> bool {
    int x0=signed_word(data,p)*65536; int y0=signed_word(data,p+2)*65536;
    int x1=signed_word(data,p+4)*65536; int y1=signed_word(data,p+6)*65536;
    if (!classic_crosses(x0,y0,x1,y1)) { return true; }
    int flags=file_read_little_uint16_at(data,p+8);
    int front=file_read_little_uint16_at(data,p+10)-1;
    int back=file_read_little_uint16_at(data,p+12)-1;
    if (back<0 || front<0 || (flags&1)!=0) { return false; }
    int floor=floor_of(front); int ceiling=ceiling_of(front);
    if (floor>classic_floor) { classic_floor=floor; }
    if (ceiling<classic_ceiling) { classic_ceiling=ceiling; }
    floor=floor_of(back); ceiling=ceiling_of(back);
    if (floor>classic_floor) { classic_floor=floor; }
    if (ceiling<classic_ceiling) { classic_ceiling=ceiling; }
    return true;
}

fn classic_check_lines() -> bool {
    int x0=(classic_left-classic_block_x)>>23; int x1=(classic_right-classic_block_x)>>23;
    int y0=(classic_bottom-classic_block_y)>>23; int y1=(classic_top-classic_block_y)>>23;
    if (x0<0) { x0=0; } if (x1>=classic_block_w) { x1=classic_block_w-1; }
    if (y0<0) { y0=0; } if (y1>=classic_block_h) { y1=classic_block_h-1; }
    int x=x0;
    while (x<=x1) {
        int y=y0;
        while (y<=y1) {
            int slot=classic_blockmap+8+(y*classic_block_w+x)*2;
            int list=classic_blockmap+file_read_little_uint16_at(data,slot)*2;
            int line=file_read_little_uint16_at(data,list);
            while (line!=65535) {
                if (!classic_open_line(classic_lines+line*14)) { return false; }
                list+=2; line=file_read_little_uint16_at(data,list);
            }
            y+=1;
        }
        x+=1;
    }
    return true;
}

fn classic_position_limits(int x,int y,int room) -> bool {
    classic_floor=floor_of(room); classic_ceiling=ceiling_of(room);
    classic_left=x-1048576; classic_right=x+1048576;
    classic_bottom=y-1048576; classic_top=y+1048576;
    return classic_check_lines();
}

fn classic_update_height(int displacement) -> void {
    // Keep the same supporting floor as movement until the whole radius clears a ledge.
    feet_z=floor_of(sector);
    int ceiling=ceiling_of(sector);
    if (classic_position_limits(classic_x,classic_y,sector)) {
        feet_z=classic_floor; ceiling=classic_ceiling;
    }
    pz=fmin(ceiling-4.0,feet_z+41.0+displacement/65536.0);
    eye_z=pz;
}

fn classic_try_move(int x,int y) -> bool {
    float target_x=x/65536.0; float target_y=y/65536.0;
    if (!actor_clear(target_x,target_y,16,-1)) { return false; }
    int room=classic_sector_at(x,y);
    int height=56; if (hp<=0) { height=14; }
    if (!classic_position_limits(x,y,room) || classic_ceiling-classic_floor<height
        || classic_ceiling-feet_z<height || classic_floor-feet_z>24) { return false; }
    classic_x=x; classic_y=y;
    px=target_x; py=target_y; sector=room;
    return true;
}

fn classic_thrust(int magnitude,int heading) -> void {
    classic_momx+=fixed_mul(magnitude,fine_sine(heading+2048));
    classic_momy+=fixed_mul(magnitude,fine_sine(heading));
}

fn classic_move_step(int mx,int my) -> void {
    if (!classic_try_move(classic_x+mx,classic_y+my)) {
        if (!classic_try_move(classic_x,classic_y+my)) { classic_momy=0; }
        if (!classic_try_move(classic_x+mx,classic_y)) { classic_momx=0; }
    }
}

fn move_classic() -> void {
    classic_heading=(classic_heading+tick_angleturn)&65535;
    angle=classic_heading*0.00009587379924285257;
    int fine=classic_heading>>3;
    dx=fine_sine(fine+2048)/65536.0; dy=fine_sine(fine)/65536.0;
    int forward=tick_forward*2048.0; int side=tick_side*2048.0;
    classic_thrust(forward,fine);
    classic_thrust(side,fine-2048);
    int motion=fixed_mul(classic_momx,classic_momx)+fixed_mul(classic_momy,classic_momy);
    int bob_amplitude=motion/4;
    if (bob_amplitude>1048576) { bob_amplitude=1048576; }
    int phase=(level_tic-1)*409;
    if (phase<0) { phase=0; }
    int displacement=fixed_mul(bob_amplitude/2,fine_sine(phase));
    float old_x=px; float old_y=py;
    if (classic_momx>1966080) { classic_momx=1966080; }
    if (classic_momx< -1966080) { classic_momx=-1966080; }
    if (classic_momy>1966080) { classic_momy=1966080; }
    if (classic_momy< -1966080) { classic_momy=-1966080; }
    if (classic_momx!=0 || classic_momy!=0) {
        int mx=classic_momx; int my=classic_momy;
        if (mx>983040 || my>983040) { classic_move_step(mx/2,my/2); mx=mx>>1; my=my>>1; }
        classic_move_step(mx,my);
    }
    classic_update_height(displacement);
    sway=bob_amplitude/1048576.0; bob=phase*0.00076699039394282;
    if (classic_momx>-4096 && classic_momx<4096 && classic_momy>-4096 && classic_momy<4096
        && forward==0 && side==0) {
        classic_momx=0; classic_momy=0;
    } else {
        classic_momx=fixed_mul(classic_momx,59392);
        classic_momy=fixed_mul(classic_momy,59392);
    }
    move_vx=classic_momx*(35.0/65536.0); move_vy=classic_momy*(35.0/65536.0);
    walk_actions(old_x,old_y);
}
fn pressed_weapon(int key) -> bool {
    return (tick_edges & (1 << (key-44)))!=0;
}

fn capture_tick_input() -> void {
    tick_held=0;
    if (window_key_down(265) || window_key_down(90) || window_key_down(87)) { tick_held=tick_held|1; }
    if (window_key_down(264) || window_key_down(83)) { tick_held=tick_held|2; }
    if (window_key_down(81) || window_key_down(65)) { tick_held=tick_held|4; }
    if (window_key_down(68)) { tick_held=tick_held|8; }
    if (window_key_down(263)) { tick_held=tick_held|16; }
    if (window_key_down(262)) { tick_held=tick_held|32; }
    if (window_key_down(340) || window_key_down(344)) { tick_held=tick_held|64; }
    if (window_key_down(341) || window_key_down(345) || window_mouse_button_down(0)) { tick_held=tick_held|128; }

    if (window_key_pressed(69) || window_key_pressed(32)) { tick_edges=tick_edges|2; }
    if (window_key_pressed(77) || window_key_pressed(258)) { tick_edges=tick_edges|4; }

    if (window_key_pressed(341) || window_key_pressed(345) || window_mouse_button_pressed(0)) { tick_edges=tick_edges|4096; }
    int key=49;
    while (key<=55) {
        if (window_key_pressed(key)) { tick_edges=tick_edges|(1 << (key-44)); }
        key+=1;
    }
    if (mouse_captured && !map_open) {
        if (mouse_ready) { tick_mouse_x+=window_mouse_delta_x(); }
        mouse_ready=true;
    }
}

fn apply_floor_special() -> void {
    if (feet_z!=floor_of(sector)) { return; }
    int special=file_read_uint8_at(data,light_specs+sector);
    int phase=level_tic-1;
    if (phase<0) { phase=0; }
    bool pulse=(phase&31)==0;
    if (special==4 || special==16) {
        if ((suit_time<=0.0 || doom_random()<5) && pulse) { damage_player(20); }
    }
    if (suit_time<=0.0 && pulse) {
        if (special==5) { damage_player(10); }
        if (special==7) { damage_player(5); }
    }
    if (special==11) {
        if (pulse) { damage_player(20); }
        if (hp<=10) { won=true; play_doom_music(1147095374,1413829120); }
    }
    if (special==9 && file_read_uint8_at(explored,sector)==0) {
        file_seek_cursor(sector,explored); file_write_uint8(1,explored); secrets+=1;
    }
}

fn update(float dt) -> void {
    t_game += dt; update_lifts(dt);
    suit_time-=dt; light_time-=dt; shadow_time-=dt;
    if (berserk_tics>0 && berserk_tics<768) { berserk_tics+=1; }
    if (invulnerability_tics>0) { invulnerability_tics-=1; }
    if (bonus_count>0) {
        bonus_clock+=dt*35.0;
        int ticks=bonus_clock;
        bonus_clock-=ticks;
        bonus_count-=ticks;
    } else { bonus_clock=0.0; }
    cooldown -= dt; flash -= dt; hurt -= dt; info_time -= dt;
    move_classic();
    if ((tick_edges&2)!=0) { use_wall(); }
    if (pressed_weapon(49)) { select_weapon(1); }
    if (pressed_weapon(50)) { select_weapon(2); }
    if (pressed_weapon(51) && has_shotgun) { select_weapon(3); }
    if (pressed_weapon(52) && has_chaingun) { select_weapon(4); }
    if (pressed_weapon(53) && has_launcher) { select_weapon(5); }
    if (pressed_weapon(54) && has_plasma) { select_weapon(6); }
    if (pressed_weapon(55) && has_bfg) { select_weapon(7); }
    update_energy_weapon();
    bool attacking=(tick_held&128)!=0 || (tick_edges&4096)!=0;
    if (!attacking) { bullet_streak=0; }
    if (extra_weapon==4 && !attacking && attack_was_down && extra_anim) { cooldown+=20.0/35.0; }
    if (attacking && ((extra_weapon!=3 && extra_weapon!=5) || !attack_was_down || (tick_edges&4096)!=0)) { shoot(); }
    attack_was_down=attacking;
    if ((tick_edges&4)!=0) { map_open = !map_open; capture_mouse(!map_open); }

    apply_floor_special();
    update_things(dt);
    update_imp_shots(dt);
    update_hostile(dt);
    int max_bullets=200; int max_shells=50;
    if (backpack) { max_bullets=400; max_shells=100; }
    if (ammo>max_bullets) { ammo=max_bullets; } if (shells>max_shells) { shells=max_shells; }
}

// Vanilla death: one unit of view height and six weapon units per 35 Hz tic.
fn turn_death_camera() -> bool {
    if (death_attacker<0 || death_attacker>=count*12 || death_attacker%12!=0) { return true; }
    float x=signed_word(things,death_attacker)-px;
    float y=signed_word(things,death_attacker+2)-py;
    if (x==0.0 && y==0.0) { return true; }
    int target=bearing(x,y)*(65536.0/360.0);
    int delta=(target-classic_heading)&65535;
    bool facing=delta<910 || delta>64626;
    if (facing) { classic_heading=target; }
    else {
        if (delta<32768) { classic_heading+=910; }
        else { classic_heading-=910; }
    }
    classic_heading=classic_heading&65535;
    angle=classic_heading*0.00009587379924285257;
    dx=fine_sine((classic_heading>>3)+2048)/65536.0;
    dy=fine_sine(classic_heading>>3)/65536.0;
    return facing;
}

fn move_dead_player() -> void {
    if (classic_momx!=0 || classic_momy!=0) {
        int mx=classic_momx; int my=classic_momy;
        if (mx>983040 || my>983040) { classic_move_step(mx/2,my/2); mx=mx>>1; my=my>>1; }
        classic_move_step(mx,my);
    }
    classic_momx=fixed_mul(classic_momx,59392);
    classic_momy=fixed_mul(classic_momy,59392);
    if (classic_momx> -4096 && classic_momx<4096) { classic_momx=0; }
    if (classic_momy> -4096 && classic_momy<4096) { classic_momy=0; }
    classic_update_height(0);
    pz=fmin(classic_ceiling-4.0,feet_z+death_viewheight);
    eye_z=pz; sway=0.0; move_vx=0.0; move_vy=0.0;
}

fn update_death(float dt) -> void {
    if ((tick_edges&2)!=0) { reset(); return; } // Keep the current level music playing.
    death_tics+=1;
    if (death_tics==10) { play_doom_effect(sfx_dspldeth); }
    death_viewheight=fmax(6.0,death_viewheight-1.0);
    death_weapon_y=fmin(96.0,death_weapon_y+6);
    t_game+=dt; update_lifts(dt);
    move_dead_player();
    if (turn_death_camera() && damage_count>0) { damage_count-=1; }
    flash-=dt; hurt-=dt; info_time-=dt;
    update_things(dt); update_imp_shots(dt); update_hostile(dt);
}

fn run_game_tic() -> void {
    level_tic+=1;
    if (hp>0) {
        if (damage_count>0) { damage_count-=1; }
        update(1.0/35.0);
    } else { update_death(1.0/35.0); }
    update_sector_lights();
    tick_edges=0; tick_mouse_x=0;
}

fn build_classic_command() -> void {
    int speed=0;
    if ((tick_held&64)!=0) { speed=1; }
    int direction=(tick_held&16)/16-(tick_held&32)/32;
    if (direction!=0) { turn_held_tics+=1; } else { turn_held_tics=0; }
    int key_turn=320;
    if (turn_held_tics>=6) { key_turn=640*(speed+1); }
    int mouse_x=tick_mouse_x*(mouse_sensitivity+5)/10;
    tick_angleturn=direction*key_turn-mouse_x*8;
    int forward=(tick_held&1)-(tick_held&2)/2;
    int side=(tick_held&8)/8-(tick_held&4)/4;
    tick_forward=forward*25*(speed+1);
    tick_side=side*(24+16*speed);
}

fn run_live_tics(float elapsed) -> void {
    tic_clock+=elapsed*35.0;
    while (tic_clock>=1.0 && !won) {
        if (hp>0) { build_classic_command(); }
        tic_clock-=1.0;
        run_game_tic();
    }
}


// StegVM flips the uploaded texture when drawing. Write rows bottom-up.
fn rect(framebuffer fb, int x, int y, int w, int h, uint32 color) -> void {
    int end_y = (y+h)*5/3; y=y*5/3;
    int end_x = (x+w)*5/3; x=x*5/3;
    if (y<0) { y=0; } if (x<0) { x=0; }
    if (end_y>240) { end_y=240; } if (end_x>320) { end_x=320; }
    uint32 @pixels = window_framebuffer_get_address(fb);
    while (y<end_y) {
        int p=(239-y)*320+x;
        int end=(239-y)*320+end_x;
        while (p<end) { pixels[p]=color; p+=1; }
        y+=1;
    }
}

int world_draw_bottom=213;
fn span(framebuffer fb, int x, int y, int end, uint32 color) -> void {
    if (y<0) { y=0; } if (end>world_draw_bottom) { end=world_draw_bottom; }
    uint32 @pixels = window_framebuffer_get_address(fb);
    int at=(239-y)*320+x;
    while (y<end) {
        pixels[at]=color;
        if (scale_x>=2) { pixels[at+1]=color; }
        if (scale_x==4) { pixels[at+2]=color; pixels[at+3]=color; }
        at-=320; y+=1;
    }
}

int view_palette=0;
bool inverse_colormap=false;


fn update_view_palette() -> void {
    inverse_colormap=invulnerability_tics>128 || (invulnerability_tics&8)!=0;
    view_palette=0;
    int red=damage_count;
    if (berserk_tics>0 && 12-(berserk_tics>>6)>red) { red=12-(berserk_tics>>6); }
    if (red>0) {
        view_palette=1+((red+7)>>3);
        if (view_palette>8) { view_palette=8; }
    } else {
        if (bonus_count>0) {
            view_palette=9+((bonus_count+7)>>3);
            if (view_palette>12) { view_palette=12; }
        } else {
            int suit_tics=suit_time*35.0;
            if (suit_tics>128 || ((suit_tics&8)!=0 && suit_tics>0)) { view_palette=13; }
        }
    }
}

fn texel_color(int texel,int light) -> uint32 {
    if (texel==0) { return 0; }
    return file_read_uint32_at(data,152+((view_palette*33+light)*256+texel-1)*4);
}

fn light_index(int sector_light,int scale) -> int {
    if (inverse_colormap) { return 32; }
    if (light_time>0.0) { return 0; }
    if (scale<0) { scale=0; }
    if (scale>47) { scale=47; }
    int shade=(15-sector_light)*4-scale/2;
    if (shade<0) { shade=0; }
    if (shade>31) { shade=31; }
    return shade;
}

fn horizontal_offset(int line) -> int {
    int offset=signed_word(data,line+20);
    if ((file_read_uint8_at(data,line+19)&128)!=0) { offset+=level_tic; }
    return offset;
}

int animation_input=0;
fn animated_texture(int id) -> int {
    // StegVM 0.0.1 can overwrite the parameter during the table lookup.
    animation_input=id;
    if (animation_input<=0) { return animation_input; }
    if (level_tic==0) { return animation_input; }
    int at=animation_table+(animation_input-1)*4;
    int frames=file_read_uint8_at(data,at+2);
    if (frames==0) { return animation_input; }
    int phase=file_read_uint8_at(data,at+3);
    int frame=((level_tic-1)/8+phase)%frames;
    int first=file_read_little_uint16_at(data,at);
    return file_read_little_uint16_at(data,animation_ids+(first+frame)*2);
}

int paint_tex = 0;
int paint_line = 0;
int paint_anchor = 0;
float wall_depth = 0.0;
int paint_light = 0;
int wall_material=0;
int wall_material_w=0;
int wall_material_h=0;
int wall_material_base=0;
int wall_material_line=0;
int wall_line_length=0;
int wall_line_u=0;
int wall_line_v=0;

fn wall(framebuffer fb, int x, int top, int bottom) -> void {
    int tex=animated_texture(paint_tex);
    int line=paint_line;
    int anchor=paint_anchor;
    float d=wall_depth;
    if (top<0) { top=0; }
    if (bottom>world_draw_bottom) { bottom=world_draw_bottom; }
    if (top>=bottom) { return; }
    if (tex==0) { tex=1; }
    int m=texmeta+(tex-1)*8;
    int w=file_read_little_uint16_at(data,m);
    int h=file_read_little_uint16_at(data,m+2);
    float along=hit_u*file_read_little_uint16_at(data,line+8)+horizontal_offset(line);
    int tx=along; tx=tx%w; if (tx<0) { tx+=w; }
    int base=atlas+file_read_little_uint32_at(data,m+4)+tx*h*2;
    float step=d/193.3333;
    float origin=signed_word(data,line+22);
    float phase=(top-anchor)*step+origin;
    uint32 @pixels=window_framebuffer_get_address(fb);
    int y=top;
    int colors=152+(view_palette*33+paint_light)*1024-4;
    while (y<bottom) {
        int ty=phase;
        if (phase<0.0 && ty>phase) { ty-=1; }
        int sample=ty%h; if (sample<0) { sample+=h; }
        int texel=file_read_little_uint16_at(data,base+sample*2);
        uint32 color=336860415;
        if (texel!=0) { color=file_read_uint32_at(data,colors+texel*4); }
        int end=y+(ty+1.0-phase)/step;
        if (end<=y) { end=y+1; }
        if (end>bottom) { end=bottom; }
        int at=(239-y)*320+x;
        while (y<end) {
            pixels[at]=color;
            if (scale_x>=2) { pixels[at+1]=color; }
        if (scale_x==4) { pixels[at+2]=color; pixels[at+3]=color; }
            at-=320; y+=1;
        }
        phase=(y-anchor)*step+origin;
    }
}

fn prepare_wall_material() -> void {
    if (wall_material!=paint_tex) {
        wall_material=paint_tex;
        int tex=animated_texture(paint_tex);
        if (tex==0) { tex=1; }
        int m=texmeta+(tex-1)*8;
        wall_material_w=file_read_little_uint16_at(data,m);
        wall_material_h=file_read_little_uint16_at(data,m+2);
        wall_material_base=atlas+file_read_little_uint32_at(data,m+4);
    }
    if (wall_material_line!=paint_line) {
        wall_material_line=paint_line;
        wall_line_length=file_read_little_uint16_at(data,paint_line+8);
        wall_line_u=horizontal_offset(paint_line);
        wall_line_v=signed_word(data,paint_line+22);
    }
}

fn render_wall(framebuffer fb,void @span_job,int x,int top,int bottom) -> void {
    if (!fast_span) { wall(fb,x,top,bottom); return; }
    if (top<0) { top=0; }
    if (bottom>world_draw_bottom) { bottom=world_draw_bottom; }
    if (top>=bottom) { return; }
    if (wall_material!=paint_tex || wall_material_line!=paint_line) { prepare_wall_material(); }
    int w=wall_material_w;
    int h=wall_material_h;
    float along=hit_u*wall_line_length+wall_line_u;
    int tx=along; tx=tx%w; if (tx<0) { tx+=w; }
    uint32 @words=span_job;
    float @floats=span_job;
    words[0]=wall_material_base+tx*h*2;
    words[1]=152+(view_palette*33+paint_light)*1024-4;
    words[3]=h;
    words[4]=((239-top)*320+x)*4;
    words[6]=bottom-top;
    floats[8]=wall_line_v;
    floats[10]=wall_depth/193.3333;
    words[14]=top; words[15]=paint_anchor;
    raster_indexed_span(words,data,fb);
}

fn project(float z, float d) -> int { int row=horizon*1.6666667+(pz-z)*193.3333/d; return row; }

int clip_top = 0;
int clip_bottom = 0;
int active_sector = 0;
int next_sector = 0;
int camera_line = 0;
int render_floor=0;
int render_ceiling=0;
int render_light=0;
int render_sky=0;
int next_floor=0;
int next_ceiling=0;
int next_sky=0;
int start_floor=0;
int start_ceiling=0;
int start_sky=0;
float render_center=0.0;

fn read_portal_heights(int next) -> void {
    int at=sectors+next*24;
    uint32 heights=0;
    if (file_read_uint8_at(data,at+9)>0) {
        heights=file_read_little_uint32_at(sector_state,next*12);
    } else {
        heights=file_read_little_uint32_at(data,at);
    }
    next_floor=heights&65535;
    if (next_floor>=32768) { next_floor-=65536; }
    next_ceiling=heights>>16;
    if (next_ceiling>=32768) { next_ceiling-=65536; }
    next_sky=file_read_uint8_at(data,at+20);
}

int plane_texture=0;
int plane_height=0;
int plane_light=0;
int flat_colors=0;

fn plane_full(framebuffer fb,int x,int y,int last) -> void {
    int offset=file_read_little_uint32_at(data,flat_colors+(plane_texture-1)*4);
    if (offset==0) { return; }
    int base=atlas+offset-1;
    uint32 @pixels=window_framebuffer_get_address(fb);
    int pixel=(239-y)*320+x;
    float center=horizon*1.6666667;
    float factor=(pz-plane_height)*193.3333;
    int light=plane_light;
    if (light_time>0.0) { light=0; }
    while (y<last) {
        float denom=y-center;
        if (fabs(denom)<0.5) { denom=0.5; }
        float d=factor/denom;
        int tx=px+ray_vx*d;
        int ty=0.0-py-ray_vy*d;
        int z=fabs(d)/16.0;
        if (z>127) { z=127; }
        int shade=light-80/(z+1);
        if (shade<0) { shade=0; }
        if (shade>31) { shade=31; }
        int at=base+(shade*4096+(tx&63)*64+(ty&63))*4;
        pixels[pixel]=file_read_uint32_at(data,at);
        pixel-=320;
        y+=1;
    }
}
fn plane(framebuffer fb,void @plane_job,int x,int y,int last) -> void {
    if (y<0) { y=0; }
    if (last>world_draw_bottom) { last=world_draw_bottom; }
    if (plane_texture==0 || y>=last) { return; }
    if (fast_span && scale_x==1) {
        uint32 @words=plane_job;
        float @floats=plane_job;
        int meta=texmeta+(plane_texture-1)*8;
        words[0]=atlas+file_read_little_uint32_at(data,meta+4);
        words[4]=((239-y)*320+x)*4;
        words[6]=last-y;
        words[14]=y;
        floats[18]=(pz-plane_height)*193.3333;
        words[19]=plane_light;
        if (light_time>0.0) { words[19]=0; }
        raster_indexed_span(words,data,fb);
        return;
    }
    int meta=texmeta+(plane_texture-1)*8;
    int base=atlas+file_read_little_uint32_at(data,meta+4);
    uint32 @pixels=window_framebuffer_get_address(fb);
    int stride=scale_x;
    if (scale_x==4) { stride=3; }

    float center=horizon*1.6666667;
    float distance_factor=(pz-plane_height)*193.3333;
    int palette_base=152+view_palette*33*1024-4;
    while (y<last) {
        int tx=0;
        int ty=0;
float denom=y-center;
            if (fabs(denom)<0.5) { denom=0.5; }
            float d=distance_factor/denom;
            tx=px+ray_vx*d;
            ty=0.0-py-ray_vy*d;
            tx=tx&63; ty=ty&63;
        int z=fabs(d)/16.0;
        if (z>127) { z=127; }
        int shade=plane_light-80/(z+1);
        if (shade<0 || light_time>0.0) { shade=0; }
        if (shade>31) { shade=31; }
        int texel=file_read_little_uint16_at(data,base+(tx*64+ty)*2);
        uint32 color=file_read_uint32_at(data,palette_base+shade*1024+texel*4);
        int end=y+stride;
        if (end>last) { end=last; }
        int at=(239-y)*320+x;
        if (stride==1) { pixels[at]=color; y+=1; }
        else { while (y<end) {
            pixels[at]=color;
            if (scale_x>=2) { pixels[at+1]=color; }
            if (scale_x==4) { pixels[at+2]=color; pixels[at+3]=color; }
            y+=1; at-=320;
        } }
    }
}


fn draw_sky(framebuffer fb,int x,int y,int last) -> void {
    if (sky_w<1 || sky_h<1) { span(fb,x,y,last,1162697983); return; }
    if (y<0) { y=0; }
    if (last>world_draw_bottom) { last=world_draw_bottom; }
    float lateral=(x-160.0+scale_x*0.5)/200.0;
    int tx=(angle-fatan(lateral))*162.97466;
    tx=tx%sky_w;
    if (tx<0) { tx+=sky_w; }
    int column=sky_pixels+tx*sky_h*2;
    int colors=152+view_palette*33*1024-4;
    uint32 @pixels=window_framebuffer_get_address(fb);
    int at=(239-y)*320+x;
    while (y<last) {
        int ty=100.0+(y-horizon*1.6666667)*0.72;
        if (ty<0) { ty=0; }
        if (ty>=sky_h) { ty=sky_h-1; }
        int texel=file_read_little_uint16_at(data,column+ty*2);
        uint32 color=file_read_uint32_at(data,colors+texel*4);
        pixels[at]=color;
        if (scale_x>=2) { pixels[at+1]=color; }
        if (scale_x==4) { pixels[at+2]=color; pixels[at+3]=color; }
        at-=320; y+=1;
    }
}
fn draw_planes(framebuffer fb,void @plane_job,int x,int p,int hi,int lo) -> void {
    int layout=flat_index+active_sector*4;
    plane_light=(15-render_light)*4;
    if (hi>clip_top) {
        int end=fmin(clip_bottom,hi);
        if (render_sky>0) { draw_sky(fb,x,clip_top,end); }
        else {
            plane_texture=animated_texture(file_read_little_uint16_at(data,layout+2));
            plane_height=render_ceiling;
            if (plane_texture>0) { plane(fb,plane_job,x,clip_top,end); }
            else { span(fb,x,clip_top,end,file_read_uint32_at(data,p+16)); }
        }
    }
    if (lo<clip_bottom) {
        plane_texture=animated_texture(file_read_little_uint16_at(data,layout));
        plane_height=render_floor;

        int start=fmax(clip_top,lo);
        if (plane_texture>0) { plane(fb,plane_job,x,start,clip_bottom); }
        else { span(fb,x,start,clip_bottom,file_read_uint32_at(data,p+12)); }
    }
}


// Show the alternate texture after a successful switch activation.
fn line_texture(int line,int slot) -> int {
    if (file_read_uint8_at(data,line+18)!=slot) { return file_read_little_uint16_at(data,line+slot); }
    int id=file_read_little_uint16_at(data,line+24);
    if (id<=0 || file_read_uint8_at(used_actions,id-1)==0) { return file_read_little_uint16_at(data,line+slot); }
    if ((file_read_uint8_at(data,actions+(id-1)*16+3)&2)!=0) {
        int now=t_game*1000.0;
        int then=file_read_little_uint32_at(button_times,(id-1)*4);
        if (now-then>=1000) { return file_read_little_uint16_at(data,line+slot); }
    }
    return file_read_little_uint16_at(data,line+26);
}

fn texture_height(int id) -> int {
    if (id<=0) { return 0; }
    return file_read_little_uint16_at(data,texmeta+(id-1)*8+2);
}

fn draw_portal(framebuffer fb,void @span_job,int x,int hi,int lo) -> void {
    int line=camera_line; paint_line=line;
    int next=next_sector;
    bool same_sky=false;
    if (next>=0) { read_portal_heights(next); }
    if (next>=0 && render_sky>0 && next_sky>0) {
        same_sky=true;
        int sky_row=project(next_ceiling,wall_depth);
        if (sky_row<hi) { hi=sky_row; }
    }
    if (hi>clip_top) { clip_top=hi; }
    if (lo<clip_bottom) { clip_bottom=lo; }
    if (next<0 || next_ceiling<=next_floor) {
        int tex=line_texture(line,10);
        paint_anchor=hi;
        if (next>=0) {
            tex=line_texture(line,12);
            if (tex==0) { tex=line_texture(line,14); }
        } else {
            if ((file_read_uint8_at(data,line+19)&16)!=0) {
                paint_anchor=project(render_floor+texture_height(tex),wall_depth);
            }
        }
        paint_tex=tex; render_wall(fb,span_job,x,clip_top,clip_bottom);
        next_sector=-1; return;
    }
    int n_hi=project(next_ceiling,wall_depth);
    int n_lo=project(next_floor,wall_depth);
    if (n_hi>hi && !same_sky) {
        paint_tex=line_texture(line,12); paint_anchor=hi;
        if ((file_read_uint8_at(data,line+19)&8)==0 && paint_tex>0) {
            paint_anchor=project(next_ceiling+texture_height(paint_tex),wall_depth);
        }
        int end=n_hi; if (end>clip_bottom) { end=clip_bottom; }
        render_wall(fb,span_job,x,clip_top,end);
        clip_top=fmax(clip_top,n_hi);
    }
    if (n_lo<lo) {
        paint_tex=line_texture(line,14); paint_anchor=n_lo;
        if ((file_read_uint8_at(data,line+19)&16)!=0) { paint_anchor=hi; }
        int start=n_lo; if (start<clip_top) { start=clip_top; }
        render_wall(fb,span_job,x,start,clip_bottom);
        clip_bottom=fmin(clip_bottom,n_lo);
    }
}


// Per-ray masked strips: depth, visible top/bottom, original projected
// top/height, native height, lighting, and atlas column.
int mask_start=0;
fn record_mask() -> void {
    int line=camera_line;
    int tex=animated_texture(line_texture(line,10));
    if (tex==0) { return; }
    int m=texmeta+(tex-1)*8;
    int h=file_read_little_uint16_at(data,m+2);
    if (h<=0) { return; }
    int world_top=fmin(render_ceiling,next_ceiling);
    if ((file_read_uint8_at(data,line+19)&16)!=0) {
        world_top=fmax(render_floor,next_floor)+h;
    }
    world_top+=signed_word(data,line+22);
    int top=project(world_top,wall_depth);
    int bot=project(world_top-h,wall_depth);
    if (bot<=clip_top || top>=clip_bottom || bot<=top) { return; }
    if (top< -32000) { top=-32000; }
    if (bot>32000) { bot=32000; }
    int first=fmax(clip_top,top);
    int last=fmin(clip_bottom,bot);
    int w=file_read_little_uint16_at(data,m);
    if (w<=0) { return; }
    int col=hit_u*file_read_little_uint16_at(data,line+8)+horizontal_offset(line);
    col=col%w;
    if (col<0) { col+=w; }
    int offset=atlas+file_read_little_uint32_at(data,m+4)+col*h*2;
    file_append_little_uint16(wall_depth,mask_log);
    file_append_uint8(first,mask_log); file_append_uint8(last,mask_log);
    file_append_little_uint16(coordinate(top),mask_log);
    file_append_little_uint16(bot-top,mask_log);
    file_append_little_uint16(h,mask_log);
    file_append_little_uint16(paint_light,mask_log);
    file_append_little_uint32(offset,mask_log);
}

fn mask_texel(int at,int y) -> int {
    int row=y-signed_word(mask_log,at+4);
    int h=file_read_little_uint16_at(mask_log,at+8);
    row=row*h/file_read_little_uint16_at(mask_log,at+6);
    int offset=file_read_little_uint32_at(mask_log,at+12);
    return file_read_little_uint16_at(data,offset+row*2);
}

fn draw_masks(framebuffer fb,int x) -> void {
    uint32 @pixels=window_framebuffer_get_address(fb);
    int at=file_size(mask_log);
    while (at>mask_start) {
        at-=16;
        int y=file_read_uint8_at(mask_log,at+2);
        int end=file_read_uint8_at(mask_log,at+3);
        if (end>world_draw_bottom) { end=world_draw_bottom; }
        int light=file_read_little_uint16_at(mask_log,at+10);
        int colors=152+(view_palette*33+light)*1024-4;
        while (y<end) {
            int texel=mask_texel(at,y);
            if (texel!=0) {
                uint32 c=file_read_uint32_at(data,colors+texel*4);
                int p=(239-y)*320+x;
                pixels[p]=c;
                if (scale_x>=2) { pixels[p+1]=c; }
                if (scale_x==4) { pixels[p+2]=c; pixels[p+3]=c; }
            }
            y+=1;
        }
    }
}


fn discover_map_edge(int line) -> void {
    int map_line_id=file_read_little_uint16_at(data,map_edges+(line-edges)/28*2);
    if (map_line_id==0 || file_read_uint8_at(map_discovery,map_line_id-1)!=0) { return; }
    file_seek_cursor(map_line_id-1,map_discovery);
    file_write_uint8(1,map_discovery);
}

int render_roots=0; int render_branches=0; int render_ids=0;
file render_cache=0; file render_index=0;
bool render_bsp=true;
float left_nx=0.0; float left_ny=0.0;
float right_nx=0.0; float right_ny=0.0;
int render_cache_map=0;
float render_cache_x=0.0; float render_cache_y=0.0;
float render_cache_dx=0.0; float render_cache_dy=0.0;

fn render_bounds_visible(int at) -> bool {
    float l=signed_word(data,at)-px; float r=signed_word(data,at+2)-px;
    float b=signed_word(data,at+4)-py; float t=signed_word(data,at+6)-py;
    if (fmax(l*left_nx,r*left_nx)+fmax(b*left_ny,t*left_ny)< -8.0) { return false; }
    if (fmax(l*right_nx,r*right_nx)+fmax(b*right_ny,t*right_ny)< -8.0) { return false; }
    return true;
}

fn prepare_render_sector(int id) -> void {
    int start=file_size(render_cache);
    int node=file_read_little_uint32_at(data,render_roots+id*8);
    int end=file_read_little_uint32_at(data,render_roots+id*8+4);
    while (node<end) {
        int at=render_branches+node*20;
        if (render_bounds_visible(at)) {
            int i=file_read_little_uint32_at(data,at+12);
            int stop=i+file_read_little_uint32_at(data,at+16);
            while (i<stop) {
                int edge=edges+file_read_little_uint16_at(data,render_ids+i*2)*28;
                uint32 vector=file_read_little_uint32_at(data,edge+4);
                int ex=(vector&65535)-32768; int ey=(vector>>16)-32768;
                float det=dx*ey-dy*ex;
                float spread=fabs(dy*ey+dx*ex)*0.81;
                if (det-spread<0.01) { file_append_little_uint32(edge,render_cache); }
                i+=1;
            }
            node+=1;
        } else { node=file_read_little_uint32_at(data,at+8); }
    }
    file_seek_cursor(id*8,render_index);
    file_write_little_uint32(start,render_index);
    file_write_little_uint32(file_size(render_cache)+1,render_index);
}

fn render_crossing(int id,float after,float limit) -> float {
    if (!render_bsp || file_read_little_uint16_at(data,sectors+id*24+6)<16) {
        return crossing(id,after,limit);
    }
    int marker=file_read_little_uint32_at(render_index,id*8+4);
    if (marker==0) {
        prepare_render_sector(id);
        marker=file_read_little_uint32_at(render_index,id*8+4);
    }
    int cursor=file_read_little_uint32_at(render_index,id*8);
    edge_hit=-1;
    while (cursor<marker-1) {
        int edge=file_read_little_uint32_at(render_cache,cursor);
        uint32 vector=file_read_little_uint32_at(data,edge+4);
        int ex=(vector&65535)-32768; int ey=(vector>>16)-32768;
        float det=ray_vx*ey-ray_vy*ex;
        if (det< -0.001) {
            uint32 point=file_read_little_uint32_at(data,edge);
            int ix=(point&65535)-32768; int iy=(point>>16)-32768;
            float ax=ix-ray_x; float ay=iy-ray_y;
            float u=ax*ray_vy-ay*ray_vx;
            if (u>=det-0.001 && u<=0.001) {
                float t=(ax*ey-ay*ex)/det;
                if (t>after && (t<limit || (t==limit && edge_hit>=0 && edge<edge_hit))) {
                    limit=t; edge_hit=edge; hit_u=u/det;
                }
            }
        }
        cursor+=4;
    }
    return limit;
}

fn prepare_render_view() -> void {
    if (!render_bsp) { return; }
    if (render_cache_map==map_base && render_cache_x==px && render_cache_y==py
        && render_cache_dx==dx && render_cache_dy==dy) { return; }
    render_cache_map=map_base;
    render_cache_x=px; render_cache_y=py;
    render_cache_dx=dx; render_cache_dy=dy;
    file_clear_data(render_cache); file_reset_cursor(render_cache);
    file_clear_data(render_index); file_reset_cursor(render_index);
    int n=(edges-sectors)/24;
    while (n>0) {
        file_append_little_uint32(0,render_index);
        file_append_little_uint32(0,render_index);
        n-=1;
    }
    left_nx=0.81*dx+dy; left_ny=0.81*dy-dx;
    right_nx=0.81*dx-dy; right_ny=0.81*dy+dx;
}

fn prepare_column(void @ray_job,void @plane_job,int x) -> void {
    float lateral=(x-160.0+scale_x*0.5)/200.0;
    float rx=dx+dy*lateral;
    float ry=dy-dx*lateral;
    if (!fast_ray || !fast_span || scale_x!=1) { ray_setup(px,py,rx,ry); }
    if (fast_ray) {
        float @ray=ray_job;
        ray[6]=rx; ray[7]=ry;
    }
    if (fast_span && scale_x==1) {
        float @flat=plane_job;
        flat[9]=rx; flat[10]=0.0-ry;
    }
    active_sector=sector;
    render_floor=start_floor; render_ceiling=start_ceiling; render_sky=start_sky;
    clip_top=0; clip_bottom=213; wall_depth=-4.1;
}

fn render_column(framebuffer fb,void @ray_job,void @span_job,void @plane_job,int x) -> int {
    prepare_column(ray_job,plane_job,x);
    int visits=0;
    while (clip_top<clip_bottom && visits<16) {
        int p=sectors+active_sector*24;
        render_light=sector_light_level(active_sector)>>4;
        if (fast_ray) { wall_depth=native_crossing(ray_job,active_sector,wall_depth+0.04); }
        else { wall_depth=render_crossing(active_sector,wall_depth+0.04,2400.0); }
        if (edge_hit<0) {
            int middle=render_center; draw_planes(fb,plane_job,x,p,middle,middle);
            return 2400;
        }
        camera_line=edge_hit;
        discover_map_edge(camera_line);
        next_sector=file_read_little_uint16_at(data,camera_line+16)-1;
        if (next_sector>=(edges-sectors)/24) { next_sector=-1; }
        if (wall_depth<2.0) { wall_depth=2.0; }
        int hi=project(render_ceiling,wall_depth);
        int lo=project(render_floor,wall_depth);
        draw_planes(fb,plane_job,x,p,hi,lo);
        int light=render_light;
        if (file_read_little_uint16_at(data,camera_line+6)==32768 && light>0) { light-=1; }
        if (file_read_little_uint16_at(data,camera_line+4)==32768 && light<15) { light+=1; }
        int scale=2560.0/wall_depth;
        paint_light=light_index(light,scale);
        draw_portal(fb,span_job,x,hi,lo);
        if (next_sector>=0 && clip_top<clip_bottom) { record_mask(); }
        active_sector=next_sector;
        if (active_sector<0 || clip_top>=clip_bottom) { int result=wall_depth; return result; }
        render_floor=next_floor; render_ceiling=next_ceiling; render_sky=next_sky;
        file_append_little_uint16(wall_depth,portal_log);
        file_append_uint8(clip_top,portal_log);
        file_append_uint8(clip_bottom,portal_log);
        visits+=1;
    }
    span(fb,x,clip_top,clip_bottom,454761471);
    return 2400;
}

fn render_world(framebuffer fb) -> void {
    update_view_palette();
    wall_material=-1; wall_material_line=-1;
    read_portal_heights(sector);
    start_floor=next_floor; start_ceiling=next_ceiling; start_sky=next_sky;
    render_center=horizon*1.6666667;
    void @ray_job=aloc(52);
    void @span_job=aloc(68);
    void @plane_job=aloc(80);
    if (fast_ray) {
        uint32 @ray_words=ray_job;
        float @ray_floats=ray_job;
        ray_words[2]=28; ray_words[3]=1;
        ray_floats[4]=px; ray_floats[5]=py;
        ray_floats[9]=2400.0; ray_floats[10]=0.001;
    }
    if (fast_span) {
        uint32 @span_words=span_job;
        span_words[2]=1;
        span_words[5]=4294966016; // Signed stride of -320 RGBA pixels.
        span_words[11]=3;
        span_words[12]=336860415;
        span_words[13]=scale_x;
    }
    if (fast_span && scale_x==1) {
        uint32 @flat_words=plane_job;
        float @flat_floats=plane_job;
        flat_words[1]=152+view_palette*33*1024-4;
        flat_words[2]=64; flat_words[3]=64;
        flat_words[5]=4294966016;
        flat_floats[7]=px; flat_floats[8]=0.0-py;
        flat_words[11]=9;
        flat_words[13]=1;
        flat_floats[17]=render_center;
    }

    if (!fast_ray) { prepare_render_view(); }
    file_clear_data(depth);
    file_reset_cursor(depth);
    file_clear_data(portal_index); file_reset_cursor(portal_index);
    file_clear_data(portal_log); file_reset_cursor(portal_log);
    file_clear_data(mask_log); file_reset_cursor(mask_log);
    file_clear_data(mask_index); file_reset_cursor(mask_index);
    int x=0;
    while (x<320) {
        file_append_little_uint16(file_size(portal_log),portal_index);
        mask_start=file_size(mask_log); file_append_little_uint32(mask_start,mask_index);
        int d=render_column(fb,ray_job,span_job,plane_job,x);
        if (file_size(mask_log)>mask_start) { draw_masks(fb,x); }
        file_append_little_uint16(d,depth);
        if (scale_x>=2) { file_append_little_uint16(d,depth); }
        if (scale_x==4) { file_append_little_uint16(d,depth); file_append_little_uint16(d,depth); }
        x+=scale_x;
    }
    file_append_little_uint16(file_size(portal_log),portal_index);
    file_append_little_uint32(file_size(mask_log),mask_index);
    free(plane_job); free(span_job); free(ray_job);
}

int blit_w = 0;
int blit_h = 0;
float blit_d = 0.0;


int sprite_y0=0;
int sprite_y1=0;

// Each ray remembers the visible vertical aperture after each portal.
fn clip_sprite(int x,int top,int bottom) -> void {
    sprite_y0=top; sprite_y1=bottom;
    if (blit_d<=0.0) { return; }
    if (file_read_little_uint16_at(depth,x*2)<=blit_d) { sprite_y1=top; return; }
    int ray_id=x/scale_x;
    int at=file_read_little_uint16_at(portal_index,ray_id*2);
    int end=file_read_little_uint16_at(portal_index,ray_id*2+2);
    while (at<end && sprite_y0<sprite_y1) {
        if (file_read_little_uint16_at(portal_log,at)>=blit_d) { return; }
        int hi=file_read_uint8_at(portal_log,at+2);
        int lo=file_read_uint8_at(portal_log,at+3);
        if (hi>sprite_y0) { sprite_y0=hi; }
        if (lo<sprite_y1) { sprite_y1=lo; }
        at+=4;
    }
}

int sprite_mask_at=0;
int sprite_mask_end=0;

fn sprite_mask_column(int x) -> void {
    sprite_mask_at=0; sprite_mask_end=0;
    if (blit_d<=0.0 || file_size(mask_log)==0) { return; }
    int ray=x/scale_x;
    sprite_mask_at=file_read_little_uint32_at(mask_index,ray*4);
    sprite_mask_end=file_read_little_uint32_at(mask_index,ray*4+4);
}

fn behind_mask(int y) -> bool {
    int at=sprite_mask_at;
    while (at<sprite_mask_end) {
        if (file_read_little_uint16_at(mask_log,at)>=blit_d) { return false; }
        if (y>=file_read_uint8_at(mask_log,at+2) && y<file_read_uint8_at(mask_log,at+3) && mask_texel(at,y)!=0) { return true; }
        at+=16;
    }
    return false;
}


int sprite_light=0;

fn blit(framebuffer fb, int tex, int left, int top) -> void {
    int width=blit_w;
    int height=blit_h;
    if (tex==0 || width<1 || height<1) { return; }
    int first=fmax(0,left);
    int end=fmin(320,left+width);
    int y0=fmax(0,top);
    int y1=fmin(201,top+height);
    uint32 @pixels=window_framebuffer_get_address(fb);
    int meta=texmeta+(tex-1)*8;
    int source_w=file_read_little_uint16_at(data,meta);
    int source_h=file_read_little_uint16_at(data,meta+2);
    int offset=atlas+file_read_little_uint32_at(data,meta+4);
    int colors=152+view_palette*33*1024-4;
    if (inverse_colormap) { colors+=32768; }
    else { if (blit_d>0.0) { colors+=sprite_light*1024; } }
    int x=first;
    while (x<end) {
        clip_sprite(x,y0,y1);
        if (sprite_y0<sprite_y1) {
            sprite_mask_column(x);
            int tx=(x-left)*source_w/width;
            int col=offset+tx*source_h*2;
            int y=sprite_y0;
            while (y<sprite_y1) {
                int ty=(y-top)*source_h/height;
                int texel=file_read_little_uint16_at(data,col+ty*2);
                if (texel!=0 && !behind_mask(y)) {
                    uint32 c=file_read_uint32_at(data,colors+texel*4);
                    pixels[(239-y)*320+x]=c;
                }
                y+=1;
            }
        }
        x+=1;
    }
}

fn blit_fuzz(framebuffer fb,int tex,int left,int top) -> void {
    if (blit_w<1 || blit_h<1) { return; }
    int x=fmax(0,left); int end=fmin(320,left+blit_w);
    uint32 @pixels=window_framebuffer_get_address(fb);
    int meta=texmeta+(tex-1)*8;
    int width=file_read_little_uint16_at(data,meta);
    int height=file_read_little_uint16_at(data,meta+2);
    int offset=atlas+file_read_little_uint32_at(data,meta+4);
    while (x<end) {
        clip_sprite(x,fmax(1,top),fmin(200,top+blit_h));
        if (sprite_y0<sprite_y1) {
            sprite_mask_column(x);
            int column=offset+(x-left)*width/blit_w*height*2;
            int y=sprite_y0;
            while (y<sprite_y1) {
                int texel=file_read_little_uint16_at(data,column+(y-top)*height/blit_h*2);
                if (texel!=0 && !behind_mask(y)) {
                    uint32 c=pixels[(240-y-2*(fuzz_position&1))*320+x];
                    pixels[(239-y)*320+x]=c-((c>>2)&1061109504);
                    fuzz_position=(fuzz_position+1)&65535;
                }
                y+=1;
            }
        }
        x+=1;
    }
}

fn pinky_frame(int at,int life) -> int {
    int timer=file_read_little_uint16_at(things,at+10);
    if (life==0) {
        if (timer<229) { return 7; }
        if (timer<457) { return 8; }
        if (timer<572) { return 9; }
        if (timer<686) { return 10; }
        if (timer<800) { return 11; }
        return 12;
    }
    if (timer>457) { return 4; }
    if (timer>229) { return 5; }
    if (timer>0) { return 6; }
    if ((file_read_uint8_at(things,at+9)&8)==0) { return 0; }
    int phase=t_game*8.75;
    return phase%4;
}

fn hostile_actor_tex(int at,int life) -> int {
    int type=actor_type(at);
    int species=-1;
    if (type==3003) { species=0; }
    if (type==3005) { species=1; }
    if (type==3006) { species=2; }
    if (type==16) { species=3; }
    if (type==7) { species=4; }
    if (species<0) { return 0; }
    int timer=file_read_little_uint16_at(things,at+10);
    int frame=(level_tic/6)%2;
    if (file_read_uint8_at(monster_state,at+2)==0) { frame=0; }
    if (timer>20000) {
        frame=2;
        if (timer<=20228) { frame=3; }
        if (type==16 && ((timer>21371 && timer<=21714) || (timer>20686 && timer<=21029) || timer<=20343)) { frame=3; }
    }
    if (type==3006 && file_read_uint8_at(monster_state,at+3)!=0) { frame=3; }
    if (life==0) {
        if (type==3006 && timer>1028) { return 0; }
        frame=4;
        if (timer>228) { frame=5; }
    }
    return file_read_little_uint16_at(data,hostile_frames+(15+species*6+frame)*2);
}

fn oriented_sprite(int at,int tex,float x,float y) -> int {
    int phase=(bearing(x,y)-file_read_little_uint16_at(monster_state,at)+562.5)/45.0;
    int entry=file_read_little_uint16_at(data,sprite_rotations+(tex-1)*16+(phase&7)*2);
    if (entry==0) { return tex; }
    return entry;
}

fn render_thing(framebuffer fb, int at) -> void {
    int life=file_read_uint8_at(things,at+7);
    int kind=file_read_uint8_at(things,at+6);
    if (life==0 && kind>4 && kind!=5) { return; }
    float x=signed_word(things,at)-px;
    float y=signed_word(things,at+2)-py;
    float forward=x*dx+y*dy;
    if (forward<11.0 || forward>=840.0) { return; }

    float side=x*dy-y*dx;
    if (fabs(side)>=forward*0.90+30.0) { return; }
    int s=sector_at(x+px,y+py);
    if (s<0) { return; }
    int tex=file_read_little_uint16_at(things,at+4);
    if (kind==1 && (file_read_uint8_at(things,at+9)&32)==0) {
        int selected=hostile_actor_tex(at,life);
        if (selected!=0) { tex=selected; }
        if (life==0 && actor_type(at)==3006 && selected==0) { return; }
    }
    if (kind==36) {
        int frame=(level_tic/6)%4;
        if (frame>0) {
            int next=file_read_little_uint16_at(data,extra_frames+204+(frame-1)*2);
            if (next!=0) { tex=next; }
        }
    }
    if ((file_read_uint8_at(things,at+9)&32)!=0) {
        int frame=pinky_frame(at,life);
        int selected=file_read_little_uint16_at(data,extra_frames+frame*2);
        if (selected!=0) { tex=selected; }
    }
    if (kind==5) {
        int timer=file_read_little_uint16_at(things,at+10);
        if (life==0) {
            if (timer==0) { return; }
            int frame=(600-timer)/120;
            if (frame<0) { frame=0; }
            if (frame>4) { frame=4; }
            tex=file_read_little_uint16_at(data,barrel_frames+2+frame*2);
        } else {
            int phase=t_game*5.0;
            if (phase%2!=0) {
                int other=file_read_little_uint16_at(data,barrel_frames);
                if (other!=0) { tex=other; }
            }
        }
    }
    if (kind>=2 && kind<=4) {
        int frame=t_game*5.0;
        frame=frame%2;
        if (file_read_little_uint16_at(things,at+10)>1420) { frame=2; }
        if (life==0) { frame=3; }
        int selected=file_read_little_uint16_at(data,enemy_frames+(kind-2)*8+frame*2);
        if (selected!=0) { tex=selected; }
    }
    if (tex==0) { return; }
    if (kind<=4 && life>0) { tex=oriented_sprite(at,tex,x,y); }
    int m=texmeta+(tex-1)*8;
    int w=file_read_little_uint16_at(data,m);
    int h=file_read_little_uint16_at(data,m+2);
    blit_h=193.3333*h/forward;
    blit_w=200.0*w/forward;
    blit_d=forward;
    int offset=sprite_offsets+(tex-1)*4;
    int base_z=floor_of(s);
    if ((actor_flags(at)&12)!=0) { base_z=enemy_base_z(at,s); }
    int patch_top=signed_word(data,offset+2);
    int sprite_top=base_z+patch_top;
    int top=project(sprite_top,forward);
    int left=160.0+(side-signed_word(data,offset))*200.0/forward;
    int light=sector_light_level(s)>>4;
    int scale=2560.0/forward;
    sprite_light=light_index(light,scale);
    if (actor_type(at)==58) { blit_fuzz(fb,tex,left,top); }
    else { blit(fb,tex,left,top); }
}


fn queue_sprite(int at, int distance) -> void {
    int slot=file_size(sprite_queue);
    file_append_little_uint16(at,sprite_queue);
    file_append_little_uint16(distance,sprite_queue);
    while (slot>0) {
        int previous=file_read_little_uint16_at(sprite_queue,slot-2);
        if (previous>=distance) { break; }
        int actor=file_read_little_uint16_at(sprite_queue,slot-4);
        file_seek_cursor(slot,sprite_queue);
        file_write_little_uint16(actor,sprite_queue);
        file_write_little_uint16(previous,sprite_queue);
        slot-=4;
    }
    file_seek_cursor(slot,sprite_queue);
    file_write_little_uint16(at,sprite_queue);
    file_write_little_uint16(distance,sprite_queue);
}


fn render_imp_shot(framebuffer fb,int at) -> void {
    float x=imp_coord(at)-px; float y=imp_coord(at+4)-py;
    float forward=x*dx+y*dy;
    if (forward<11.0 || forward>=1200.0) { return; }
    int time=file_read_little_uint16_at(imp_shots,at+18);
    int frame=((4500-time)/114)%2;
    bool impact=file_read_uint8_at(imp_shots,at+20)==1;
    if (impact) {
        frame=2+(515-time)/172;
        if (frame>4) { frame=4; }
    }
    int tex=file_read_little_uint16_at(data,imp_frames+frame*2);
    int family=file_read_uint8_at(imp_shots,at+21);
    if (family==1) {
        frame=0;
        if (impact) {
            frame=1;
            if (time<=280) { frame=2; }
            if (time<=112) { frame=3; }
        }
        tex=file_read_little_uint16_at(data,extra_frames+62+frame*2);
    }
    if (family==2) {
        frame=((4500-time)/168)%2;
        if (impact) { frame=2+(560-time)/112; }
        tex=file_read_little_uint16_at(data,extra_frames+174+frame*2);
    }
    if (family==3) {
        frame=7+((4500-time)/112)%2;
        if (impact) { frame=9+(1344-time)/224; }
        tex=file_read_little_uint16_at(data,extra_frames+174+frame*2);
    }
    if (family==4) {
        frame=(896-time)/224;
        tex=file_read_little_uint16_at(data,extra_frames+210+frame*2);
    }
    if (tex==0) { return; }
    int meta=texmeta+(tex-1)*8;
    int w=file_read_little_uint16_at(data,meta);
    int h=file_read_little_uint16_at(data,meta+2);
    blit_w=193.3333*w/forward;
    blit_h=193.3333*h/forward;
    blit_d=forward;
    int x0=160.0+(x*dy-y*dx)*200.0/forward-blit_w/2;
    int y0=project(imp_coord(at+8)+4.0,forward)-blit_h/2;
    sprite_light=0;
    blit(fb,tex,x0,y0);
}

fn queue_imp_shots() -> void {
    int at=0;
    int end=file_size(imp_shots);
    while (at<end) {
        if (file_read_little_uint16_at(imp_shots,at+18)>0) {
            float x=imp_coord(at)-px; float y=imp_coord(at+4)-py;
            float d=x*dx+y*dy;
            if (d>=11.0 && d<1200.0 && fabs(x*dy-y*dx)<d*0.90+30.0) {
                queue_sprite(64000+at,d);
            }
        }
        at+=22;
    }
}

fn render_hostile(framebuffer fb,int at) -> void {
    float x=hostile_coord(at)-px; float y=hostile_coord(at+4)-py;
    float forward=x*dx+y*dy;
    if (forward<11.0 || forward>=1200.0) { return; }
    int time=file_read_little_uint16_at(hostile_shots,at+18);
    int kind=file_read_uint8_at(hostile_shots,at+21);
    int frame=((4500-time)/114)%2;
    if (file_read_uint8_at(hostile_shots,at+20)!=0) {
        frame=2+(515-time)/172;
        if (frame>4) { frame=4; }
    }
    int tex=file_read_little_uint16_at(data,hostile_frames+((kind-1)*5+frame)*2);
    if (tex==0) { return; }
    int meta=texmeta+(tex-1)*8;
    blit_w=193.3333*file_read_little_uint16_at(data,meta)/forward;
    blit_h=193.3333*file_read_little_uint16_at(data,meta+2)/forward;
    blit_d=forward;
    int left=160.0+(x*dy-y*dx)*200.0/forward-blit_w/2;
    int top=project(hostile_coord(at+8)+4.0,forward)-blit_h/2;
    sprite_light=0;
    blit(fb,tex,left,top);
}

fn queue_hostile_shots() -> void {
    int at=0;
    while (at<file_size(hostile_shots)) {
        if (file_read_little_uint16_at(hostile_shots,at+18)>0) {
            float x=hostile_coord(at)-px; float y=hostile_coord(at+4)-py;
            float d=x*dx+y*dy;
            if (d>=11.0 && d<1200.0 && fabs(x*dy-y*dx)<d*0.90+30.0) { queue_sprite(62000+at,d); }
        }
        at+=24;
    }
}

fn render_things(framebuffer fb) -> void {
    file_clear_data(sprite_queue);
    file_reset_cursor(sprite_queue);
    int at=0;
    while (at<count*12) {
        int life=file_read_uint8_at(things,at+7);
        int kind=file_read_uint8_at(things,at+6);
        if (life>0 || kind<=4 || (kind==5 && file_read_little_uint16_at(things,at+10)>0)) {
            float x=signed_word(things,at)-px;
            float y=signed_word(things,at+2)-py;
            float d=x*dx+y*dy;
            if (d>=11.0 && d<840.0 && fabs(x*dy-y*dx)<d*0.90+30.0) {
                queue_sprite(at,d);
            }
        }
        at+=12;
    }
    int slot=0;
    queue_imp_shots();
    queue_hostile_shots();
    while (slot<file_size(sprite_queue)) {
        int actor=file_read_little_uint16_at(sprite_queue,slot);
        if (actor>=64000) { render_imp_shot(fb,actor-64000); }
        else { if (actor>=62000) { render_hostile(fb,actor-62000); } else { render_thing(fb,actor); } }
        slot+=4;
    }
}
fn glyph(framebuffer fb, int x, int y, int ch, uint32 color) -> void {
    if (ch<=32 || ch>126) { return; }
    int row=0;
    while (row<7) {
        int bits=file_read_uint8_at(font_data,(ch-32)*7+row);
        int col=0;
        while (col<5) {
            if ((bits&(16>>col))!=0) { rect(fb,x+col,y+row,1,1,color); }
            col+=1;
        }
        row+=1;
    }
}

fn text(framebuffer fb, int x, int y, int id, uint32 color) -> void {
    int n=0;
    int ch=file_read_uint8_at(hud_text,id*32);
    while (n<31 && ch!=0) {
        glyph(fb,x+6*n,y,ch,color);
        n+=1;
        ch=file_read_uint8_at(hud_text,id*32+n);
    }
}

fn number(framebuffer fb,int x,int y,int n,uint32 color) -> void {
    n=fmax(0,fmin(999,n));
    glyph(fb,x,y,48+n/100,color);
    glyph(fb,x+6,y,48+(n/10)%10,color);
    glyph(fb,x+12,y,48+n%10,color);
}


fn map_line(framebuffer fb,int x,int y,int x1,int y1) -> void {
    uint32 @pixels=window_framebuffer_get_address(fb);
    x=x*5/3; y=y*5/3; x1=x1*5/3; y1=y1*5/3;
    int dx0=x1-x; if (dx0<0) { dx0=-dx0; }
    int dy0=y1-y; if (dy0>0) { dy0=-dy0; }
    int sx=1; int sy=1;
    if (x>x1) { sx=-1; } if (y>y1) { sy=-1; }
    int error=dx0+dy0;
    int limit=0;
    while (limit<320) {
        if (x>=0 && x<320 && y>=0 && y<201) { pixels[(239-y)*320+x]=map_ink; }
        if (x==x1 && y==y1) { return; }
        int next=2*error;
        if (next>=dy0) { error+=dy0; x+=sx; }
        if (next<=dx0) { error+=dx0; y+=sy; }
        limit+=1;
    }
}

fn map_x(int world) -> int {
    return 7+(world-origin_x)*178/(grid_w*8);
}

fn map_y(int world) -> int {
    return 115-(world-origin_y)*110/(grid_h*8);
}

fn render_map(framebuffer fb) -> void {
    uint32 background=texel_color(1,0);
    rect(fb,0,0,192,121,background);
    int offset=map_index;
    int i=0;
    while (i<map_count) {
        bool discovered=file_read_uint8_at(map_discovery,i)!=0;
        if (discovered || computer_map) {
            int x=map_x(signed_word(data,offset));
            int y=map_y(signed_word(data,offset+2));
            int x1=map_x(signed_word(data,offset+4));
            int y1=map_y(signed_word(data,offset+6));
            int ink=file_read_uint8_at(data,offset+8);
            int map_color=177;
            if (ink==2) { map_color=65; }
            if (ink==3) { map_color=232; }
            if (!discovered) { map_color=100; }
            map_ink=texel_color(map_color,0);
            map_line(fb,x,y,x1,y1);
        }
        i+=1; offset+=10;
    }
    int mx=map_x(px);
    int my=map_y(py);
    int front_x=mx+dx*6.0;
    int front_y=my-dy*6.0;
    map_ink=texel_color(210,0);
    map_line(fb,mx-dx*4.0,my+dy*4.0,front_x,front_y);
    map_line(fb,front_x,front_y,mx+dy*3.0,my+dx*3.0);
    map_line(fb,front_x,front_y,mx-dy*3.0,my-dx*3.0);
}
int menu = 0;
int main_choice=0;
int episode_choice=1;
int map_choice=1;
bool quit=false;
int skill = 2;

bool live = false;
float menu_time = 0.0;
float intermission_time=0.0;
float finale_time=0.0;
bool finale_picture=false;
int bunny_frame=0;
int save_choice=0;
int save_return_menu=0;
file save_slot_info=0;

int save_notice=0;
float save_notice_until=0.0;




// UI patches preserve their original WAD palette and proportions.

fn ui_patch_at(framebuffer fb,int id,int left,int top) -> void {
    int meta=ui_index+id*8;
    int offset=ui_pixels+file_read_little_uint32_at(data,meta);
    int w=file_read_little_uint16_at(data,meta+4);
    int h=file_read_little_uint16_at(data,meta+6);
    int end_x=left+w; int end_y=top+(h*6+4)/5;
    int colors=152+view_palette*33*1024-4;
    uint32 @pixels=window_framebuffer_get_address(fb);
    int row=top;
    while (row<end_y && row<240) {
        int source_y=(row-top)*h/(end_y-top);
        int col=left;
        while (col<end_x && col<320) {
            int source_x=col-left;
            int texel=file_read_little_uint16_at(data,offset+(source_y*w+source_x)*2);
            if (texel!=0 && col>=0 && row>=0) {
                uint32 color=file_read_uint32_at(data,colors+texel*4);
                pixels[(239-row)*320+col]=color;
            }
            col+=1;
        }
        row+=1;
    }
}
fn ui_patch(framebuffer fb,int id,int x,int y) -> void {
    ui_patch_at(fb,id,x*5/3,y*5/3);
}

int digit_set = 4;
fn doom_number(framebuffer fb,int right,int y,int value) -> void {
    right=right*5/3; y=y*5/3;
    int spacing=14;
    if (digit_set==14) { spacing=4; }
    if (digit_set==69) { spacing=11; }
    int i=0;
    while (i<3) {
        right-=spacing;
        ui_patch_at(fb,digit_set+value%10,right,y);
        value=value/10;
        if (value==0) { return; }
        i+=1;
    }
}

bool status_cache_enabled=false;
bool status_cache_valid=false;
bool status_opaque=false;
int status_map=0;
int status_health=0; int status_ammo=0; int status_state=0; int status_flags=0;

fn check_status_background() -> void {
    status_opaque=false;
    status_cache_valid=false;
    int p=ui_index+8;
    if (file_read_little_uint16_at(data,p+4)!=320 || file_read_little_uint16_at(data,p+6)!=32) { return; }
    int texels=ui_pixels+file_read_little_uint32_at(data,p);
    int i=0;
    while (i<20480) {
        if (file_read_little_uint16_at(data,texels+i)==0) { return; }
        i+=2;
    }
    status_opaque=true;
}

fn status_needs_draw(int face) -> bool {
    if (!status_cache_enabled) { status_cache_valid=false; return true; }
    int health=hp+armor*256+ammo*65536;
    int reserve=shells+rockets*256+cells*65536;
    int state=face+view_palette*256+keys*4096+extra_weapon*32768;
    int flags=0;
    if (shotgun) { flags=flags|1; }
    if (backpack) { flags=flags|2; }
    if (has_shotgun) { flags=flags|4; }
    if (has_chaingun) { flags=flags|8; }
    if (has_launcher) { flags=flags|16; }
    if (has_plasma) { flags=flags|32; }
    if (has_bfg) { flags=flags|64; }
    if (status_cache_valid && status_map==map_base && status_health==health &&
        status_ammo==reserve && status_state==state && status_flags==flags) { return false; }
    status_cache_valid=true; status_map=map_base;
    status_health=health; status_ammo=reserve; status_state=state; status_flags=flags;
    return true;
}

fn status_face() -> int {
    int phase=menu_time*2.5;
    int pain=(100-hp)*5/101;
    if (pain<0) { pain=0; }
    if (hp==0) { return 49; }
    if (invulnerability_tics>0) { return 143; }
    if (flash>0.0) { return 28+pain*5; }
    if (hurt>0.0) { return 27+pain*5; }
    return 24+pain*5+phase%3;
}

fn doom_status(framebuffer fb) -> void {
    int face=status_face();
    if (!status_needs_draw(face)) { return; }
    ui_patch(fb,1,0,121);
    ui_patch(fb,2,62,121);
    digit_set=4;
    int rounds=ammo;
    if (shotgun) { rounds=shells; }
    if (extra_weapon==3) { rounds=rockets; }
    if (extra_weapon>=4) { rounds=cells; }
    if (extra_weapon==0 || extra_weapon>=3) { doom_number(fb,26,123,rounds); }
    doom_number(fb,54,123,hp);
    ui_patch(fb,3,54,123);
    doom_number(fb,132,123,armor);
    ui_patch(fb,3,132,123);
    ui_patch(fb,face,89,122);

    digit_set=14;
    doom_number(fb,173,124,ammo);
    doom_number(fb,173,128,shells);
    doom_number(fb,173,132,rockets);
    doom_number(fb,173,136,cells);
    int max_bullets=200; int max_shells=50;
    if (backpack) { max_bullets=400; max_shells=100; }
    doom_number(fb,188,124,max_bullets);
    doom_number(fb,188,128,max_shells);
    doom_number(fb,188,132,rocket_capacity());
    doom_number(fb,188,136,cell_capacity());
    ui_patch(fb,86,67,125);
    if (has_shotgun) { ui_patch(fb,17,74,125); }
    else { ui_patch(fb,87,74,125); }
    if (has_chaingun) { ui_patch(fb,18,81,125); }
    else { ui_patch(fb,88,81,125); }
    if (has_launcher) { ui_patch(fb,19,67,134); }
    else { ui_patch(fb,89,67,134); }
    if (has_plasma) { ui_patch(fb,20,74,134); }
    else { ui_patch(fb,90,74,134); }
    if (has_bfg) { ui_patch(fb,21,81,134); }
    else { ui_patch(fb,91,81,134); }
    if ((keys&1)!=0) { ui_patch(fb,140,143,123); }
    if ((keys&2)!=0) { ui_patch(fb,141,143,129); }
    if ((keys&4)!=0) { ui_patch(fb,142,143,135); }
}

fn save_label(framebuffer fb,int x,int y,uint8 @label) -> void {
    int at=0;
    while (label[at]!=0) {
        glyph(fb,x+at*6,y,label[at],4292317695);
        at+=1;
    }
}

fn draw_save_menu(framebuffer fb,int skull) -> void {
    rect(fb,18,14,156,103,303042303);
    if (menu==9) { ui_patch(fb,53,58,18); }
    else { ui_patch(fb,54,58,18); }
    int slot=0;
    while (slot<6) {
        int y=33+slot*13;
        rect(fb,39,y,119,11,892612607);
        rect(fb,40,y+1,117,9,336992255);
        glyph(fb,43,y+2,49+slot,4292317695);
        int e=file_read_uint8_at(save_slot_info,slot*2);
        if (e==0) { save_label(fb,55,y+2,"VIDE"); }
        else {
            int m=file_read_uint8_at(save_slot_info,slot*2+1);
            glyph(fb,55,y+2,69,4292317695);
            glyph(fb,61,y+2,48+e,4292317695);
            glyph(fb,67,y+2,77,4292317695);
            glyph(fb,73,y+2,48+m,4292317695);
        }
        slot+=1;
    }
    ui_patch(fb,skull,21,31+save_choice*13);
}

fn draw_save_notice(framebuffer fb) -> void {
    if (save_notice==0 || menu_time>=save_notice_until) { return; }
    rect(fb,17,106,158,12,303042303);
    if (save_notice==1) { save_label(fb,22,108,"PARTIE SAUVEGARDEE"); }
    if (save_notice==2) { save_label(fb,22,108,"AUCUNE PARTIE VALIDE"); }
    if (save_notice==3) { save_label(fb,22,108,"AUCUNE PARTIE EN COURS"); }
    if (save_notice==4) { save_label(fb,22,108,"SAUVEGARDE IMPOSSIBLE"); }
}

fn options_slider(framebuffer fb,int y,bool volume,int value,int maximum) -> void {
    uint8 @label="SENSIBILITE SOURIS";
    if (volume) { label="VOLUME"; }
    int i=0;
    while (label[i]!=0) {
        glyph(fb,42+i*6,y,label[i],4292317695);
        i+=1;
    }
    rect(fb,42,y+10,88,4,892612607);
    rect(fb,42,y+10,value*88/maximum,4,2223322623);
    number(fb,143,y+7,value,4292317695);
}

file wad_map_list=0;
file wad_colors=0;
int compiled_episode=0; int compiled_mission=0;

fn available(int e,int n) -> bool {
    if (e<1 || e>4 || n<1 || n>9) { return false; }
    return file_read_uint8_at(wad_map_list,(e-1)*9+n-1)!=0;
}

// Use DOOM's native M_ENDGAM artwork with the same scale as the other buttons.
fn draw_return_menu_label(framebuffer fb) -> void {
    int width=file_read_little_uint16_at(return_menu_patch,0);
    int height=file_read_little_uint16_at(return_menu_patch,2);
    int rows=(height*6+4)/5;
    uint32 @pixels=window_framebuffer_get_address(fb);
    int row=0;
    while (row<rows) {
        int source_y=row*height/rows;
        int col=0;
        while (col<width) {
            int texel=file_read_little_uint16_at(return_menu_patch,4+(col*height+source_y)*2);
            if (texel!=0) { pixels[(239-168-row)*320+96+col]=texel_color(texel,0); }
            col+=1;
        }
        row+=1;
    }
}

fn return_to_main_menu() -> void {
    live=false; won=false; map_open=false;
    menu=0; main_choice=0; save_notice=0;
    tic_clock=0.0; clear_tick_input(); capture_mouse(false);
    play_doom_music(1147095374,1414680320);
}

fn move_main_choice(int direction) -> void {
    int count=6; if (menu==4) { count=7; }
    main_choice=(main_choice+direction+count)%count;
}

fn doom_menu(framebuffer fb) -> void {
    int blink=menu_time*5.0;
    int skull=57+blink%2;
    if (menu==0 || menu==4) {
        int height=77; if (menu==4) { height=88; }
        rect(fb,37,39,119,height,303042303);
        rect(fb,37,39,119,1,2223322623);
        int i=0;
        while (i<5) { ui_patch(fb,51+i,58,46+i*11); i+=1; }
        if (menu==4) { draw_return_menu_label(fb); ui_patch(fb,56,58,112); }
        else { ui_patch(fb,56,58,101); }
        ui_patch(fb,skull,40,42+main_choice*11);
    }
    if (menu==1) {
        rect(fb,10,22,170,75,303042303);
        ui_patch(fb,93,43,27);
        ui_patch(fb,94,29,47);
        if (available(2,1)) { ui_patch(fb,101,29,58); }
        if (available(3,1)) { ui_patch(fb,102,29,69); }
        if (available(4,1)) { ui_patch(fb,103,29,80); }
        ui_patch(fb,skull,12,42+(episode_choice-1)*11);
    }
    if (menu==8) {
        rect(fb,8,33,176,82,303042303);
        ui_patch(fb,104+(episode_choice-1)*9+map_choice-1,35,42);
        digit_set=69; doom_number(fb,80,62,episode_choice); doom_number(fb,104,62,map_choice);
        ui_patch(fb,skull,17,38);
        text(fb,13,91,22,4292317695); text(fb,13,102,23,4292317695);
    }
    if (menu==5) {
        rect(fb,10,7,173,116,303042303);
        ui_patch(fb,95,66,13);
        ui_patch(fb,96,42,46);
        if (scale_x==1) { ui_patch(fb,97,147,48); }
        else { ui_patch(fb,98,147,48); }
        options_slider(fb,70,false,mouse_sensitivity,20);
        options_slider(fb,96,true,audio_volume*10,100);
        ui_patch(fb,skull,25,42+options_choice*26);
    }
    if (menu==6) { ui_patch(fb,99,0,0); }
    if (menu==7) { ui_patch(fb,100,0,0); }
    if (menu==2) {
        rect(fb,8,6,176,104,303042303);
        ui_patch(fb,79,57,10);
        ui_patch(fb,80,32,28);
        int i=0;
        while (i<5) { ui_patch(fb,81+i,29,45+i*12); i+=1; }
        ui_patch(fb,skull,12,41+skill*12);
    }
    if (menu==9 || menu==10) { draw_save_menu(fb,skull); }
}

fn intermission(framebuffer fb) -> void {
    int background=59;
    if (episode>=2) { background=episode+142; }
    ui_patch(fb,background,0,0);
    ui_patch(fb,104+(episode-1)*9+level_number-1,52,3); ui_patch(fb,61,68,15);
    ui_patch(fb,62,30,36); ui_patch(fb,63,30,50); ui_patch(fb,64,30,64);
    digit_set=69;
    int k=0; int i=0;
    if (total_kills>0) { k=kills*100/total_kills; }
    if (total_items>0) { i=gathered*100/total_items; }
    k=fmin(k,fmax(0.0,(intermission_time-0.35)*70.0));
    i=fmin(i,fmax(0.0,(intermission_time-1.5)*70.0));
    doom_number(fb,149,36,k); ui_patch(fb,67,149,36);
    doom_number(fb,149,50,i); ui_patch(fb,67,149,50);
    int found=0;
    if (secret_total>0) { found=secrets*100/secret_total; }
    found=fmin(found,fmax(0.0,(intermission_time-2.7)*70.0));
    doom_number(fb,149,64,found); ui_patch(fb,67,149,64);
    ui_patch(fb,65,10,122);
    if (episode<=3) { ui_patch(fb,66,111,122); }
    int time=t_game;
    time=fmin(time,fmax(0.0,(intermission_time-3.6)*105.0));
    doom_number(fb,65,122,time/60);
    ui_patch(fb,68,66,122);
    ui_patch(fb,69+(time%60)/10,70,122); ui_patch(fb,69+time%10,77,122);
    if (episode<=3) {
        int par=file_read_little_uint16_at(doom_finale_data,((episode-1)*9+level_number-1)*2);
        par=fmin(par,fmax(0.0,(intermission_time-3.6)*105.0));
        doom_number(fb,144,122,par/60);
        ui_patch(fb,68,151,122);
        ui_patch(fb,69+(par%60)/10,156,122); ui_patch(fb,69+par%10,163,122);
    }
}

fn finale_offset() -> int { return 54+(episode-1)*1024; }

fn draw_finale_text(framebuffer fb) -> void {
    int top=0;
    while (top<240) {
        int left=0;
        while (left<320) { ui_patch_at(fb,158+episode,left,top); left+=64; }
        top+=77;
    }
    int p=finale_offset();
    int length=file_read_little_uint16_at(doom_finale_data,p);
    int count_chars=fmin(length,fmax(0.0,(finale_time*35.0-10.0)/3.0));
    int x=10; int y=12;
    int i=0;
    while (i<count_chars) {
        int ch=file_read_uint8_at(doom_finale_data,p+2+i);
        if (ch==10) { x=10; y+=13; }
        else {
            if (ch>=97 && ch<=122) { ch-=32; }
            if (ch<33 || ch>95) { x+=4; }
            else {
                int id=163+ch-33;
                int width=file_read_little_uint16_at(data,ui_index+id*8+4);
                if (x+width>320) { return; }
                ui_patch_at(fb,id,x,y); x+=width;
            }
        }
        i+=1;
    }
}

fn draw_finale(framebuffer fb) -> void {
    view_palette=0;
    if (!finale_picture) { draw_finale_text(fb); return; }
    if (episode==1) {
        int art=100;
        if (available(4,1)) { art=147; }
        ui_patch_at(fb,art,0,0);
    }
    if (episode==2) { ui_patch_at(fb,148,0,0); }
    if (episode==3) {
        int t=finale_time*35.0;
        int scroll=fmax(0.0,fmin(320.0,320-(t-230)/2));
        ui_patch_at(fb,150,-scroll,0); ui_patch_at(fb,149,320-scroll,0);
        if (t>=1130) { ui_patch_at(fb,152+bunny_frame,108,82); }
    }
    if (episode==4) { ui_patch_at(fb,151,0,0); }
}

fn tick_finale(float dt,bool escape) -> void {
    if (escape) {
        menu=0; play_doom_music(1147095374,1414680320); return;
    }
    finale_time+=dt;
    int ticks=finale_time*35.0;
    if (!finale_picture) {
        int length=file_read_little_uint16_at(doom_finale_data,finale_offset());
        if (ticks>length*3+250) {
            finale_picture=true; finale_time=0.0;
            if (episode==3) { play_doom_music(1147093589,1313757440); }
        }
    } else {
        if (episode==3 && ticks>=1180) {
            int next=fmin(6.0,(ticks-1180)/5);
            if (next>bunny_frame) { bunny_frame=next; play_doom_effect(sfx_dspistol); }
        }
    }
}

fn weapon_patch(framebuffer fb,int id) -> void {
    if (id==0) { return; }
    int m=texmeta+(id-1)*8;
    int offsets=sprite_offsets+(id-1)*4;
    blit_w=file_read_little_uint16_at(data,m);
    int height=file_read_little_uint16_at(data,m+2);
    // DOOM places the 320x168 view sprites at (1, 32) relative to a Y center of 100.
    // The framebuffer expands their logical rows by 6/5 for the original aspect ratio.
    int logical_top=16-signed_word(data,offsets+2)+death_weapon_y;
    blit_h=(logical_top+height)*6/5-logical_top*6/5;
    blit_d=0.0;
    int left=1-signed_word(data,offsets)+sin(bob)*sway*10.0;
    int top=logical_top*6/5+fabs(cos(bob*2.0))*sway*6.0;
    blit(fb,id,left,top);
}

fn extra_psprite(framebuffer fb,int frame) -> void {
    int id=file_read_little_uint16_at(data,extra_frames+34+frame*2);
    weapon_patch(fb,id);
}

fn energy_psprite(framebuffer fb,int frame) -> void {
    int id=file_read_little_uint16_at(data,extra_frames+126+frame*2);
    weapon_patch(fb,id);
}

fn draw_energy_weapon(framebuffer fb) -> void {
    if (extra_weapon==4) {
        int gun=0;
        if (extra_anim && cooldown>0.00001 && flash<=1.001/35.0) { gun=1; }
        energy_psprite(fb,gun);
        if (extra_anim && flash>0.00001) { energy_psprite(fb,2+plasma_frame); }
        return;
    }
    int gun=4;
    if ((bfg_windup>0 && bfg_windup<=10) || (extra_anim && cooldown>0.00001)) { gun=5; }
    energy_psprite(fb,gun);
    if (extra_anim && flash>0.00001) {
        int frame=6;
        if (flash<=6.0/35.0) { frame=7; }
        energy_psprite(fb,frame);
    }
}

fn draw_extra_weapon(framebuffer fb) -> void {
    if (extra_weapon==1) {
        int frame=0;
        if (extra_anim && cooldown>0.00001) {
            frame=1;
            float tics=cooldown*35.0;
            if (tics>5.0 && tics<=18.0) { frame=2; }
            if (tics>9.0 && tics<=14.0) { frame=3; }
        }
        extra_psprite(fb,frame);
        return;
    }
    if (extra_weapon==2) {
        int phase=t_game*8.75;
        int frame=6+phase%2;
        if (extra_anim && cooldown>0.00001) { frame=4+saw_frame; }
        extra_psprite(fb,frame);
        return;
    }
    if (extra_weapon>=4) { draw_energy_weapon(fb); return; }
    int gun=8;
    if (extra_anim && cooldown>0.00001) { gun=9; }
    extra_psprite(fb,gun);
    if (extra_anim && flash>0.00001) {
        int frame=10;
        float tics=flash*35.0;
        if (tics<=12.0) { frame=11; }
        if (tics<=8.0) { frame=12; }
        if (tics<=4.0) { frame=13; }
        extra_psprite(fb,frame);
    }
}

fn bullet_psprite(framebuffer fb,int frame) -> void {
    int id=file_read_little_uint16_at(data,extra_frames+218+frame*2);
    weapon_patch(fb,id);
}

fn draw_bullet_weapon(framebuffer fb) -> void {
    int remaining=cooldown*35.0+0.001;
    int flash_tics=flash*35.0+0.001;
    if (shotgun) {
        int frame=4;
        if (extra_anim && remaining>10 && remaining<=34) {
            frame=5;
            if (remaining>15 && remaining<=29) { frame=6; }
            if (remaining>20 && remaining<=24) { frame=7; }
        }
        bullet_psprite(fb,frame);
        if (extra_anim && flash_tics>0) {
            int flame=8;
            if (flash_tics<=3) { flame=9; }
            bullet_psprite(fb,flame);
        }
        return;
    }
    if (chaingun) {
        int frame=0;
        if (extra_anim && flash_tics>0) { frame=1-chaingun_frame; }
        bullet_psprite(fb,10+frame);
        if (extra_anim && flash_tics>0) { bullet_psprite(fb,12+frame); }
        return;
    }
    int frame=0;
    if (extra_anim && remaining>4) {
        frame=1;
        if (remaining>9 && remaining<=13) { frame=2; }
    }
    bullet_psprite(fb,frame);
    if (extra_anim && flash_tics>0) { bullet_psprite(fb,3); }
}

fn draw_death_prompt(framebuffer fb) -> void {
    int width=0; int n=0;
    while (n<23) {
        int ch=file_read_uint8_at(hud_text,death_prompt+n);
        if (ch==32) { width+=4; }
        else { width+=file_read_little_uint16_at(data,ui_index+(163+ch-33)*8+4); }
        n+=1;
    }
    int left=(320-width)/2;
    rect(fb,left*3/5-4,104,width*3/5+8,15,255);
    n=0;
    while (n<23) {
        int ch=file_read_uint8_at(hud_text,death_prompt+n);
        if (ch==32) { left+=4; }
        else {
            int id=163+ch-33;
            ui_patch_at(fb,id,left,181);
            left+=file_read_little_uint16_at(data,ui_index+id*8+4);
        }
        n+=1;
    }
}

fn render_ui(framebuffer fb,float dt,bool started) -> void {
    if (hp>0 || death_weapon_y<96) {
        if (extra_weapon==0) { draw_bullet_weapon(fb); }
        else { draw_extra_weapon(fb); }
    }
    if (map_open) { render_map(fb); }
    doom_status(fb); view_palette=0; inverse_colormap=false;
    if (hp<=0 && menu==3) { draw_death_prompt(fb); }
}


fn compile_map_if_needed(int episode,int mission) -> bool {
    if (episode==compiled_episode && mission==compiled_mission) { return true; }
    loading_step("Lecture de la carte",2);
    file map=wad_map(doom_wad,wad_directory_offset,episode,mission);
    file next=wad_compile_level(doom_wad,wad_directory_offset,map,wad_colors,episode,mission);
    file_close(map);
    if (file_size(next)==0) { file_close(next); return false; }
    if (compiled_episode!=0) { file_close(data); }
    data=next;
    compiled_episode=episode; compiled_mission=mission;
    return true;
}
fn load_classic_map() -> void {
    classic_blockmap=map_base+file_read_little_uint32_at(data,map_base+152);
    classic_lines=map_base+file_read_little_uint32_at(data,map_base+156);
    classic_nodes=map_base+file_read_little_uint32_at(data,map_base+160);
    classic_leaves=map_base+file_read_little_uint32_at(data,map_base+164);
    classic_node_count=(classic_leaves-classic_nodes)/28;
    classic_block_x=signed_word(data,classic_blockmap)*65536;
    classic_block_y=signed_word(data,classic_blockmap+2)*65536;
    classic_block_w=file_read_little_uint16_at(data,classic_blockmap+4);
    classic_block_h=file_read_little_uint16_at(data,classic_blockmap+6);
}

fn select_map(int e,int n) -> void {
    bool loading_owner=loading_begin();
    if (!compile_map_if_needed(e,n)) { print_str("Carte WAD invalide."); exit(2); }
    episode=e; level_number=n;
    map_base=file_read_little_uint32_at(data,4+((e-1)*9+n-1)*4);
    if (map_base==0) { print_str("Niveau absent du WAD."); exit(2); }
    origin_x=signed_word(data,map_base+4); origin_y=signed_word(data,map_base+6);
    sectors=map_base+file_read_little_uint32_at(data,map_base+20);
    edges=map_base+file_read_little_uint32_at(data,map_base+24);
    grid=map_base+file_read_little_uint32_at(data,map_base+28);
    actor_base=map_base+file_read_little_uint32_at(data,map_base+32);
    actor_traits=map_base+file_read_little_uint32_at(data,map_base+168);
    hostile_frames=map_base+file_read_little_uint32_at(data,map_base+172);
    reject_table=map_base+file_read_little_uint32_at(data,map_base+176);
    reject_size=file_read_little_uint32_at(data,map_base+180);
    sprite_rotations=map_base+file_read_little_uint32_at(data,map_base+184);
    render_roots=map_base+file_read_little_uint32_at(data,map_base+188);
    render_branches=map_base+file_read_little_uint32_at(data,map_base+192);
    render_ids=map_base+file_read_little_uint32_at(data,map_base+196);
    flat_colors=map_base+file_read_little_uint32_at(data,map_base+200);
    texmeta=map_base+file_read_little_uint32_at(data,map_base+36);
    atlas=file_read_little_uint32_at(data,148);
    ui_index=map_base+file_read_little_uint32_at(data,map_base+64);
    ui_pixels=atlas;
    check_status_background();
    flat_index=map_base+file_read_little_uint32_at(data,map_base+72);
    map_index=map_base+file_read_little_uint32_at(data,map_base+80);
    enemy_frames=map_base+file_read_little_uint32_at(data,map_base+88);
    actions=map_base+file_read_little_uint32_at(data,map_base+92);
    changes=map_base+file_read_little_uint32_at(data,map_base+96);
    triggers=map_base+file_read_little_uint32_at(data,map_base+100);
    grid_w=file_read_little_uint16_at(data,map_base+8);
    grid_h=file_read_little_uint16_at(data,map_base+10);
    count=file_read_little_uint16_at(data,map_base+18);
    sky_pixels=atlas+file_read_little_uint32_at(data,map_base+112);
    sky_w=file_read_little_uint16_at(data,map_base+116); sky_h=file_read_little_uint16_at(data,map_base+118);
    barrel_frames=map_base+file_read_little_uint32_at(data,map_base+120);
    imp_frames=map_base+file_read_little_uint32_at(data,map_base+124);
    extra_frames=map_base+file_read_little_uint32_at(data,map_base+128);
    animation_table=map_base+file_read_little_uint32_at(data,map_base+132);
    animation_ids=map_base+file_read_little_uint32_at(data,map_base+136);
    light_specs=map_base+file_read_little_uint32_at(data,map_base+140);
    sprite_offsets=map_base+file_read_little_uint32_at(data,map_base+148);
    map_count=file_read_little_uint16_at(data,map_base+84);
    map_edges=map_base+file_read_little_uint32_at(data,map_base+144);
    secret_total=file_read_little_uint16_at(data,map_base+86);
    trigger_count=file_read_little_uint16_at(data,map_base+104);
    initial_boss=file_read_little_uint16_at(data,map_base+106);
    action_count=file_read_little_uint16_at(data,map_base+108);
    load_classic_map();
    reset();
    initialize_sector_lights();
    mouse_ready=false;
    loading_end(loading_owner);
}
fn load_data() -> void {

    read_wad_directory_offset();
    if (wad_lump_count==0) { print_str("DOOM.wad absent ou invalide dans ce dossier."); exit(2); }
    wad_save_identity(doom_wad);
    wad_colors=wad_palette(doom_wad,wad_directory_offset);
    if (file_size(wad_colors)!=473088) { print_str("Palette WAD invalide."); exit(2); }
    wad_map_list=file_create("");
    int i=0;
    while (i<36) {
        file map=wad_map(doom_wad,wad_directory_offset,i/9+1,i%9+1);
        if (file_size(map)==80) { file_append_uint8(1,wad_map_list); }
        else { file_append_uint8(0,wad_map_list); }
        file_close(map);
        i+=1;
    }
    font_data=build_font_data(); hud_text=build_hud_text();
    death_prompt=file_size(hud_text);
    file_append_uint32(1163087937,hud_text);
    file_append_uint32(1128603728,hud_text);
    file_append_uint32(1330991648,hud_text);
    file_append_uint32(1380270927,hud_text);
    file_append_uint32(1296909646,hud_text);
    file_append_uint32(1128616448,hud_text);
    file_append_uint32(0,hud_text);
    file_append_uint32(0,hud_text);
    return_menu_patch=wad_patch(doom_wad,wad_directory_offset,1298089294,1145520461,false); // M_ENDGAM
    doom_random_data=build_random_data(); doom_sine_data=build_sine_data();
    doom_finale_data=build_finale_data();
    render_bsp=false;
    render_cache=file_create(""); render_index=file_create("");
    things=file_create(""); depth=file_create(""); explored=file_create("");
    portal_index=file_create(""); portal_log=file_create(""); sprite_queue=file_create("");
    sector_state=file_create(""); used_actions=file_create("");
    imp_shots=file_create(""); imp_sources=file_create("");
    monster_state=file_create(""); hostile_shots=file_create(""); noise_queue=file_create("");
    button_times=file_create(""); mask_log=file_create(""); mask_index=file_create("");
    map_discovery=file_create("");
    sector_lights=file_create(""); active_lights=file_create("");
    save_slot_info=file_create("");
    select_map(1,1);
}

fn advance_map() -> void {
    int next=level_number+1;
    if (level_number==9) {
        next=4;
        if (episode==2) { next=6; }
        if (episode==3) { next=7; }
        if (episode==4) { next=3; }
    }
    if (secret_exit) { next=9; }
    if (!secret_exit && level_number==8) {
        won=false; live=false; menu=11;
        finale_time=0.0; finale_picture=false; bunny_frame=0;
        play_doom_music(1147098697,1129598802); return;
    }
    if (!available(episode,next)) {
        won=false; live=false; menu=0; play_doom_music(1147095374,1414680320); return;
    }
    file supplies=file_create("");
    file_append_uint8(hp,supplies);
    file_append_uint8(armor,supplies);
    file_append_uint8(armor_type,supplies);
    file_append_uint8(shells,supplies);
    file_append_little_uint16(ammo,supplies);
    file_append_little_uint16(cells,supplies);
    file_append_uint8(rockets,supplies);
    file_append_uint8(extra_weapon,supplies);
    int inventory=0;
    if (has_shotgun) { inventory=inventory|1; }
    if (shotgun) { inventory=inventory|2; }
    if (has_chaingun) { inventory=inventory|4; }
    if (chaingun) { inventory=inventory|8; }
    if (has_chainsaw) { inventory=inventory|16; }
    if (has_launcher) { inventory=inventory|32; }
    if (backpack) { inventory=inventory|64; }
    if (has_plasma) { inventory=inventory|128; }
    if (has_bfg) { inventory=inventory|256; }
    select_map(episode,next);
    hp=file_read_uint8_at(supplies,0); armor=file_read_uint8_at(supplies,1);
    armor_type=file_read_uint8_at(supplies,2); shells=file_read_uint8_at(supplies,3);
    ammo=file_read_little_uint16_at(supplies,4); cells=file_read_little_uint16_at(supplies,6);
    rockets=file_read_uint8_at(supplies,8); extra_weapon=file_read_uint8_at(supplies,9);
    file_close(supplies);
    has_shotgun=(inventory&1)!=0; shotgun=(inventory&2)!=0;
    has_chaingun=(inventory&4)!=0; chaingun=(inventory&8)!=0;
    has_chainsaw=(inventory&16)!=0; has_launcher=(inventory&32)!=0;
    backpack=(inventory&64)!=0;
    has_plasma=(inventory&128)!=0; has_bfg=(inventory&256)!=0;
    play_level_music();
}

fn finish_map() -> void {
    bool loading_owner=loading_begin();
    advance_map();
    loading_end(loading_owner);
}
// Save snapshots use two alternating copies. The older valid copy survives a torn write.
fn snapshot_path(void @storage,int slot,int copy) -> void {
    uint8 @path=storage;
    uint8 @pattern="doom-save1a.sav";
    int at=0;
    while (at<16) { path[at]=pattern[at]; at+=1; }
    path[9]=49+slot;
    path[10]=97+copy;
}

fn open_snapshot(int slot,int copy) -> file {
    void @storage=aloc(16);
    snapshot_path(storage,slot,copy);
    uint8 @path=storage;
    file result=file_open(path);
    free(storage);
    return result;
}

fn create_snapshot(int slot,int copy) -> file {
    void @storage=aloc(16);
    snapshot_path(storage,slot,copy);
    uint8 @path=storage;
    file result=file_create(path);
    free(storage);
    return result;
}

fn save_float(file f,float value) -> void {
    // Normalize by powers of two to preserve finite float values on StegVM.
    if (value==0.0) { file_append_little_uint32(0,f); return; }
    uint32 sign=0;
    if (value<0.0) { sign=2147483648; value=-value; }
    int exponent=127;
    while (value>=2.0 && exponent<254) { value*=0.5; exponent+=1; }
    while (value<1.0 && exponent>1) { value*=2.0; exponent-=1; }
    if (value<1.0) { exponent=0; }
    else { value-=1.0; }
    uint32 fraction=value*8388608.0;
    file_append_little_uint32(sign|(exponent<<23)|fraction,f);
}

fn load_float(file f) -> float {
    uint32 bits=file_read_little_uint32(f);
    if (bits==0) { return 0.0; }
    int exponent=(bits>>23)&255;
    float value=(bits&8388607)/8388608.0;
    if (exponent==0) { exponent=1; }
    else { value+=1.0; }
    while (exponent>127) { value*=2.0; exponent-=1; }
    while (exponent<127) { value*=0.5; exponent+=1; }
    if ((bits&2147483648)!=0) { return -value; }
    return value;
}

fn save_scalars(file f) -> void {
    int flags=0;
    if (secret_exit) { flags=flags|1; }
    if (lift) { flags=flags|2; }
    if (shotgun) { flags=flags|4; }
    if (has_shotgun) { flags=flags|8; }
    if (has_chaingun) { flags=flags|16; }
    if (chaingun) { flags=flags|32; }
    if (has_chainsaw) { flags=flags|64; }
    if (has_launcher) { flags=flags|128; }
    if (extra_anim) { flags=flags|256; }
    if (attack_was_down) { flags=flags|512; }
    if (map_open) { flags=flags|1024; }
    if (backpack) { flags=flags|2048; }

    flags=flags|8192; // Retain the classic movement flag for older readers.
    if (has_plasma) { flags=flags|16384; }
    if (has_bfg) { flags=flags|32768; }
    file_append_little_uint32(flags,f);
    file_append_little_uint32(keys,f);
    file_append_little_uint32(boss_action,f);
    file_append_little_uint32(secrets,f);
    file_append_little_uint32(gathered,f);
    file_append_little_uint32(total_kills,f);
    file_append_little_uint32(total_items,f);
    save_float(f,px);
    save_float(f,py);
    save_float(f,pz);
    save_float(f,angle);
    save_float(f,horizon);
    save_float(f,dx);
    save_float(f,dy);
    file_append_little_uint32(sector,f);
    save_float(f,motion_clock);
    file_append_little_uint32(hp,f);
    file_append_little_uint32(armor,f);
    file_append_little_uint32(armor_type,f);
    file_append_little_uint32(ammo,f);
    file_append_little_uint32(shells,f);
    file_append_little_uint32(kills,f);
    file_append_little_uint32(chaingun_frame,f);
    file_append_little_uint32(extra_weapon,f);
    file_append_little_uint32(rockets,f);
    file_append_little_uint32(saw_frame,f);
    save_float(f,cooldown);
    save_float(f,flash);
    save_float(f,hurt);
    save_float(f,t_game);
    save_float(f,bob);
    save_float(f,suit_time);
    save_float(f,light_time);
    save_float(f,shadow_time);
    save_float(f,eye_z);
    file_append_little_uint32(bonus_count,f);
    save_float(f,bonus_clock);
    save_float(f,sway);
    save_float(f,move_vx);
    save_float(f,move_vy);
    save_float(f,feet_z);
    save_float(f,0.0);
    save_float(f,info_time);
    file_append_little_uint32(info,f);
    file_append_little_uint32(level_tic,f);
    file_append_little_uint32(damage_count,f);
    file_append_little_uint32(random_index,f);
    file_append_little_uint32(turn_held_tics,f);
    file_append_little_uint32(classic_x,f);
    file_append_little_uint32(classic_y,f);
    file_append_little_uint32(classic_heading,f);
    file_append_little_uint32(classic_momx,f);
    file_append_little_uint32(classic_momy,f);
    file_append_little_uint32(cells,f);
    file_append_little_uint32(berserk_tics,f);
    file_append_little_uint32(invulnerability_tics,f);
    file_append_little_uint32(bfg_windup,f);
    file_append_little_uint32(plasma_frame,f);
    file_append_little_uint32(bullet_streak,f);
}

fn load_scalars(file f) -> void {
    int flags=file_read_little_uint32(f);
    secret_exit=(flags&1)!=0;
    lift=(flags&2)!=0;
    shotgun=(flags&4)!=0;
    has_shotgun=(flags&8)!=0;
    has_chaingun=(flags&16)!=0;
    chaingun=(flags&32)!=0;
    has_chainsaw=(flags&64)!=0;
    has_launcher=(flags&128)!=0;
    extra_anim=(flags&256)!=0;
    attack_was_down=(flags&512)!=0;
    map_open=(flags&1024)!=0;
    backpack=(flags&2048)!=0;


    has_plasma=(flags&16384)!=0;
    has_bfg=(flags&32768)!=0;
    keys=file_read_little_uint32(f);
    boss_action=file_read_little_uint32(f);
    secrets=file_read_little_uint32(f);
    gathered=file_read_little_uint32(f);
    total_kills=file_read_little_uint32(f);
    total_items=file_read_little_uint32(f);
    px=load_float(f);
    py=load_float(f);
    pz=load_float(f);
    angle=load_float(f);
    horizon=load_float(f);
    dx=load_float(f);
    dy=load_float(f);
    sector=file_read_little_uint32(f);
    motion_clock=load_float(f);
    hp=file_read_little_uint32(f);
    armor=file_read_little_uint32(f);
    armor_type=file_read_little_uint32(f);
    ammo=file_read_little_uint32(f);
    shells=file_read_little_uint32(f);
    kills=file_read_little_uint32(f);
    chaingun_frame=file_read_little_uint32(f);
    extra_weapon=file_read_little_uint32(f);
    rockets=file_read_little_uint32(f);
    saw_frame=file_read_little_uint32(f);
    cooldown=load_float(f);
    flash=load_float(f);
    hurt=load_float(f);
    t_game=load_float(f);
    bob=load_float(f);
    suit_time=load_float(f);
    light_time=load_float(f);
    shadow_time=load_float(f);
    eye_z=load_float(f);
    bonus_count=file_read_little_uint32(f);
    bonus_clock=load_float(f);
    sway=load_float(f);
    move_vx=load_float(f);
    move_vy=load_float(f);
    feet_z=load_float(f);
    load_float(f); // Legacy jump velocity, retained in the save format.
    info_time=load_float(f);
    info=file_read_little_uint32(f);
    level_tic=file_read_little_uint32(f);
    damage_count=file_read_little_uint32(f);
    random_index=file_read_little_uint32(f);
    turn_held_tics=file_read_little_uint32(f);
    classic_x=file_read_little_uint32(f);
    classic_y=file_read_little_uint32(f);
    classic_heading=file_read_little_uint32(f);
    classic_momx=file_read_little_uint32(f);
    classic_momy=file_read_little_uint32(f);
    cells=file_read_little_uint32(f);
    berserk_tics=file_read_little_uint32(f);
    invulnerability_tics=file_read_little_uint32(f);
    bfg_windup=file_read_little_uint32(f);
    plasma_frame=file_read_little_uint32(f);
    bullet_streak=file_read_little_uint32(f);
    horizon=64.0;
    if ((flags&8192)==0) { sync_classic_position(); }
}

fn save_buffer(file f,file source) -> void {
    int length=file_size(source);
    file_append_little_uint32(length,f);
    int at=0;
    while (at<length) {
        file_append_uint8(file_read_uint8_at(source,at),f);
        at+=1;
    }
}

fn load_buffer(file f,file destination) -> void {
    int length=file_read_little_uint32(f);
    file_clear_data(destination); file_reset_cursor(destination);
    int at=0;
    while (at<length) {
        file_append_uint8(file_read_uint8(f),destination);
        at+=1;
    }
}

fn save_checksum(file f,int length) -> uint32 {
    uint32 value=2166136261;
    int at=0;
    while (at<length) {
        value=(value^file_read_uint8_at(f,at))*16777619;
        at+=1;
    }
    return value;
}

fn save_payload_ok(file f,int length,int base) -> bool {
    int rooms=(file_read_little_uint32_at(data,base+24)-file_read_little_uint32_at(data,base+20))/24;
    int actors=file_read_little_uint16_at(data,base+18);
    int actions_in_map=file_read_little_uint16_at(data,base+108);
    int end=length-4;
    // Header (20 bytes), flags and the 58 scalar words precede the buffers.
    int pos=256;
    int source_bytes=0;
    int field=0;
    while (field<11) {
        if (pos+4>end) { return false; }
        int size=file_read_little_uint32_at(f,pos);
        pos+=4;
        if (size<0 || size>end-pos) { return false; }
        if (field==0 && size!=actors*12) { return false; }
        if (field==1 && size!=rooms*12) { return false; }
        if (field==2 && size!=actions_in_map) { return false; }
        if (field==3 && size!=actions_in_map*4) { return false; }
        if (field==4 && size!=rooms) { return false; }
        if (field==5 && size!=file_read_little_uint16_at(data,base+84)) { return false; }
        if (field==6 && size!=rooms*6) { return false; }
        if (field==7 && ((size&1)!=0 || size>rooms*2)) { return false; }
        if (field==8) {
            if (size%22!=0 || size>1408) { return false; }
            source_bytes=size/11;
        }
        if (field==9 && size!=actors*12) { return false; }
        if (field==10 && (size%24!=0 || size>1200)) { return false; }
        pos+=size;
        field+=1;
    }
    if (pos==end) { return true; } // Original snapshots have no ownership extension.
    if (pos+4>end) { return false; }
    return file_read_little_uint32_at(f,pos)==source_bytes && pos+4+source_bytes==end;
}

fn save_generation(file f) -> int {
    if (!file_is_readable(f)) { return 0; }
    int length=file_size(f);
    if (length<304 || length>1048576) { return 0; }
    if (file_read_little_uint32_at(f,0)!=827544388) { return 0; }
    int identity=file_size(data)-8;
    if (file_read_little_uint32_at(f,8)!=file_read_little_uint32_at(data,identity)
        || file_read_little_uint32_at(f,12)!=file_read_little_uint32_at(data,identity+4)) { return 0; }
    int e=file_read_uint8_at(f,16); int m=file_read_uint8_at(f,17);
    if (!available(e,m) || file_read_uint8_at(f,18)>4) { return 0; }
    if (save_checksum(f,length-4)!=file_read_little_uint32_at(f,length-4)) { return 0; }
    int generation=file_read_little_uint32_at(f,4);
    if (generation<=0) { return 0; }
    return generation;
}

fn save_slot_generation(int slot,int copy) -> int {
    file f=open_snapshot(slot,copy);
    int result=save_generation(f);
    file_close(f);
    return result;
}

fn save_game_slot(int slot) -> bool {
    if (!live || won || hp<=0) { return false; }
    int a=save_slot_generation(slot,0);
    int b=save_slot_generation(slot,1);
    int copy=0;
    int generation=b+1;
    if (a>b) { copy=1; generation=a+1; }
    if (generation<=0) { return false; }
    file f=create_snapshot(slot,copy);
    int identity=file_size(data)-8;
    file_append_little_uint32(827544388,f);
    file_append_little_uint32(generation,f);
    file_append_little_uint32(file_read_little_uint32_at(data,identity),f);
    file_append_little_uint32(file_read_little_uint32_at(data,identity+4),f);
    file_append_uint8(episode,f); file_append_uint8(level_number,f);
    file_append_uint8(difficulty,f); file_append_uint8(0,f);
    save_scalars(f);
    save_buffer(f,things); save_buffer(f,sector_state); save_buffer(f,used_actions);
    save_buffer(f,button_times); save_buffer(f,explored); save_buffer(f,map_discovery);
    save_buffer(f,sector_lights); save_buffer(f,active_lights); save_buffer(f,imp_shots);
    save_buffer(f,monster_state); save_buffer(f,hostile_shots);
    save_buffer(f,imp_sources);
    int length=file_size(f);
    if (length>1048572) { file_close(f); return false; }
    file_append_little_uint32(save_checksum(f,length),f);
    file_save(f);
    file_close(f);
    return true;
}

// Actor base sprites are level-local atlas IDs. Rebind them when loading an
// older snapshot, since corrected WAD names can change atlas allocation order.
fn refresh_actor_textures() -> void {
    int at=0;
    while (at<count*12) {
        file_seek_cursor(at+4,things);
        file_write_little_uint16(file_read_little_uint16_at(data,actor_base+at+4),things);
        at+=12;
    }
}

fn load_game_slot(int slot) -> bool {
    int a=save_slot_generation(slot,0);
    int b=save_slot_generation(slot,1);
    if (a==0 && b==0) { return false; }
    int copy=0; if (b>a) { copy=1; }
    file f=open_snapshot(slot,copy);
    if (save_generation(f)==0) { file_close(f); return false; }
    int e=file_read_uint8_at(f,16); int m=file_read_uint8_at(f,17);
    difficulty=file_read_uint8_at(f,18);
    bool loading_owner=loading_begin();
    select_map(e,m);
    if (!save_payload_ok(f,file_size(f),map_base)) { file_close(f); loading_end(loading_owner); return false; }
    file_seek_cursor(20,f);
    load_scalars(f);
    load_buffer(f,things); load_buffer(f,sector_state); load_buffer(f,used_actions);
    refresh_actor_textures();
    load_buffer(f,button_times); load_buffer(f,explored); load_buffer(f,map_discovery);
    load_buffer(f,sector_lights); load_buffer(f,active_lights); load_buffer(f,imp_shots);
    load_buffer(f,monster_state); load_buffer(f,hostile_shots);
    if (file_get_cursor(f)<file_size(f)-4) { load_buffer(f,imp_sources); }
    else { fill_imp_sources(); }
    file_close(f);
    live=true; menu=3;
    play_level_music();
    loading_end(loading_owner);
    return true;
}

fn open_save_menu(int next_menu,int return_menu) -> void {
    file_clear_data(save_slot_info); file_reset_cursor(save_slot_info);
    int slot=0;
    while (slot<6) {
        file first=open_snapshot(slot,0);
        file second=open_snapshot(slot,1);
        int a=save_generation(first); int b=save_generation(second);
        int e=0; int m=0;
        if (b>a) { e=file_read_uint8_at(second,16); m=file_read_uint8_at(second,17); }
        else { if (a>0) { e=file_read_uint8_at(first,16); m=file_read_uint8_at(first,17); } }
        file_append_uint8(e,save_slot_info);
        file_append_uint8(m,save_slot_info);
        file_close(first); file_close(second);
        slot+=1;
    }
    save_return_menu=return_menu;
    menu=next_menu;
}

fn show_save_notice(int notice) -> void {
    save_notice=notice; save_notice_until=menu_time+2.5;
}

fn update_save_menu(bool enter,bool escape) -> void {
    if (escape) { menu=save_return_menu; return; }
    if (window_key_pressed(265)) { save_choice=(save_choice+5)%6; }
    if (window_key_pressed(264)) { save_choice=(save_choice+1)%6; }
    if (!enter) { return; }
    if (menu==9) {
        if (!load_game_slot(save_choice)) { show_save_notice(2); }
        else { save_notice=0; }
        return;
    }
    if (save_game_slot(save_choice)) { menu=3; show_save_notice(1); }
    else { show_save_notice(4); }
}

bool show_fps=false;
int display_fps=0;
int fps_frames=0;
float fps_elapsed=0.0;
bool fps_gameplay=false;

fn update_frame_rate(float elapsed,bool gameplay) -> void {
    if (fps_gameplay!=gameplay) {
        fps_gameplay=gameplay;
        fps_elapsed=0.0; fps_frames=0;
        return;
    }
    if (elapsed<=0.0) { return; }
    fps_elapsed+=elapsed; fps_frames+=1;
    if (fps_elapsed<0.4) { return; }
    display_fps=fps_frames/fps_elapsed+0.5;
    fps_elapsed=0.0; fps_frames=0;
    // The viewport remains 320x240. Only the number of world rays changes.
}

fn change_detail() -> void {
    scale_x=scale_x/2;
    if (scale_x<1) { scale_x=4; }
    fps_elapsed=0.0; fps_frames=0;
}

fn adjust_option(int change) -> void {
    if (options_choice==0) { change_detail(); }
    if (options_choice==1) {
        mouse_sensitivity=fmax(1.0,fmin(20.0,mouse_sensitivity+change));
        options_dirty=true;
    }
    if (options_choice==2) {
        audio_volume=fmax(0.0,fmin(10.0,audio_volume+change));
        apply_audio_volume();
        options_dirty=true;
    }
}

fn update_options() -> void {
    if (window_key_pressed(265)) { options_choice=(options_choice+2)%3; }
    if (window_key_pressed(264)) { options_choice=(options_choice+1)%3; }
    if (window_key_pressed(263)) { adjust_option(-1); }
    else {
        if (window_key_pressed(262) || (options_choice==0 && window_key_pressed(257))) { adjust_option(1); }
    }
}

fn draw_fps(framebuffer fb) -> void {
    rect(fb,147,3,42,11,255);
    glyph(fb,150,5,70,4294967295);
    glyph(fb,156,5,80,4294967295);
    glyph(fb,162,5,83,4294967295);
    number(fb,169,5,display_fps,4294967295);
}

export fn main() -> void {
    window_create(960,720,"DOOM - Steg autonome");
    window_set_viewport_size(320,240);
    window_set_target_fps(60);
    framebuffer fb=window_framebuffer_create(320,240);
    loading_attach(fb);
    bool startup_loading_owner=loading_begin();
    load_data();
    load_options();
    scale_x=1;
    menu=-1;
    ui_patch(fb,0,0,0);
    loading_snapshot();
    load_doom_audio();
    loading_end(startup_loading_owner);
    while (!window_should_close() && !quit) {
        if (doom_audio_ready) { audio_update(); }
        if (doom_audio_ready && window_key_pressed(296)) {
            doom_audio_muted=!doom_audio_muted;
            apply_audio_volume();
        }
        float real_dt=window_get_delta();
        update_frame_rate(real_dt,live && menu==3 && !won && !map_open);
        if (window_key_pressed(299)) { show_fps=!show_fps; }
        if (window_key_pressed(291)) { change_detail(); }
        if (window_key_pressed(300)) { window_toggle_fullscreen(); mouse_ready=false; }
        menu_time+=real_dt;
        bool enter=window_key_pressed(257);
        bool escape=window_key_pressed(256);
        int previous_menu=menu;
        if (!won) { intermission_time=0.0; }
        if (!won && menu!=11 && window_key_pressed(295)) {
            if (live && hp>0) { open_save_menu(10,4); }
            else { show_save_notice(3); }
        }
        if (!won && menu!=11 && window_key_pressed(298)) {
            int back_menu=0; if (live) { back_menu=4; }
            open_save_menu(9,back_menu);
        }
        if (menu==11) { tick_finale(real_dt,escape); }
        else { if (won) {
            intermission_time+=real_dt;
            if (enter) {
                if (intermission_time<5.5) { intermission_time=5.5; }
                else { finish_map(); }
            }
            if (escape) { won=false; live=false; menu=0; play_doom_music(1147095374,1414680320); }
        } else {
            if (menu==9 || menu==10) {
                if (menu==previous_menu) { update_save_menu(enter,escape); }
            }
            else {
              if (menu==-1 && (enter || escape)) { menu=0; }
              else {
                if (menu==0 || menu==4) {
                    int parent_menu=menu;
                    if (window_key_pressed(265)) { move_main_choice(-1); }
                    if (window_key_pressed(264)) { move_main_choice(1); }
                    if (enter) {
                        if (main_choice==0) { menu=1; }
                        if (main_choice==1) { menu=5; }
                        if (main_choice==2) { open_save_menu(9,parent_menu); }
                        if (main_choice==3) {
                            if (live && hp>0) { open_save_menu(10,parent_menu); }
                            else { show_save_notice(3); }
                        }
                        if (main_choice==4) { menu=6; }
                        if (main_choice==5) {
                            if (parent_menu==4) { return_to_main_menu(); }
                            else { quit=true; }
                        }
                        if (main_choice==6 && parent_menu==4) { quit=true; }
                    }
                }
                else {
                    if (menu==1) {
                        if (window_key_pressed(265) && episode_choice>1) { episode_choice-=1; }
                        if (window_key_pressed(264) && available(episode_choice+1,1)) { episode_choice+=1; }
                        if (enter) { map_choice=1; menu=8; }
                    }
                    else {
                        if (menu==2) {
                            if (window_key_pressed(265)) { skill=(skill+4)%5; }
                            if (window_key_pressed(264)) { skill=(skill+1)%5; }
                            if (enter) {
                                difficulty=skill; random_index=0;
                                bool loading_owner=loading_begin();
                                select_map(episode_choice,map_choice); live=true; menu=3;
                                play_level_music();
                                loading_end(loading_owner);
                            }
                        } else {
                            if (menu==3 && escape) { menu=4; main_choice=0; }
                        }
                    }
                }
              }
            }
            if (menu==8) {
                if (window_key_pressed(263) && available(episode_choice,map_choice-1)) { map_choice-=1; }
                if (window_key_pressed(262) && available(episode_choice,map_choice+1)) { map_choice+=1; }
                if (enter && previous_menu==8) { menu=2; }
            }
            if (escape && previous_menu==8) { menu=1; }
            else {
                if (menu==5 && previous_menu==5 && !escape) { update_options(); }
                if (escape && previous_menu==5) { save_options(); }
                if (escape && previous_menu>=5 && previous_menu<=7) {
                    menu=0; if (live) { menu=4; }
                }
            }
            if (escape && previous_menu==2) { menu=8; }
            else {
                if (escape && previous_menu==1) {
                    menu=0; if (live) { menu=4; }
                }
            }
            if (escape && previous_menu==4) { menu=3; }
            if (live && menu==3) {
                if (previous_menu==3) {
                    capture_tick_input();
                    run_live_tics(real_dt);
                }
            } else {
                tic_clock=0.0;
                clear_tick_input();
            }
        }
        }
        if (won && level_number==8 && !secret_exit) { finish_map(); }
        capture_mouse(live && menu==3 && !won && !map_open);
        status_cache_enabled=status_opaque && live && menu==3 && !won && !map_open;
        world_draw_bottom=213;
        if (status_cache_enabled) { world_draw_bottom=201; }
        else { status_cache_valid=false; }
        window_clear(0,0,0);
        if (menu==11) { draw_finale(fb); }
        else { if (won) { intermission(fb); }
        else {
            if (!live) { ui_patch(fb,0,0,0); }
            else {
                render_world(fb); render_things(fb); render_ui(fb,real_dt,true);
            }
            if (menu!=3) { doom_menu(fb); }
            draw_save_notice(fb);
        } }
        if (show_fps) { draw_fps(fb); }
        window_framebuffer_sync(fb); window_framebuffer_draw(fb,0,0); window_present();
    }
    capture_mouse(false);
    save_options();
    file_close(doom_wad); file_close(wad_colors); file_close(wad_map_list);
    audio_close();
    window_close();
    exit(0);
}
