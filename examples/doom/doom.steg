    add_ui(wad,directory,headers,pixels,1398031174,1311783220);
    add_ui(wad,directory,headers,pixels,1398031174,1311783221);
}

fn wad_ui(file wad,uint32 directory) -> file {
    file headers=file_create("");
    file pixels=wad_atlas_pixels();
    ui_group_0(wad,directory,headers,pixels);
    ui_group_1(wad,directory,headers,pixels);
    ui_group_2(wad,directory,headers,pixels);
    ui_group_3(wad,directory,headers,pixels);
    ui_group_4(wad,directory,headers,pixels);
    return headers;
}

fn actor_def(file catalog,uint32 head,uint32 first,uint32 last,uint32 traits) -> void {
    file_append_little_uint32(head,catalog);
    file_append_uint32(first,catalog);
    file_append_uint32(last,catalog);
    file_append_little_uint32(traits,catalog);
}

