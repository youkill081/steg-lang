    if (special==28) { return 2; }
    if (special==29) { return 2; }
    if (special==30) { return 10; }
    if (special==31) { return 2; }
    if (special==32) { return 2; }
    if (special==33) { return 2; }
    if (special==34) { return 2; }
    if (special==35) { return 13; }
    if (special==36) { return 6; }
    if (special==37) { return 4; }
    if (special==38) { return 4; }
    if (special==40) { return 4; }
    if (special==41) { return 1; }
    if (special==42) { return 1; }
    if (special==43) { return 1; }
    if (special==44) { return 1; }
    if (special==45) { return 5; }
    if (special==46) { return 2; }
    if (special==47) { return 7; }
    if (special==50) { return 1; }
    if (special==53) { return 3; }
    if (special==55) { return 9; }
    if (special==56) { return 9; }
    if (special==58) { return 10; }
    if (special==59) { return 10; }
    if (special==60) { return 4; }
    if (special==61) { return 2; }
    if (special==62) { return 3; }
    if (special==63) { return 2; }
    if (special==64) { return 8; }
    if (special==65) { return 9; }
    if (special==66) { return 10; }
    if (special==67) { return 11; }
    if (special==68) { return 7; }
    if (special==69) { return 7; }
    if (special==70) { return 6; }
    if (special==71) { return 6; }
    if (special==72) { return 1; }
    if (special==75) { return 1; }
    if (special==76) { return 1; }
    if (special==79) { return 13; }
    if (special==80) { return 13; }
    if (special==81) { return 13; }
    if (special==82) { return 4; }
    if (special==83) { return 5; }
    if (special==84) { return 4; }
    if (special==86) { return 2; }
    if (special==87) { return 3; }
    if (special==88) { return 3; }
    if (special==90) { return 2; }
    if (special==91) { return 8; }
    if (special==92) { return 10; }
    if (special==93) { return 10; }
    if (special==94) { return 9; }
    if (special==95) { return 7; }
    if (special==96) { return 10; }
    if (special==98) { return 6; }
    if (special==99) { return 2; }
    if (special==101) { return 8; }
    if (special==102) { return 5; }
    if (special==103) { return 2; }
    if (special==104) { return 13; }
    if (special==105) { return 2; }
    if (special==106) { return 2; }
    if (special==107) { return 1; }
    if (special==108) { return 2; }
    if (special==109) { return 2; }
    if (special==110) { return 1; }
    if (special==111) { return 2; }
    if (special==112) { return 2; }
    if (special==113) { return 1; }
    if (special==114) { return 2; }
    if (special==115) { return 2; }
    if (special==116) { return 1; }
    if (special==117) { return 2; }
    if (special==118) { return 2; }
    if (special==119) { return 7; }
    if (special==120) { return 3; }
    if (special==121) { return 3; }
    if (special==122) { return 3; }
    if (special==123) { return 3; }
    if (special==128) { return 7; }
    if (special==129) { return 7; }
    if (special==130) { return 7; }
    if (special==131) { return 7; }
    if (special==132) { return 7; }
    if (special==133) { return 2; }
    if (special==134) { return 2; }
    if (special==135) { return 2; }
    if (special==136) { return 2; }
    if (special==137) { return 2; }
    if (special==138) { return 13; }
    if (special==139) { return 13; }
    if (special==140) { return 12; }
    return 0;
}

fn action_light(int special) -> int {
    if (special==12) { return 0-1; }
    if (special==13) { return 255; }
    if (special==17) { return 0-3; }
    if (special==35) { return 35; }
    if (special==79) { return 35; }
    if (special==80) { return 0-1; }
    if (special==81) { return 255; }
    if (special==104) { return 0-2; }
    if (special==138) { return 255; }
    if (special==139) { return 35; }
    return 32767;
}

fn manual_action(int special) -> bool {
    return special==1 || special==26 || special==27 || special==28 || special==31 || special==32 || special==33 || special==34 || special==117 || special==118;
}

fn action_s16(file data,int at) -> int {
    int value=file_read_little_uint16_at(data,at);
    if (value>=32768) { value-=65536; }
    return value;
}

fn action_floor(int room) -> int { return action_s16(action_wad,action_sector_base+room*26); }
fn action_roof(int room) -> int { return action_s16(action_wad,action_sector_base+room*26+2); }
fn action_tag(int room) -> int { return file_read_little_uint16_at(action_wad,action_sector_base+room*26+24); }

fn action_neighbor(int room,int line) -> int {
    int front=file_read_little_uint16_at(action_lines,line+10)-1;
    int back=file_read_little_uint16_at(action_lines,line+12)-1;
    if (front<0 || back<0 || front==back) { return 65535; }
    if (front==room) { return back; }
    if (back==room) { return front; }
    return 65535;
}

fn action_limits(int room) -> void {
    int floor=action_floor(room);
    int roof=action_roof(room);
    action_low=floor; action_high=floor; action_higher=32767;
    action_ceiling=roof; action_open=32767;
    int at=0; int end=file_size(action_lines); bool found=false;
    while (at<end) {
        int neighbor=action_neighbor(room,at);
        if (neighbor!=65535) {
            int f=action_floor(neighbor); int c=action_roof(neighbor);
            if (f<action_low) { action_low=f; }
            if (!found || f>action_high) { action_high=f; }
            if (f>floor && f<action_higher) { action_higher=f; }
            if (c<action_ceiling) { action_ceiling=c; }
            if (c<action_open) { action_open=c; }
            found=true;
        }
        at+=14;
    }
    if (found) { action_open-=4; } else { action_open=roof; }
}

fn append_change(int room,int floor,int roof) -> void {
    file_append_little_uint16(room,action_changes);
    file_append_little_uint16(floor,action_changes);
    file_append_little_uint16(roof,action_changes);
    file_seek_cursor(room,action_dynamic);
    file_write_uint8(1,action_dynamic);
}

fn first_neighbor(int room,int except) -> int {
    int at=0; int end=file_size(action_lines);
    while (at<end) {
        int next=action_neighbor(room,at);
        if (next!=65535 && next!=except) { return next; }
        at+=14;
    }
    return 65535;
}

fn same_flat(int room,int first) -> bool {
    int a=action_sector_base+room*26+4;
    int b=action_sector_base+first*26+4;
    return file_read_uint32_at(action_wad,a)==file_read_uint32_at(action_wad,b)
        && file_read_uint32_at(action_wad,a+4)==file_read_uint32_at(action_wad,b+4);
}

fn stair_neighbor(int room,int start,file seen) -> int {
    int at=0; int end=file_size(action_lines);
    while (at<end) {
        int next=action_neighbor(room,at);
        if (next!=65535) {
            if (file_read_uint8_at(seen,next)==0 && same_flat(next,start)) { return next; }
        }
        at+=14;
    }
    return 65535;
}

fn append_stairs(int room,int step) -> void {
    file seen=file_create("");
    int i=0;
    while (i<action_sector_count) { file_append_uint8(0,seen); i+=1; }
    int next=room; int height=action_floor(room);
    while (next!=65535) {
        file_seek_cursor(next,seen); file_write_uint8(1,seen);
        height+=step; append_change(next,height,32767);
        next=stair_neighbor(next,room,seen);
    }
    file_close(seen);
}

fn action_target(int room) -> void {
    int special=action_special;
    int motion=action_motion(special);
    if (motion==13) {
        action_flags=action_flags|16;
        append_change(room,action_light(special),32767);
        return;
    }
    action_limits(room);
    int floor=action_floor(room); int roof=action_roof(room);
    int f=32767; int c=32767;
    if (motion==1) { c=floor; }
    if (motion==2) { c=fmax(action_open,roof); }
    if (motion==3) { f=action_low; action_flags=action_flags|4; }
    if (motion==4) { f=action_low; }
    if (motion==5) { f=fmin(floor,action_high); }
    if (motion==6) {
        int target=action_high;
        if (floor!=target) { target+=8; }
        f=fmin(floor,target);
    }
    if (motion==7) { f=action_higher; }
    if (motion==8) { f=action_ceiling; }
    if (motion==9) { f=action_ceiling-8; }
    if (motion==10) { f=floor+24; }
    if (motion==11) { f=floor+32; }
    if (motion==12) { f=floor+512; }
    if (f!=32767 || c!=32767) { append_change(room,f,c); }
    if (special==7 || special==8) { append_stairs(room,8); }
    if (special==100 || special==127) { append_stairs(room,16); }
    if (special==9) {
        int ring=first_neighbor(room,65535);
        if (ring!=65535) {
            int rim=first_neighbor(ring,room);
            if (rim!=65535) {
                append_change(room,action_floor(rim),32767);
                append_change(ring,action_floor(rim),32767);
            }
        }
    }
}

fn sector_at_thing(int thing) -> int {
    int x=action_s16(action_wad,thing); int y=action_s16(action_wad,thing+2);
    float best=1000000.0; int room=65535;
    int at=0; int end=file_size(action_lines);
    while (at<end) {
        int y0=action_s16(action_lines,at+2); int y1=action_s16(action_lines,at+6);
        if ((y0<=y && y<y1) || (y1<=y && y<y0)) {
            int x0=action_s16(action_lines,at); int x1=action_s16(action_lines,at+4);
            float distance=x-x0-(y-y0)*1.0*(x1-x0)/(y1-y0);
            if (distance>=0.0 && distance<best) {
                best=distance;
                if (y1>y0) { room=file_read_little_uint16_at(action_lines,at+10)-1; }
                else { room=file_read_little_uint16_at(action_lines,at+12)-1; }
            }
        }
        at+=14;
    }
    return room;
}

fn action_warp(int tag) -> int {
    if (tag==0) { return 0; }
    int at=file_read_little_uint32_at(action_map,0);
    int end=at+file_read_little_uint32_at(action_map,4);
    while (at+10<=end) {
        if (file_read_little_uint16_at(action_wad,at+6)==14) {
            int room=sector_at_thing(at);
            if (room>=0 && room<action_sector_count) {
                if (action_tag(room)==tag) { return at; }
            }
        }
        at+=10;
    }
    return 0;
}

fn append_action(uint32 rule,int first,int patch_count,int warp) -> int {
    file_append_uint8(rule&255,action_records);
    file_append_uint8((rule>>8)&255,action_records);
    file_append_uint8((rule>>16)&255,action_records);
    if (warp!=0) { action_flags=action_flags|1; }
    file_append_uint8(action_flags,action_records);
    file_append_little_uint16(first,action_records);
    file_append_little_uint16(patch_count,action_records);
    if (warp!=0) {
        file_append_little_uint32(file_read_little_uint32_at(action_wad,warp),action_records);
        file_append_little_uint16(file_read_little_uint16_at(action_wad,warp+4),action_records);
    } else {
        file_append_little_uint32(0,action_records);
        file_append_little_uint16(0,action_records);
    }
    file_append_little_uint16(0,action_records);
    return file_size(action_records)/16;
}

fn append_trigger(int line,int action) -> void {
    int x=action_s16(action_lines,line); int y=action_s16(action_lines,line+2);
    file_append_little_uint16(x,action_triggers); file_append_little_uint16(y,action_triggers);
    file_append_little_uint16(action_s16(action_lines,line+4)-x,action_triggers);
    file_append_little_uint16(action_s16(action_lines,line+6)-y,action_triggers);
    file_append_little_uint16(action,action_triggers);
}

fn build_line_action(int raw,int line) -> int {
    action_special=file_read_little_uint16_at(action_wad,raw+6);
    uint32 rule=action_rule(action_special);
    if (rule==0) { return 0; }
    action_flags=rule>>24;
    int first=file_size(action_changes)/6;
    int tag=file_read_little_uint16_at(action_wad,raw+8);
    int warp=0;
    if (action_special==39 || action_special==97) { warp=action_warp(tag); }
    if (manual_action(action_special)) {
        int back=file_read_little_uint16_at(action_lines,line+12);
        if (back!=0) { action_target(back-1); }
    } else {
        if (tag!=0) {
            int room=0;
            while (room<action_sector_count) {
                if (action_tag(room)==tag) { action_target(room); }
                room+=1;
            }
        }
    }
    int count=file_size(action_changes)/6-first;
    if (count==0 && warp==0 && ((rule>>16)&255)==0) { return 0; }
    int id=append_action(rule,first,count,warp);
    if ((rule&255)==2) { append_trigger(line,id); }
    return id;
}

fn build_boss_action(int episode,int map) -> void {
    if (!((map==8 && episode<=4) || (map==6 && episode==4))) { return; }
    int first=file_size(action_changes)/6;
    int room=0;
    while (room<action_sector_count) {
        if (action_tag(room)==666) {
            action_limits(room);
            if (episode==4 && map==6) { append_change(room,32767,action_open); }
            else { append_change(room,action_low,32767); }
        }
        room+=1;
    }
    uint32 rule=8;
    if (episode==2 || episode==3) { rule=rule|65536; }
    action_flags=0;
    action_boss=append_action(rule,first,file_size(action_changes)/6-first,0);
}

fn wad_actions_build(file wad,file map,file lines,int episode,int mission) -> void {
    action_wad=wad; action_map=map; action_lines=lines;
    action_records=file_create(""); action_changes=file_create(""); action_triggers=file_create("");
    action_ids=file_create(""); action_dynamic=file_create(""); action_boss=0;
    action_sector_base=file_read_little_uint32_at(map,56);
    action_sector_count=file_read_little_uint32_at(map,60)/26;
    int room=0;
    while (room<action_sector_count) { file_append_uint8(0,action_dynamic); room+=1; }
    int raw=file_read_little_uint32_at(map,8); int line=0; int length=file_size(lines);
    while (line<length) {
        file_append_little_uint16(build_line_action(raw,line),action_ids);
        raw+=14; line+=14;
    }
    build_boss_action(episode,mission);
}

fn wad_action_records() -> file { return action_records; }
fn wad_action_changes() -> file { return action_changes; }
fn wad_action_triggers() -> file { return action_triggers; }
fn wad_action_ids() -> file { return action_ids; }
fn wad_action_dynamic() -> file { return action_dynamic; }
fn wad_boss_action() -> int { return action_boss; }

fn wad_actions_close() -> void {
    file_close(action_records); file_close(action_changes); file_close(action_triggers);
    file_close(action_ids); file_close(action_dynamic);
}



// doom-wad-geometry.steg

file geo_wad=0; file geo_lines=0; file geo_materials=0;
file geo_sectors=0; file geo_edges=0; file geo_flats=0; file geo_lights=0;
file geo_automap=0; file geo_line_map=0; file geo_edge_map=0;
file geo_actions=0; file geo_dynamic=0;
int geo_directory=0; int geo_sector_base=0; int geo_sides=0; int geo_raw_lines=0;
int geo_palette=0; int geo_secret_count=0;

fn geo_s16(file input,int at) -> int {
    int value=file_read_little_uint16_at(input,at);
    if (value>=32768) { value-=65536; }
    return value;
}

fn geo_side(int line,int side) -> int {
    return file_read_little_uint16_at(geo_wad,geo_raw_lines+line+10+side*2);
}

fn geo_linedef_special(int line) -> int {
    return file_read_little_uint16_at(geo_wad,geo_raw_lines+line+6);
}

fn geo_flat_color(int name,int light) -> uint32 {
    uint32 hi=file_read_uint32_at(geo_wad,name);
    uint32 lo=file_read_uint32_at(geo_wad,name+4);
    if (hi==1180652363 && lo==1496383488) { return 809193727; } // F_SKY1
    int entry=wad_find_lump(geo_wad,geo_directory,hi,lo);
    if (entry==0 || geo_palette==0) { return 1161969663; }
    int length=file_read_little_uint32_at(geo_wad,entry+4);
    if (length!=4096) { return 1161969663; }
    int at=file_read_little_uint32_at(geo_wad,entry);
    int end=at+length;
    int r=0; int g=0; int b=0;
    while (at<end) {
        int color=geo_palette+file_read_uint8_at(geo_wad,at)*3;
        r+=file_read_uint8_at(geo_wad,color);
        g+=file_read_uint8_at(geo_wad,color+1);
        b+=file_read_uint8_at(geo_wad,color+2);
        at+=4;
    }
    float shade=fmax(0.45,light/255.0)/1024.0;
    uint32 rr=r*shade+0.5;
    uint32 gg=g*shade+0.5;
    uint32 bb=b*shade+0.5;
    return (rr<<24)|(gg<<16)|(bb<<8)|255;
}

fn geo_flat_id(int at) -> int {
    return wad_atlas_asset(geo_wad,geo_directory,file_read_uint32_at(geo_wad,at),file_read_uint32_at(geo_wad,at+4),3);
}

fn append_sector(int sector,int first,int count) -> void {
    int at=geo_sector_base+sector*26;
    int light=file_read_little_uint16_at(geo_wad,at+20);
    int special=file_read_little_uint16_at(geo_wad,at+22);
    file_append_little_uint32(file_read_little_uint32_at(geo_wad,at),geo_sectors);
    file_append_little_uint16(first,geo_sectors);
    file_append_little_uint16(count,geo_sectors);
    file_append_uint8(light,geo_sectors);
    file_append_uint8(file_read_uint8_at(geo_dynamic,sector),geo_sectors);
    file_append_little_uint16(0,geo_sectors);
    file_append_uint32(geo_flat_color(at+4,light),geo_sectors);
    file_append_uint32(geo_flat_color(at+12,light),geo_sectors);
    bool sky=file_read_uint32_at(geo_wad,at+12)==1180652363 && file_read_uint32_at(geo_wad,at+16)==1496383488;
    if (sky) { file_append_uint8(1,geo_sectors); } else { file_append_uint8(0,geo_sectors); }
    if (special==4 || special==5 || special==7 || special==11 || special==16) {
        file_append_uint8(1,geo_sectors);
    } else { file_append_uint8(0,geo_sectors); }
    if (special==11) { file_append_uint8(255,geo_sectors); } else { file_append_uint8(0,geo_sectors); }
    if (special==9) { file_append_uint8(1,geo_sectors); geo_secret_count+=1; }
    else { file_append_uint8(0,geo_sectors); }
    file_append_uint8(special,geo_lights);
}

fn geo_manual(int special) -> bool {
    return special==1 || (special>=26 && special<=28) || (special>=31 && special<=34)
        || special==117 || special==118;
}

fn geo_switch_texture(int at) -> int {
    uint32 first=file_read_uint32_at(geo_wad,at);
    uint32 prefix=first>>8;
    if (prefix!=5461809 && prefix!=5461810) { return 0; } // SW1 / SW2
    uint32 last=file_read_uint32_at(geo_wad,at+4);
    return wad_atlas_asset(geo_wad,geo_directory,first^768,last,0);
}

fn append_edge_end(int line,int side,int sidedef,int id) -> void {
    int at=geo_sides+sidedef*30;
    int slot=0; int alt=0;
    int special=geo_linedef_special(line);
    if (id!=0 && side==0 && !geo_manual(special)) {
        alt=geo_switch_texture(at+4); if (alt!=0) { slot=12; }
        if (alt==0) { alt=geo_switch_texture(at+20); if (alt!=0) { slot=10; } }
        if (alt==0) { alt=geo_switch_texture(at+12); if (alt!=0) { slot=14; } }
    }
    int flags=file_read_little_uint16_at(geo_lines,line+8)&91;
    if (side==0 && special==1) { flags=flags|4; }
    if (side==0 && special==48) { flags=flags|128; }
    file_append_uint8(slot,geo_edges);
    file_append_uint8(flags,geo_edges);
    file_append_little_uint32(file_read_little_uint32_at(geo_wad,at),geo_edges);
    file_append_little_uint16(id,geo_edges);
    file_append_little_uint16(alt,geo_edges);
}

fn append_edge(int line,int side,int id) -> void {
    int first=line+side*4;
    int last=line+(1-side)*4;
    int x=geo_s16(geo_lines,first); int y=geo_s16(geo_lines,first+2);
    int vx=geo_s16(geo_lines,last)-x; int vy=geo_s16(geo_lines,last+2)-y;
    file_append_little_uint16(x+32768,geo_edges); file_append_little_uint16(y+32768,geo_edges);
    file_append_little_uint16(vx+32768,geo_edges); file_append_little_uint16(vy+32768,geo_edges);
    int length=sqrt(vx*1.0*vx+vy*1.0*vy)+0.5;
    file_append_little_uint16(length,geo_edges);
    int sidedef=geo_side(line,side);
    int material=sidedef*6;
    file_append_little_uint16(file_read_little_uint16_at(geo_materials,material+4),geo_edges);
    file_append_little_uint16(file_read_little_uint16_at(geo_materials,material),geo_edges);
    file_append_little_uint16(file_read_little_uint16_at(geo_materials,material+2),geo_edges);
    file_append_little_uint16(file_read_little_uint16_at(geo_lines,line+12-side*2),geo_edges);
    append_edge_end(line,side,sidedef,id);
    file_append_little_uint16(file_read_little_uint16_at(geo_line_map,line/7),geo_edge_map);
}

fn sector_edges(int sector) -> void {
    int line=0; int end=file_size(geo_lines);
    int first=file_size(geo_edges)/28;
    while (line<end) {
        int front=file_read_little_uint16_at(geo_lines,line+10);
        int back=file_read_little_uint16_at(geo_lines,line+12);
        if (front==sector+1 || back==sector+1) {
            int id=file_read_little_uint16_at(geo_actions,line/7);
            bool include=true;
            if (front==back && id==0) {
                int a=geo_side(line,0)*6+4; int b=geo_side(line,1)*6+4;
                if (file_read_little_uint16_at(geo_materials,a)==0 && file_read_little_uint16_at(geo_materials,b)==0) {
                    include=false;
                }
            }
            if (include) {
                if (front==sector+1) { append_edge(line,0,id); }
                if (back==sector+1) { append_edge(line,1,id); }
            }
        }
        line+=14;
    }
    append_sector(sector,first,file_size(geo_edges)/28-first);
}

fn geo_append_automap(int line,int front,int back,int special,int flags) -> int {
    if ((flags&128)!=0) { return 0; }
    if (back!=0 && (flags&1)==0 && special==0) {
        int a=geo_sector_base+(front-1)*26;
        int b=geo_sector_base+(back-1)*26;
        if (file_read_little_uint32_at(geo_wad,a)==file_read_little_uint32_at(geo_wad,b)) { return 0; }
    }
    file_append_little_uint32(file_read_little_uint32_at(geo_lines,line),geo_automap);
    file_append_little_uint32(file_read_little_uint32_at(geo_lines,line+4),geo_automap);
    int kind=1;
    if (back!=0) { kind=2; }
    if (special==11) { kind=3; }
    file_append_uint8(kind,geo_automap);
    file_append_uint8((flags>>8)&1,geo_automap);
    return file_size(geo_automap)/10;
}

fn wad_geometry_build(file wad,uint32 directory,file map,file lines,file materials) -> void {
    geo_wad=wad; geo_directory=directory; geo_lines=lines; geo_materials=materials;
    geo_sector_base=file_read_little_uint32_at(map,56);
    geo_sides=file_read_little_uint32_at(map,16);
    geo_raw_lines=file_read_little_uint32_at(map,8);
    geo_actions=wad_action_ids(); geo_dynamic=wad_action_dynamic();
    int pal=wad_find_lump(wad,directory,1347174745,1346456576);
    geo_palette=0;
    if (pal!=0) {
        if (file_read_little_uint32_at(wad,pal+4)>=768) { geo_palette=file_read_little_uint32_at(wad,pal); }
    }
    geo_sectors=file_create(""); geo_edges=file_create(""); geo_lights=file_create("");
    geo_flats=file_create(""); geo_automap=file_create(""); geo_line_map=file_create(""); geo_edge_map=file_create("");
    geo_secret_count=0;
    int line=0; int end=file_size(lines);
    while (line<end) {
        int front=file_read_little_uint16_at(lines,line+10);
        int back=file_read_little_uint16_at(lines,line+12);
        int flags=file_read_little_uint16_at(lines,line+8);
        file_append_little_uint16(geo_append_automap(line,front,back,geo_linedef_special(line),flags),geo_line_map);
        line+=14;
    }
    int count=file_read_little_uint32_at(map,60)/26;
    int room=0;
    while (room<count) { sector_edges(room); room+=1; }
    room=0;
    while (room<count) {
        int at=geo_sector_base+room*26;
        file_append_little_uint16(geo_flat_id(at+4),geo_flats);
        file_append_little_uint16(geo_flat_id(at+12),geo_flats);
        room+=1;
    }
    file_close(geo_line_map);
}

fn wad_geometry_sectors() -> file { return geo_sectors; }
fn wad_geometry_edges() -> file { return geo_edges; }
fn wad_geometry_flats() -> file { return geo_flats; }
fn wad_geometry_lights() -> file { return geo_lights; }
fn wad_geometry_automap() -> file { return geo_automap; }
fn wad_geometry_edge_map() -> file { return geo_edge_map; }
fn wad_geometry_secrets() -> int { return geo_secret_count; }

fn wad_geometry_close() -> void {
    file_close(geo_sectors); file_close(geo_edges); file_close(geo_flats); file_close(geo_lights);
    file_close(geo_automap); file_close(geo_edge_map);
}


// doom-wad-art.steg

fn append_ui_pixels(file image,file pixels,int width,int height) -> void {
    int y=0;
    while (y<height) {
        int x=0;
        while (x<width) {
            file_append_little_uint16(file_read_little_uint16_at(image,4+(x*height+y)*2),pixels);
            x+=1;
        }
        y+=1;
    }
}

fn add_ui_image(file image,file headers,file pixels) -> void {
    if (file_size(image)<6) {
        file_append_little_uint32(0,headers);
        file_append_little_uint32(0,headers);
    } else {
        int width=file_read_little_uint16_at(image,0);
        int height=file_read_little_uint16_at(image,2);
        file_append_little_uint32(file_size(pixels),headers);
        file_append_little_uint16(width,headers);
        file_append_little_uint16(height,headers);
        append_ui_pixels(image,pixels,width,height);
    }
    file_close(image);
}

fn add_ui(file wad,uint32 directory,file headers,file pixels,uint32 first,uint32 last) -> void {
    int index=file_size(headers)/8;
    if (index>=159 && index<=162) {
        add_ui_image(wad_flat(wad,directory,first,last),headers,pixels);
    } else { add_ui_image(wad_patch(wad,directory,first,last,false),headers,pixels); }
}

