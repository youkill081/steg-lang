fn find_actor(file catalog,int type) -> int {
    int at=0; int end=file_size(catalog);
    while (at<end) {
        if (file_read_little_uint16_at(catalog,at)==type) { return at; }
        at+=16;
    }
    return end;
}

fn append_actor(file wad,file catalog,int thing,int def,file actors,file traits) -> void {
    int type=file_read_little_uint16_at(wad,thing+6);
    int flags=file_read_little_uint16_at(wad,thing+8);
    file_append_uint8(file_read_uint8_at(catalog,def+2),actors);
    file_append_uint8(file_read_uint8_at(catalog,def+3),actors);
    file_append_uint8(file_read_uint8_at(catalog,def+13),actors);
    int spawn=flags&7;
    if (type==3002 || type==58) { spawn=spawn|32; }
    file_append_uint8(spawn,actors);
    file_append_little_uint16(0,actors);

    file_append_little_uint16(type,traits);
    file_append_uint8(file_read_uint8_at(catalog,def+12),traits);
    int behavior=file_read_uint8_at(catalog,def+14);
    if ((flags&8)!=0) { behavior=behavior|2; }
    file_append_uint8(behavior,traits);
    file_append_little_uint16(file_read_little_uint16_at(wad,thing+4),traits);
    file_append_uint8(file_read_uint8_at(catalog,def+15),traits);
    file_append_uint8(0,traits);
}

fn wad_player_start(file wad,file map) -> uint32 {
    if (file_size(map)!=80) { return 0; }
    uint32 at=file_read_little_uint32_at(map,0);
    uint32 length=file_read_little_uint32_at(map,4);
    if (length%10!=0) { return 0; }
    uint32 end=at+length;
    while (at<end) {
        if (file_read_little_uint16_at(wad,at+6)==1) { return at; }
        at+=10;
    }
    return 0;
}

fn wad_actors(file wad,uint32 directory,file map,int boss,file actors,file traits) -> void {
    if (file_size(map)!=80) { return; }
    int at=file_read_little_uint32_at(map,0);
    int length=file_read_little_uint32_at(map,4);
    if (length%10!=0) { return; }
    file catalog=doom_actor_catalog();
    int end=at+length;
    while (at<end) {
        int type=file_read_little_uint16_at(wad,at+6);
        int flags=file_read_little_uint16_at(wad,at+8);
        int def=find_actor(catalog,type);
        if ((flags&7)!=0 && (flags&16)==0 && def<file_size(catalog)) {
            int sprite=wad_atlas_asset(wad,directory,file_read_uint32_at(catalog,def+4),file_read_uint32_at(catalog,def+8),1);
            if (sprite!=0) {
                int row=file_size(actors);
                file_append_little_uint32(file_read_little_uint32_at(wad,at),actors);
                file_append_little_uint16(sprite,actors);
                append_actor(wad,catalog,at,def,actors,traits);
                if (boss==type) {
                    file_seek_cursor(row+9,actors);
                    file_write_uint8(file_read_uint8_at(actors,row+9)|64,actors);
                }
            }
        }
        at+=10;
    }
    file_close(catalog);
}



// doom-wad-frames.steg

file frame_enemy=0; file frame_hostile=0; file frame_barrel=0;
file frame_imp=0; file frame_extra=0;
int frame_sky=0;

fn append_asset_frame(file wad,uint32 directory,file output,uint32 first,uint32 last) -> void {
    file_append_little_uint16(wad_atlas_asset(wad,directory,first,last,1),output);
}

fn frame_offset(file wad,uint32 directory,file output,uint32 first,uint32 last) -> void {
    uint32 entry=wad_find_lump(wad,directory,first,last);
    uint32 value=0;
    if (entry!=0) {
        if (file_read_little_uint32_at(wad,entry+4)>=8) {
            value=file_read_little_uint32_at(wad,file_read_little_uint32_at(wad,entry)+4);
        }
    }
    file_append_little_uint32(value,output);
}

fn hostile_sprite(file wad,uint32 directory,uint32 prefix,int frame_code) -> int {
    int at=directory;
    int end=directory+file_read_little_uint32_at(wad,4)*16;
    while (at<end) {
        if (file_read_uint32_at(wad,at+8)==prefix && file_read_uint8_at(wad,at+12)==frame_code) {
            int angle=file_read_uint8_at(wad,at+13);
            if (angle==48 || angle==49) {
                return wad_atlas_asset(wad,directory,prefix,file_read_uint32_at(wad,at+12),1);
            }
        }
        at+=16;
    }
    return 0;
}

