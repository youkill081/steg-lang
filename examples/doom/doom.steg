fn ray_setup(float x, float y, float vx, float vy) -> void {
    ray_x=x; ray_y=y; ray_vx=vx; ray_vy=vy; sight_rise=0.0;
}

fn signed_word(file f, int at) -> int {
    int n = file_read_little_uint16_at(f, at);
    if (n >= 32768) { n -= 65536; }
    return n;
}

fn sector_at(float x, float y) -> int {
    if (x < origin_x || y < origin_y) { return -1; }
    int col = (x-origin_x) / 8.0;
    int row = (y-origin_y) / 8.0;
    if (col >= grid_w || row >= grid_h) { return -1; }
    return file_read_little_uint16_at(data, grid + (row * grid_w + col)*2) - 1;
}

fn floor_of(int id) -> int {
    int pos = sectors + id * 24;
    if (file_read_uint8_at(data,pos+9)>0) { return signed_word(sector_state,id*12); }
    return signed_word(data, pos);
}

fn ceiling_of(int id) -> int {
    int pos = sectors + id * 24;
    if (file_read_uint8_at(data,pos+9)>0) { return signed_word(sector_state,id*12+2); }
    return signed_word(data, pos+2);
}

// The directed edges of a sector face inward. Only outward crossings
// can advance the ray. 'after' excludes the portal just traversed.
fn crossing(int id, float after, float limit) -> float {
    int pos = sectors + id * 24;
    int begin = edges + file_read_little_uint16_at(data, pos+4) * 28;
    int end = begin + file_read_little_uint16_at(data, pos+6) * 28;
    edge_hit = -1;
    while (begin < end) {
        uint32 vector=file_read_little_uint32_at(data,begin+4);
        int ex=(vector&65535)-32768;
        int ey=(vector>>16)-32768;
        float det = ray_vx*ey - ray_vy*ex;
        if (det < -0.001) {
            uint32 point=file_read_little_uint32_at(data,begin);
            int ix=(point&65535)-32768;
            int iy=(point>>16)-32768;
            float ax=ix-ray_x;
            float ay=iy-ray_y;
            float u=ax*ray_vy-ay*ray_vx;
            if (u>=det-0.001 && u<=0.001) {
                float t=(ax*ey-ay*ex)/det;
                if (t>after && t<limit) {
                    limit=t; edge_hit=begin; hit_u=u/det;
                }
            }
        }
        begin += 28;
    }
    return limit;
}

fn native_crossing(void @ray_job,int id,float after) -> float {
    uint32 @words=ray_job;
    float @floats=ray_job;
    int sector_info=sectors+id*24;
    int begin=edges+file_read_little_uint16_at(data,sector_info+4)*28;
    words[0]=begin;
    words[1]=file_read_little_uint16_at(data,sector_info+6);
    floats[8]=after;
    uint32 hit=raycast_segments(words,data);
    edge_hit=-1;
    if (hit!=4294967295) {
        edge_hit=begin+hit*28;
        hit_u=floats[12];
        return floats[11];
    }
    return 2400.0;
}


int ground_floor=0;
int fit_ceiling=0;

fn consider_room(int room) -> bool {
    if (room<0) { return false; }
    int f=floor_of(room);
    int c=ceiling_of(room);
    if (f>ground_floor) { ground_floor=f; }
    if (c<fit_ceiling) { fit_ceiling=c; }
    return c-f>=46;
}

fn support(float x,float y,float r) -> bool {
    ground_floor=-32768; fit_ceiling=32767;
    return consider_room(sector_at(x-r,y-r)) && consider_room(sector_at(x+r,y-r))
        && consider_room(sector_at(x-r,y+r)) && consider_room(sector_at(x+r,y+r))
        && fit_ceiling-ground_floor>=46;
}

fn clear_at(float x, float y, float r, int old_floor) -> bool {
    return support(x,y,r) && ground_floor<=old_floor+24;
}

fn visible(int start, float eye) -> bool {
    if (start < 0) { return false; }
    float after = -0.02;
    int n = 0;
    while (n < 20) {
        float t = crossing(start,after,1.0);
        if (edge_hit < 0 || t >= 0.999) { return true; }
        int next = file_read_little_uint16_at(data,edge_hit+16)-1;
        float aim=eye+sight_rise*t;
        if (next < 0 || floor_of(next) > aim || ceiling_of(next) <= aim) { return false; }
        after = t + 0.002;
        start = next;
        n += 1;
    }
    return false;
}

fn notify(int n) -> void { info = n; info_time = 2.6; }

fn doom_random() -> int {
    random_index=(random_index+1)&255;
    return file_read_uint8_at(doom_random_data,random_index);
}

fn clear_tick_input() -> void {
    tick_held=0; tick_edges=0; tick_mouse_x=0;
    tick_forward=0.0; tick_side=0.0;
    tick_angleturn=0; turn_held_tics=0;
}

fn counted_item(int kind) -> bool {
    return kind==15 || kind==17 || kind==18 || kind==24 || kind==26 || kind==27 || kind==35 || kind==36;
}

fn sync_classic_position() -> void {
    classic_x=px*65536.0; classic_y=py*65536.0;
    float direction=angle*10430.37835047045;
    if (direction>=0.0) { classic_heading=direction+0.5; }
    else { classic_heading=direction-0.5; }
    classic_heading=classic_heading&65535;
    classic_momx=0; classic_momy=0;
}

fn reset() -> void {
    level_tic=0; damage_count=0; tic_clock=0.0;
    death_tics=0; death_attacker=-1; death_weapon_y=0; death_viewheight=41.0;
    clear_tick_input();
    keys=0; secret_exit=false; boss_action=initial_boss;
    computer_map=false;
    backpack=false; suit_time=0.0; light_time=0.0; shadow_time=0.0;
    file_clear_data(sector_state); file_reset_cursor(sector_state);
    file_clear_data(used_actions); file_reset_cursor(used_actions);
    file_clear_data(button_times); file_reset_cursor(button_times);
    int id=0;
    while(id<(edges-sectors)/24) {
        file_append_little_uint16(file_read_little_uint16_at(data,sectors+id*24),sector_state);
        file_append_little_uint16(file_read_little_uint16_at(data,sectors+id*24+2),sector_state);
        file_append_little_uint16(0,sector_state);
        file_append_little_uint16(file_read_little_uint16_at(data,sectors+id*24),sector_state);
        file_append_little_uint16(file_read_little_uint16_at(data,sectors+id*24+2),sector_state);
        file_append_little_uint16(0,sector_state);
        id+=1;
    }
    id=0;
    while(id<action_count) { file_append_uint8(0,used_actions); file_append_little_uint32(0,button_times); id+=1; }
    px = signed_word(data,map_base+12);
    py = signed_word(data,map_base+14);
    sector = sector_at(px,py);
    if (sector<0) { print_str("Depart E1M1 hors carte."); exit(2); }
    lift = false; motion_clock=0.0;
    horizon = 64.0;
    angle = deg2rad(file_read_little_uint16_at(data,map_base+16));
    dx = cos(angle); dy = sin(angle);
    sync_classic_position();
    feet_z=floor_of(sector); pz=feet_z+41.0; eye_z=pz;
    move_vx=0.0; move_vy=0.0; sway=0.0; bonus_count=0; bonus_clock=0.0;
    hp = 100; armor = 0; armor_type=0; ammo = 50; shells = 0; kills = 0;
    shotgun = false; has_shotgun = false; won = false; map_open = false;
    chaingun=false; has_chaingun=false; chaingun_frame=0;
    extra_weapon=0; has_chainsaw=false; has_launcher=false; rockets=0;
    cells=0; has_plasma=false; has_bfg=false; berserk_tics=0; invulnerability_tics=0;
    bfg_windup=0; plasma_frame=0; bullet_streak=0;
    saw_frame=0; extra_anim=false; attack_was_down=false;
    cooldown = 0.0; flash = 0.0; hurt = 0.0; bob = 0.0; t_game = 0.0;
    file_clear_data(things); file_reset_cursor(things);
    file_clear_data(imp_shots); file_reset_cursor(imp_shots);
    file_clear_data(imp_sources); file_reset_cursor(imp_sources);
    file_clear_data(hostile_shots); file_reset_cursor(hostile_shots);
    file_clear_data(monster_state); file_reset_cursor(monster_state);
    int at = 0;
    while (at < count*12) {
        file_append_uint8(file_read_uint8_at(data,actor_base+at), things);
        at += 1;
    }
    at=0;
    while (at<count) {
        file_append_little_uint16(file_read_little_uint16_at(data,actor_traits+at*8+4),monster_state);
        file_append_little_uint16(0,monster_state);
        file_append_little_uint32(0,monster_state);
        file_append_little_uint16(0,monster_state);
        file_append_little_uint16(0,monster_state);
        at+=1;
    }
    gathered=0; total_kills=0; total_items=0; secrets=0;
    file_clear_data(explored); file_reset_cursor(explored);
    file_clear_data(map_discovery); file_reset_cursor(map_discovery);
    int map_row=0;
    while (map_row<map_count) {
        file_append_uint8(file_read_uint8_at(data,map_index+map_row*10+9),map_discovery);
        map_row+=1;
    }
    int room=0;
    while (room<(edges-sectors)/24) { file_append_uint8(0,explored); room+=1; }
    int row=0;
    while (row<count*12) {
        int kind=file_read_uint8_at(things,row+6);
        int mask=2;
        if (difficulty<=1) { mask=1; }
        if (difficulty>=3) { mask=4; }
        if ((file_read_uint8_at(things,row+9)&mask)==0) {
            file_seek_cursor(row+6,things);
            file_write_uint8(10,things);
            file_write_uint8(0,things);
            kind=10;
        }
        if (kind<=4) { total_kills+=1; }
        if (counted_item(kind)) { total_items+=1; }
        row+=12;
    }

    notify(1);
}

fn coordinate(float value) -> int {
    int result = value;
    if (result < 0) { result += 65536; }
    return result;
}

