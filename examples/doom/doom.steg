fn build_sine_data() -> file {
    file table=file_create("");
    int i=0;
    while (i<8192) {
        int sample=sin((i+0.5)*0.00076699039394282)*65536.0;
        file_append_little_uint32(sample,table);
        i+=1;
    }
    // Correct the float rounding at the vanilla fixed-point table boundaries.
    file_seek_cursor(3084,table); file_write_little_uint32(36555,table);
    file_seek_cursor(3532,table); file_write_little_uint32(41087,table);
    file_seek_cursor(5092,table); file_write_little_uint32(54308,table);
    file_seek_cursor(9072,table); file_write_little_uint32(64600,table);
    file_seek_cursor(12060,table); file_write_little_uint32(48304,table);
    file_seek_cursor(14560,table); file_write_little_uint32(22433,table);
    file_seek_cursor(15288,table); file_write_little_uint32(13646,table);
    file_seek_cursor(15404,table); file_write_little_uint32(12218,table);
    file_seek_cursor(15924,table); file_write_little_uint32(5748,table);
    file_seek_cursor(17632,table); file_write_little_uint32(4294951739,table);
    file_seek_cursor(18900,table); file_write_little_uint32(4294936870,table);
    file_seek_cursor(18908,table); file_write_little_uint32(4294936781,table);
    file_seek_cursor(18964,table); file_write_little_uint32(4294936160,table);
    file_seek_cursor(19468,table); file_write_little_uint32(4294930741,table);
    file_seek_cursor(19836,table); file_write_little_uint32(4294926997,table);
    file_seek_cursor(19916,table); file_write_little_uint32(4294926209,table);
    file_seek_cursor(20652,table); file_write_little_uint32(4294919436,table);
    file_seek_cursor(20696,table); file_write_little_uint32(4294919060,table);
    file_seek_cursor(20704,table); file_write_little_uint32(4294918992,table);
    file_seek_cursor(21324,table); file_write_little_uint32(4294914080,table);
    file_seek_cursor(21420,table); file_write_little_uint32(4294913385,table);
    file_seek_cursor(23076,table); file_write_little_uint32(4294904446,table);
    file_seek_cursor(25456,table); file_write_little_uint32(4294902695,table);
    file_seek_cursor(26888,table); file_write_little_uint32(4294908107,table);
    file_seek_cursor(27040,table); file_write_little_uint32(4294908951,table);
    file_seek_cursor(27200,table); file_write_little_uint32(4294909894,table);
    file_seek_cursor(27500,table); file_write_little_uint32(4294911807,table);
    file_seek_cursor(27532,table); file_write_little_uint32(4294912022,table);
    file_seek_cursor(28444,table); file_write_little_uint32(4294918991,table);
    file_seek_cursor(28452,table); file_write_little_uint32(4294919059,table);
    file_seek_cursor(29680,table); file_write_little_uint32(4294930740,table);
    file_seek_cursor(31156,table); file_write_little_uint32(4294947384,table);
    file_seek_cursor(32352,table); file_write_little_uint32(4294962099,table);
    file_seek_cursor(32504,table); file_write_little_uint32(4294964005,table);
    file_reset_cursor(table);
    return table;
}

