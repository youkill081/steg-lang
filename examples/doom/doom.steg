fn wad_frames_build(file wad,uint32 directory,int episode) -> void {
    frame_enemy=file_create(""); frame_hostile=file_create(""); frame_barrel=file_create("");
    frame_imp=file_create(""); frame_extra=file_create("");
    build_hostile_frames(wad,directory,frame_hostile);
    build_imp_frames(wad,directory,frame_imp); build_barrel_frames(wad,directory,frame_barrel);
    build_extra_frames(wad,directory,frame_extra);
    build_weapon_offsets(wad,directory,frame_extra);
    build_energy_frames(wad,directory,frame_extra); build_energy_offsets(wad,directory,frame_extra);
    build_energy_missiles(wad,directory,frame_extra); build_bullet_frames(wad,directory,frame_extra);
    frame_sky=wad_atlas_asset(wad,directory,1397446960+episode,0,0);
    if (frame_sky==0 && episode==4) { frame_sky=wad_atlas_asset(wad,directory,1397446963,0,0); }
    if (frame_sky==0) { frame_sky=wad_atlas_asset(wad,directory,1397446961,0,0); }
    build_enemy_frames(wad,directory,frame_enemy);
    file_append_little_uint32(0,frame_enemy); file_append_little_uint32(0,frame_enemy);
}

fn wad_frame_sky() -> int { return frame_sky; }
fn wad_frame_enemy() -> file { return frame_enemy; }
fn wad_frame_hostile() -> file { return frame_hostile; }
fn wad_frame_barrel() -> file { return frame_barrel; }
fn wad_frame_imp() -> file { return frame_imp; }
fn wad_frame_extra() -> file { return frame_extra; }

fn wad_frames_close() -> void {
    file_close(frame_enemy); file_close(frame_hostile); file_close(frame_barrel);
    file_close(frame_imp); file_close(frame_extra);
}



// doom-wad-animations.steg

file anim_wad=0; file anim_rows=0; file anim_frames=0;
int anim_directory=0;

fn anim_find_name(file names,uint32 first,uint32 last) -> int {
    int at=0; int end=file_size(names);
    while (at<end) {
        if (file_read_uint32_at(names,at)==first && file_read_uint32_at(names,at+4)==last) { return at; }
        at+=8;
    }
    return end;
}

fn anim_texture_names(file names,uint32 lump) -> void {
    if (lump==0) { return; }
    uint32 base=file_read_little_uint32_at(anim_wad,lump);
    uint32 length=file_read_little_uint32_at(anim_wad,lump+4);
    if (length<4) { return; }
    uint32 count=file_read_little_uint32_at(anim_wad,base);
    if (count>(length-4)/4) { return; }
    int i=0;
    while (i<count) {
        uint32 offset=file_read_little_uint32_at(anim_wad,base+4+i*4);
        if (offset<=length && length-offset>=8) {
            uint32 hi=file_read_uint32_at(anim_wad,base+offset);
            uint32 lo=file_read_uint32_at(anim_wad,base+offset+4);
            if (anim_find_name(names,hi,lo)==file_size(names)) {
                file_append_uint32(hi,names); file_append_uint32(lo,names);
            }
        }
        i+=1;
    }
}

fn anim_flat_names(file names) -> void {
    int start=wad_find_lump(anim_wad,anim_directory,1180652372,1095914496);
    int end=wad_find_lump(anim_wad,anim_directory,1180648782,1140850688);
    if (start==0 || end<=start) { return; }
    start+=16;
    while (start<end) {
        file_append_uint32(file_read_uint32_at(anim_wad,start+8),names);
        file_append_uint32(file_read_uint32_at(anim_wad,start+12),names);
        start+=16;
    }
}

fn anim_enabled(file names,int start,int end,int kind) -> bool {
    while (start<=end) {
        if (wad_atlas_registered(file_read_uint32_at(names,start),file_read_uint32_at(names,start+4),kind)) {
            return true;
        }
        start+=8;
    }
    return false;
}

fn anim_emit(file names,int start,int end,int kind) -> void {
    file sequence=file_create("");
    int at=start;
    while (at<=end) {
        int id=wad_atlas_asset(anim_wad,anim_directory,file_read_uint32_at(names,at),file_read_uint32_at(names,at+4),kind);
        if (id==0) { file_close(sequence); return; }
        file_append_little_uint16(id,sequence);
        at+=8;
    }
    int frame=file_size(anim_frames)/2;
    int count=file_size(sequence)/2;
    int i=0;
    while (i<count) {
        int id=file_read_little_uint16_at(sequence,i*2);
        file_append_little_uint16(id,anim_frames);
        file_append_little_uint16(id,anim_rows);
        file_append_little_uint16(frame,anim_rows);
        file_append_uint8(count,anim_rows);
        file_append_uint8((start/8+i)%count,anim_rows);
        i+=1;
    }
    file_close(sequence);
}

fn anim_rule(file names,uint32 a,uint32 b,uint32 c,uint32 d,int kind) -> void {
    int start=anim_find_name(names,a,b);
    int end=anim_find_name(names,c,d);
    if (end<=start || end==file_size(names) || (end-start)/8>=255) { return; }
    if (anim_enabled(names,start,end,kind)) { anim_emit(names,start,end,kind); }
}

fn wall_anim_rules(file names,int kind) -> void {
    anim_rule(names,1112297284,1196568832,1112297284,1196569600,kind);
    anim_rule(names,1397506372,1380536369,1397506372,1380536371,kind);
    anim_rule(names,1112297284,1380536369,1112297284,1380536372,kind);
    anim_rule(names,1179210309,1463897153,1179210309,1463897164,kind);
    anim_rule(names,1196643398,1330533425,1196643398,1330533427,kind);
    anim_rule(names,1179210309,1279350323,1179210309,1279350337,kind);
    anim_rule(names,1179210309,1296123697,1179210309,1296123699,kind);
    anim_rule(names,1179210309,1112298801,1179210309,1112298802,kind);
    anim_rule(names,1380926283,1380271153,1380926283,1380271155,kind);
    anim_rule(names,1111900492,1278279680,1111900492,1278476288,kind);
    anim_rule(names,1397113164,1278279680,1397113164,1278476288,kind);
    anim_rule(names,1464222028,1278279680,1464222028,1278476288,kind);
    anim_rule(names,1145197121,1229861120,1145197121,1229861888,kind);
}
fn flat_anim_rules(file names,int kind) -> void {
    anim_rule(names,1314212673,1195716864,1314212673,1195717376,kind);
    anim_rule(names,1180123476,1163014400,1180123476,1163015168,kind);
    anim_rule(names,1398227284,1163014400,1398227284,1163015168,kind);
    anim_rule(names,1279350337,822083584,1279350337,872415232,kind);
    anim_rule(names,1112297295,1144061952,1112297295,1144193024,kind);
    anim_rule(names,1381125955,1261450496,1381125955,1261451264,kind);
    anim_rule(names,1397508429,1160786176,1397508429,1160786944,kind);
    anim_rule(names,1397508429,1160787200,1397508429,1160787968,kind);
    anim_rule(names,1397508429,1160788224,1397508429,1160851968,kind);
}

fn wad_animations_build(file wad,uint32 directory) -> void {
    anim_wad=wad; anim_directory=directory;
    anim_rows=file_create(""); anim_frames=file_create("");
    file names=file_create("");
    anim_texture_names(names,wad_find_lump(wad,directory,1413830740,1431455025));
    anim_texture_names(names,wad_find_lump(wad,directory,1413830740,1431455026));
    wall_anim_rules(names,0);
    file_clear_data(names); file_reset_cursor(names);
    anim_flat_names(names);
    flat_anim_rules(names,3);
    file_close(names);
}

fn wad_animation_table() -> file {
    file table=file_create("");
    int n=file_size(wad_atlas_metadata())/8;
    while (n>0) { file_append_little_uint32(0,table); n-=1; }
    int at=0; int end=file_size(anim_rows);
    while (at<end) {
        int id=file_read_little_uint16_at(anim_rows,at);
        file_seek_cursor((id-1)*4,table);
        file_write_little_uint32(file_read_little_uint32_at(anim_rows,at+2),table);
        at+=6;
    }
    return table;
}
fn wad_animation_frames() -> file { return anim_frames; }

fn wad_animations_close() -> void { file_close(anim_frames); file_close(anim_rows); }



// doom-wad-build.steg

file build_wad=0; file build_map=0; file build_output=0;
int build_directory=0; int build_base=0;
uint32 build_wad_hash=0;

fn wad_save_identity(file wad) -> void {
    uint32 hash=2166136261;
    uint32 at=0;
    uint32 size=file_size(wad);
    while (size-at>=4) {
        hash=(hash^file_read_uint32_at(wad,at))*16777619;
        at+=4;
    }
    while (at<size) {
        hash=(hash^file_read_uint8_at(wad,at))*16777619;
        at+=1;
    }
    build_wad_hash=hash;
}

fn build_append(file source,uint32 start,uint32 count) -> void {
    uint32 end=start+count;
    while (end-start>=4) {
        file_append_uint32(file_read_uint32_at(source,start),build_output);
        start+=4;
    }
    while (start<end) {
        file_append_uint8(file_read_uint8_at(source,start),build_output);
        start+=1;
    }
}

fn build_empty(int words) -> void {
    while (words>0) { file_append_little_uint32(0,build_output); words-=1; }
}

fn build_word(int at,uint32 value) -> void {
    file_seek_cursor(at,build_output); file_write_little_uint32(value,build_output);
}

fn map_word(int at,uint32 value) -> void { build_word(build_base+at,value); }
fn map_half(int at,int value) -> void {
    file_seek_cursor(build_base+at,build_output); file_write_little_uint16(value,build_output);
}

fn build_here(int at) -> void { map_word(at,file_size(build_output)-build_base); }

fn build_section(int at,file section) -> void {
    build_here(at);
    build_append(section,0,file_size(section));
}

fn build_lump(int at,int index) -> void {
    build_here(at);
    build_append(build_wad,file_read_little_uint32_at(build_map,index*8),file_read_little_uint32_at(build_map,index*8+4));
}

fn build_boss(int episode,int mission) -> int {
    if (episode==1 && mission==8) { return 3003; }
    if (episode==2 && mission==8) { return 16; }
    if (episode==3 && mission==8) { return 7; }
    if (episode==4 && mission==6) { return 16; }
    if (episode==4 && mission==8) { return 7; }
    return 0;
}

fn build_spawn(file bounds,int start,int count) -> void {
    int i=0;
    while (i<4) {
        map_half(4+i*2,file_read_little_uint32_at(bounds,i*4));
        i+=1;
    }
    map_word(12,file_read_little_uint32_at(build_wad,start));
    map_half(16,file_read_little_uint16_at(build_wad,start+4));
    map_half(18,count);
}

fn build_sprite(int at,uint32 first,uint32 last) -> void {
    map_half(at,wad_atlas_asset(build_wad,build_directory,first,last,1));
}

fn build_frame_header() -> void {
    build_sprite(44,1346982727,1093664768);
    build_sprite(46,1346982726,1093664768);
    build_sprite(48,1397249095,1093664768);
    build_sprite(50,1397249094,1093664768);
    build_sprite(52,1347375955,1278214144);
    build_sprite(54,1111840848,1127219200);
    build_sprite(56,1397247828,1093664768);
    int sky=wad_frame_sky();
    map_half(76,sky);
    if (sky!=0) {
        file meta=wad_atlas_metadata();
        int at=(sky-1)*8;
        map_word(112,file_read_little_uint32_at(meta,at+4));
        map_word(116,file_read_little_uint32_at(meta,at));
    }
}

fn build_geometry_sections(file grid,file actors,file ui) -> void {
    build_section(20,wad_geometry_sectors());
    build_section(24,wad_geometry_edges());
    build_section(28,grid);
    build_section(32,actors);
    build_section(36,wad_atlas_metadata());
    build_here(40);
    build_section(64,ui);
    build_here(68);
    build_section(72,wad_geometry_flats());
    build_section(80,wad_geometry_automap());
    map_half(84,file_size(wad_geometry_automap())/10);
    map_half(86,wad_geometry_secrets());
}

fn build_event_sections() -> void {
    build_section(88,wad_frame_enemy());
    build_section(92,wad_action_records());
    build_section(96,wad_action_changes());
    build_section(100,wad_action_triggers());
    map_half(104,file_size(wad_action_triggers())/10);
    map_half(106,wad_boss_action());
    map_half(108,file_size(wad_action_records())/16);
    build_section(120,wad_frame_barrel());
    build_section(124,wad_frame_imp());
    build_section(128,wad_frame_extra());
}

fn build_spatial_sections(file lines,file leaves,file traits,file rotations) -> void {
    build_section(140,wad_geometry_lights());
    build_section(148,wad_atlas_sprite_offsets());
    build_section(144,wad_geometry_edge_map());
    build_lump(152,9);
    build_section(156,lines);
    build_lump(160,6);
    build_section(164,leaves);
    build_section(168,traits);
    build_section(172,wad_frame_hostile());
    build_lump(176,8);
    map_word(180,file_read_little_uint32_at(build_map,68));
    build_section(184,rotations);
    // Native ray tests use the sector edges directly.
    build_here(188);
    build_empty(file_size(wad_geometry_sectors())/12);
    build_here(192); build_here(196);
    build_here(200);
    build_empty(file_size(wad_atlas_metadata())/8);
}

fn build_resources(file lines,file bounds,file leaves,int episode,int mission) -> void {
    file grid=wad_sector_grid(lines,bounds);
    loading_step("Textures et geometrie",5);
    wad_atlas_create();
    file sides=wad_side_materials(build_wad,build_directory,build_map);
    loading_step("Mecanismes du niveau",13);
    wad_actions_build(build_wad,build_map,lines,episode,mission);
    loading_step("Geometrie du niveau",17);
    wad_geometry_build(build_wad,build_directory,build_map,lines,sides);
    file_close(sides);
    file actors=file_create(""); file traits=file_create("");
    loading_step("Objets et ennemis",23);
    wad_actors(build_wad,build_directory,build_map,build_boss(episode,mission),actors,traits);
    loading_step("Animations et sprites",27);
    wad_frames_build(build_wad,build_directory,episode);
    build_frame_header();
    wad_animations_build(build_wad,build_directory);
    loading_step("Vues des sprites",31);
    file rotations=wad_atlas_rotations(build_wad,build_directory);
    loading_step("Interface",35);
    file ui=wad_ui(build_wad,build_directory);
    build_spawn(bounds,wad_player_start(build_wad,build_map),file_size(actors)/12);
    build_geometry_sections(grid,actors,ui);
    build_event_sections();
    file animation=wad_animation_table();
    build_section(132,animation);
    build_section(136,wad_animation_frames());
    loading_step("Assemblage du niveau",38);
    build_spatial_sections(lines,leaves,traits,rotations);
    build_word(148,file_size(build_output));
    build_append(wad_atlas_pixels(),0,file_size(wad_atlas_pixels()));
    // Bind saves to the IWAD's size and content fingerprint.
    file_append_little_uint32(file_size(build_wad),build_output);
    file_append_little_uint32(build_wad_hash,build_output);
    file_close(animation); file_close(ui); file_close(rotations);
    file_close(actors); file_close(traits); file_close(grid);
    wad_animations_close(); wad_frames_close(); wad_geometry_close();
    wad_actions_close(); wad_atlas_destroy();
}

fn wad_compile_level(file wad,uint32 directory,file map,file palette,int episode,int mission) -> file {
    build_output=file_create("");
    if (file_size(map)!=80 || file_size(palette)!=473088) { return build_output; }
    if (wad_player_start(wad,map)==0 || !wad_blockmap_valid(wad,map)) { return build_output; }
    file lines=wad_classic_lines(wad,map);
    file leaves=wad_bsp_leaves(wad,map);
    file bounds=wad_grid_bounds(wad,map);
    if (file_size(lines)>0 && file_size(leaves)>0 && file_size(bounds)==16) {
        build_wad=wad; build_map=map; build_directory=directory;
        build_empty(38);
        file_seek_cursor(0,build_output);
        file_write_uint32(1396982585,build_output); // SDC9 in memory
        build_append(palette,0,file_size(palette));
        build_base=file_size(build_output);
        build_word(4+((episode-1)*9+mission-1)*4,build_base);
        build_empty(51);
        file_seek_cursor(build_base,build_output);
        file_write_uint32(1396985139,build_output); // SDM3
        build_resources(lines,bounds,leaves,episode,mission);
    }
    file_close(bounds); file_close(leaves); file_close(lines);
    file_reset_cursor(build_output);
    return build_output;
}


// doom-wad-music.steg
// Software synthesizer for the event records produced by wad_mus.
// Output is mono signed PCM16 at 22050 Hz. MUS timing is 140 Hz.

fn zero_music_words(file target,int words) -> void {
    int i=0;
    while (i<words) { file_append_little_uint32(0,target); i+=1; }
}

fn music_set_word(file data,int at,uint32 value) -> void {
    file_seek_cursor(at,data);
    file_write_little_uint32(value,data);
}

fn finish_music_note(file active,file notes,int key,int tick) -> void {
    int at=key*12;
    int start=file_read_little_uint32_at(active,at);
    if (start==0) { return; }
    file_append_little_uint32(start-1,notes);
    file_append_little_uint32(tick,notes);
    file_append_little_uint32(file_read_little_uint32_at(active,at+4),notes);
    file_append_little_uint32(file_read_little_uint32_at(active,at+8),notes);
    music_set_word(active,at,0);
}

fn finish_music_channel(file active,file notes,int channel,int tick) -> void {
    int key=channel*128;
    int end=key+128;
    while (key<end) { finish_music_note(active,notes,key,tick); key+=1; }
}

fn new_music_note(file active,file notes,file channels,int event,int tick) -> void {
    int channel=event&15;
    int note=(event>>8)&127;
    int velocity=(event>>16)&255;
    int state=channel*12;
    if (velocity==255) { velocity=file_read_little_uint32_at(channels,state+8); }
    else { music_set_word(channels,state+8,velocity); }
    int key=channel*128+note;
    finish_music_note(active,notes,key,tick);
    if (velocity==0) { return; }
    uint32 meta=note|(file_read_little_uint32_at(channels,state)<<8);
    if (channel==15) { meta=meta|65536; }
    music_set_word(active,key*12,tick+1);
    music_set_word(active,key*12+4,meta);
    music_set_word(active,key*12+8,velocity*file_read_little_uint32_at(channels,state+4));
}

fn collect_music_notes(file events,file notes) -> int {
    file active=file_create(""); zero_music_words(active,6144);
    file channels=file_create("");
    int ch=0;
    while (ch<16) {
        file_append_little_uint32(0,channels);
        file_append_little_uint32(100,channels);
        file_append_little_uint32(64,channels);
        ch+=1;
    }
    int at=0; int end=file_size(events); int tick=0;
    while (at<end) {
        tick=file_read_little_uint32_at(events,at);
        int type=file_read_uint8_at(events,at+4);
        int channel=file_read_uint8_at(events,at+5);
        int a=file_read_uint8_at(events,at+6);
        int b=file_read_uint8_at(events,at+7);
        if (type==0) { finish_music_note(active,notes,channel*128+a,tick); }
        if (type==1) { new_music_note(active,notes,channels,channel|(a<<8)|(b<<16),tick); }
        if (type==3 && (a==10 || a==11)) { finish_music_channel(active,notes,channel,tick); }
        if (type==4 && a==0) { music_set_word(channels,channel*12,b); }
        if (type==4 && a==3) { music_set_word(channels,channel*12+4,b); }
        at+=8;
    }
    ch=0;
    while (ch<16) { finish_music_channel(active,notes,ch,tick); ch+=1; }
    file_close(channels); file_close(active);
    return tick;
}

fn music_wave_group(int patch) -> int {
    if (patch>=16 && patch<24) { return 1; }
    if (patch>=24 && patch<32) { return 2; }
    if (patch>=32 && patch<40) { return 3; }
    if (patch>=40 && patch<56) { return 6; }
    if (patch>=56 && patch<64) { return 4; }
    if (patch>=64 && patch<80) { return 5; }
    return 0;
}

fn music_wave_sample(int group,float angle) -> float {
    float s=sin(angle);
    if (group==0) { return s+0.25*sin(2.0*angle)+0.11*sin(3.0*angle); }
    if (group==1) { return 0.65*s+0.25*sin(3.0*angle)+0.12*sin(5.0*angle); }
    if (group==2) { return 0.65*s+0.35*sin(2.0*angle)+0.20*sin(3.0*angle)+0.15*sin(5.0*angle)+0.09*sin(7.0*angle); }
    if (group==3) { return 0.8*s+0.25*sin(2.0*angle)+0.05*sin(4.0*angle); }
    if (group==4) { return sin(angle+1.4*sin(2.0*angle))*0.85+0.22*s; }
    if (group==5) { return s+0.14*sin(3.0*angle); }
    return 0.62*s+0.19*sin(2.0*angle)+0.11*sin(4.0*angle);
}

fn setup_music_waves(float @wave) -> void {
    int group=0;
    while (group<7) {
        int i=0;
        while (i<2048) {
            wave[group*2048+i]=music_wave_sample(group,i*0.00306796157577);
            i+=1;
        }
        group+=1;
    }
    float step=0.759356;
    int i=0;
    while (i<128) {
        wave[14336+i]=step;
        step*=1.05946309436;
        i+=1;
    }
}

fn music_note_frame(int ticks) -> int { return (ticks*315+1)/2; }

fn mix_music_tone(float @mix,float @wave,file notes,int at,int frames) -> void {
    int begin=music_note_frame(file_read_little_uint32_at(notes,at));
    int end=music_note_frame(file_read_little_uint32_at(notes,at+4));
    int meta=file_read_little_uint32_at(notes,at+8);
    int base=music_wave_group((meta>>8)&127)*2048;
    float step=wave[14336+(meta&127)];
    float level=file_read_little_uint32_at(notes,at+12)*(0.19/16129.0);
    int finish=fmin(frames,end+850);
    float phase=0.0;
    int i=begin;
    while (i<finish) {
        int point=phase;
        float envelope=fmin(1.0,(i-begin)*0.01);
        if (i>=end) { envelope*=1.0-(i-end)/850.0; }
        mix[i]=mix[i]+wave[base+(point&2047)]*envelope*level;
        phase+=step;
        if (phase>=2048.0) { phase-=2048.0; }
        i+=1;
    }
}

uint32 music_noise=1;
fn mix_music_drum(float @mix,file notes,int at,int frames) -> void {
    int begin=music_note_frame(file_read_little_uint32_at(notes,at));
    int length=music_note_frame(file_read_little_uint32_at(notes,at+4))-begin;
    length=fmin(4200.0,fmax(2100.0,length));
    int note=file_read_little_uint32_at(notes,at+8)&127;
    bool kick=note==35 || note==36;
    float level=file_read_little_uint32_at(notes,at+12)*(0.24/16129.0);
    int count=fmin(length,frames-begin);
    int i=0;
    while (i<count) {
        music_noise=music_noise*1664525+1013904223;
        float hiss=music_noise/2147483648.0-1.0;
        float fall=1.0-i/(length*1.0);
        float envelope=fmin(1.0,i*0.03125)*fall*fall;
        float sample=0.82*hiss+0.16*sin(i*0.11);
        if (kick) { sample=0.85*sin(i*(0.053-0.000007*i))+0.11*hiss; }
        mix[begin+i]=mix[begin+i]+sample*envelope*level;
        i+=1;
    }
}

fn emit_music_pcm(float @mix,file output,int frames) -> void {
    int i=0;
    while (i<frames) {
        if ((i&16383)==0) { loading_step("Preparation du son",80+i*18/frames); }
        // Rational approximation of tanh, with saturation outside its domain.
        float x=fmax(-3.0,fmin(3.0,mix[i]));
        float xx=x*x;
        float value=x*(27.0+xx)/(27.0+9.0*xx)*25000.0;
        int sample=value;
        file_append_little_uint16(sample,output);
        i+=1;
    }
}

fn wad_music_pcm(file events) -> file {
    file output=file_create("");
    int size=file_size(events);
    if (size<8 || size%8!=0) { return output; }
    if (file_read_uint8_at(events,size-4)!=6 || file_read_little_uint32_at(events,size-8)>84000) { return output; }
    file notes=file_create("");
    int ticks=collect_music_notes(events,notes);
    int frames=((ticks+12)*315+1)/2;
    void @wave_memory=aloc(57856);
    void @mix_memory=aloc(frames*4);
    float @wave=wave_memory;
    float @mix=mix_memory;
    setup_music_waves(wave);
    music_noise=1;
    int at=0; int end=file_size(notes);
    while (at<end) {
        if ((file_read_little_uint32_at(notes,at+8)&65536)!=0) {
            mix_music_drum(mix,notes,at,frames);
        } else { mix_music_tone(mix,wave,notes,at,frames); }
        at+=16;
        loading_step("Synthese de la musique",45+at*35/end);
    }
    emit_music_pcm(mix,output,frames);
    free(mix_memory); free(wave_memory);
    file_close(notes);
    return output;
}

